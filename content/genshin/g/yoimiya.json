ldering Pearl","r":[0.5065,0.6707,0.0537,0.043],"k":"m"},{"n":"Philosophies of Transience","r":[0.0815,0.7248,0.0537,0.043],"k":"m"},{"n":"Forbidden Curse Scroll","r":[0.5065,0.7248,0.0537,0.043],"k":"m"},{"n":"Naku Weed","r":[0.0815,0.7789,0.0537,0.043],"k":"m"},{"n":"Dragon Lord's Crown","r":[0.5065,0.7789,0.0537,0.043],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.833,0.0537,0.043],"k":"m"}]},{"img":"content/genshin/builds/yoimiya/261111-225430/zh-3.webp","t":"content/genshin/builds/yoimiya/261111-225430/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Thundering Pulse","r":[0.1093,0.2622,0.0491,0.0393],"k":"w"},{"n":"Aqua Simulacra","r":[0.1093,0.333,0.0491,0.0393],"k":"w"},{"n":"Shimenawa's Reminiscence","r":[0.5231,0.2467,0.0491,0.0393],"k":"a"},{"n":"Echoes of an Offering","r":[0.5231,0.3174,0.0491,0.0393],"k":"a"},{"n":"Marechaussee Hunter","r":[0.5231,0.3881,0.0491,0.0393],"k":"a"},{"n":"Yoimiya","r":[0.0815,0.5,0.0389,0.0311]},{"n":"Yelan","r":[0.1278,0.5,0.0389,0.0311]},{"n":"Yun Jin","r":[0.1741,0.5,0.0389,0.0311]},{"n":"Zhongli","r":[0.2204,0.5,0.0389,0.0311]},{"n":"Yoimiya","r":[0.0815,0.5556,0.0389,0.0311]},{"n":"Yelan","r":[0.1278,0.5556,0.0389,0.0311]},{"n":"Furina","r":[0.1741,0.5556,0.0389,0.0311]},{"n":"Jean","r":[0.2204,0.5556,0.0389,0.0311]},{"n":"Yoimiya","r":[0.0815,0.6185,0.0389,0.0311]},{"n":"Fischl","r":[0.1278,0.6185,0.0389,0.0311]},{"n":"Chevreuse","r":[0.1741,0.6185,0.0389,0.0311]},{"n":"Beidou","r":[0.2204,0.6185,0.0389,0.0311]},{"n":"Yoimiya","r":[0.0815,0.6741,0.0389,0.0311]},{"n":"Xingqiu","r":[0.1278,0.6741,0.0389,0.0311]},{"n":"Bennett","r":[0.1741,0.6741,0.0389,0.0311]},{"n":"Layla","r":[0.2204,0.6741,0.0389,0.0311]}]}]}},"thumb":"content/genshin/builds/yoimiya/261111-225430/en-1.t.webp","why":{"w":[{"name":"Thundering Pulse","text":"Signature CRIT DMG bow with ATK and stacking Normal Attack DMG. Shimenawa energy consumption can help maintain its third stack. Manage energy below 100% for all three stacks."},{"name":"Aqua Simulacra","text":"Huge CD and unconditional HP."},{"name":"The First Great Magic","text":"Provides CD and Charged Attack/ATK bonuses."},{"name":"Skyward Harp","text":"Provides CRIT Rate, CRIT DMG, and high base ATK, making it an easy general-purpose option."},{"name":"Polar Star","text":"High CRIT Rate and Skill/Burst DMG buffs; its ATK stacking is awkward for a Normal Attack-focused rotation. Not all passive stacks are convenient to maintain."},{"name":"Rust","text":"One of her best bows at high refinements: directly boosts her Normal Attack damage, which supplies most of her output. Especially strong at R4–R5. R4–R5 recommended."},{"name":"Slingshot","text":"Outstanding 3★ CRIT Rate option that buffs fast, close-range Normal Attack hits. Can rival premium bows with strong ATK buffs. Use Bennett and/or Yun Jin; stay close enough for passive. R5 recommended."},{"name":"Hamayumi","text":"Accessible ATK bow that buffs Normal Attacks, but its full-energy passive conflicts with Shimenawa energy consumption. Better without 4pc Shimenawa; avoid spending energy for full passive. R5 improves bonus."}],"a":[{"names":["Shimenawa's Reminiscence"],"text":"A reliable 50% Normal Attack DMG boost after Skill use.","stats":"ATK% / EM · Pyro DMG · CRIT"},{"names":["Echoes of an Offering"],"text":"Can rival Shimenawa with frequent Normal Attack procs; performance varies with latency and reaction timing.","stats":"ATK% / EM · Pyro DMG · CRIT"},{"names":["Marechaussee Hunter"],"text":"With Furina-driven HP changes.","stats":"ATK% / EM · Pyro DMG · CRIT; lower sheet CRIT Rate"}],"t":[{"name":"Fireworks Finale","members":["Yoimiya","Yelan","Yun Jin","Zhongli"],"text":"Yelan enables Vaporize, Yun Jin strengthens rapid Normal Attacks, and Zhongli prevents interruptions while shredding RES.","roles":["Main DPS","Hydro Sub DPS","Normal Attack Buffer","Shield / RES Shred"]},{"name":"Summer Night Encore","members":["Yoimiya","Yelan","Furina","Jean"],"text":"Double Hydro supports Vaporize; Furina buffs damage and Jean heals and can shred Pyro RES when Pyro is Swirled.","roles":["On-field DPS","Off-field DPS / Buffer","Off-field DPS / Buffer","Healer / Debuffer"]},{"name":"Sparkler Overload","members":["Yoimiya","Fischl","Chevreuse","Beidou"],"text":"Pyro/Electro-only lineup unlocks Chevreuse buffs; Fischl and Beidou add damage and Beidou aids interruption resistance.","roles":["On-field DPS","Off-field DPS / Battery","Healer / Buffer","Off-field DPS"]},{"name":"Discount Fireworks","members":["Yoimiya","Xingqiu","Bennett","Layla"],"text":"Xingqiu enables Vaporize and adds resistance; Bennett supplies ATK and heals while Layla protects Normal Attack strings.","roles":["On-field DPS","Off-field DPS / Hydro Enabler","Healer / Buffer","Shielder / Cryo Enabler"]}],"v":"Vaporize: Use Yelan or Xingqiu for Hydro; ATK% or EM Sands depends on buffs and substats. Keep Normal Attack strings uninterrupted.\nFurina Setup: 4pc Marechaussee Hunter is excellent with Furina and reliable healing. Account for its 36% CRIT Rate buff.\nBudget Bow: R5 Slingshot performs especially well with Bennett or Yun Jin; high-refinement Rust is a premier 4★ choice.\nBurst Usage: Shimenawa usually favors skipping Burst. Outside Shimenawa, use Burst when useful without delaying Skill windows.\nOverloaded: Chevreuse Pyro/Electro teams emphasize raw Pyro damage and Overloaded; avoid stacking EM solely for Overloaded.","n":2},"seo":{"roles":["Main DPS"],"about":"Yoimiya is an on-field Pyro DPS who rapidly fires infused Normal Attacks after using her Skill. Vaporize teams excel against single targets, especially with a shielder to protect her full attack string. Prioritize Normal Attack talent levels; her Burst is optional, particularly with Shimenawa.","pros":["Strong single-target DMG","Easy ranged Normal Attacks","Excellent 4★ and 3★ bows","Flexible Pyro team options"],"cons":["Limited AoE damage","Needs full attack strings","Easily interrupted","Skill uptime limits damage"],"weapons":["Thundering Pulse","Aqua Simulacra","The First Great Magic","Skyward Harp","Polar Star","Rust","Slingshot","Hamayumi"],"arts":[{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs","role":"Best Overall"},{"sets":["Echoes of an Offering"],"pcs":"4 pcs","role":"Normal Attack Alternative"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Furina Teams"}],"main":["ATK% / Elemental Mastery (Vaporize)","Pyro DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["CRIT Rate: 65% - 80%","CRIT DMG: 140% - 200%+","ATK: 1,700 - 2,300+","Elemental Mastery: 100 - 250 (Vape)"],"vars":[{"title":"Furina / Marechaussee","role":"On-field Vaporize DPS","weapons":["Thundering Pulse","Aqua Simulacra","Rust","Slingshot"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"},{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs"}],"stats":"Use less sheet CRIT Rate to account for up to 36% from Marechaussee. ATK% or EM Sands based on buffs.","teams":"Furina plus sufficient party healing; add reliable Hydro application if needed.","when":"Use when Furina is available and can maintain the HP fluctuations required for Marechaussee.","cond":"Requires consistent HP changes; healers matter.","notes":"Marechaussee is strong with Furina, not a generic set for standard Yoimiya teams.","pre":false},{"title":"High-Refinement Rust","role":"On-field Normal Attack DPS","weapons":["Rust","Thundering Pulse","Aqua Simulacra","Skyward Harp"],"arts":[{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs"},{"sets":["Echoes of an Offering"],"pcs":"4 pcs"}],"stats":"Balance CRIT stats from artifacts because Rust gives ATK% rather than CRIT.","teams":"Any Yoimiya team that preserves complete Normal Attack sequences.","when":"Use when you have a high-refinement Rust but do not want to pull a signature 5★ bow.","cond":"R4–R5 recommended for top performance.","notes":"Strong in Vaporize or raw Pyro builds; monitor Shimenawa Energy requirement.","pre":false},{"title":"F2P Slingshot Vape","role":"On-field Vaporize DPS","weapons":["Slingshot","Hamayumi"],"arts":[{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs"},{"sets":["Echoes of an Offering"],"pcs":"4 pcs"}],"stats":"Prioritize ATK% buffs and CRIT DMG; Slingshot provides substantial CRIT Rate. Add EM for Vaporize.","teams":"Bennett or Yun Jin strongly recommended, plus Xingqiu or Yelan; shielding helps.","when":"Low-spender setup using an accessible R5 three-star bow without giving up strong single-target damage.","cond":"R5 Slingshot; stay close enough for its hit-speed passive.","notes":"If using Hamayumi, prefer sets that do not drain Energy and preserve its full-Energy bonus.","pre":false},{"title":"Chevreuse Overloaded","role":"On-field Pyro DPS","weapons":["Thundering Pulse","Rust","Skyward Harp","Slingshot"],"arts":[{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs"},{"sets":["Echoes of an Offering"],"pcs":"4 pcs"}],"stats":"Favor ATK% and CRIT; EM is less important for a raw Pyro damage-focused Chevreuse setup.","teams":"Chevreuse with only Pyro and Electro teammates; sustain/interruption resistance recommended.","when":"Use when you prefer a reaction team that does not need Hydro or Vaporize setups.","cond":"Chevreuse passive team restriction must be met.","notes":"Fischl and Beidou are accessible Electro damage options; Beidou Burst favors multi-target fights.","pre":false}],"mats":["Agnidus Agate Sliver","Agnidus Agate Fragment","Agnidus Agate Chunk","Agnidus Agate Gemstone","Smoldering Pearl","Teachings of Transience","Guide to Transience","Philosophies of Transience","Divining Scroll","Sealed Scroll","Forbidden Curse Scroll","Naku Weed","Dragon Lord's Crown","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 8-9"},{"name":"Elemental Skill","pri":"Level 8-9"},{"name":"Elemental Burst","pri":"Level 6 - 8 (optional)"}],"teams":[{"name":"Fireworks Finale","members":["Yoimiya","Yelan","Yun Jin","Zhongli"]},{"name":"Summer Night Encore","members":["Yoimiya","Yelan","Furina","Jean"]},{"name":"Sparkler Overload","members":["Yoimiya","Fischl","Chevreuse","Beidou"]},{"name":"Discount Fireworks","members":["Yoimiya","Xingqiu","Bennett","Layla"]}]}}],"title":"Yoimiya","el":"Pyro"}