tent/genshin/builds/lisa/261111-225116/en-1.t.webp","why":{"w":[{"name":"Kagura's Verity","text":"Skill stacks boost Electro damage. Best with repeated Skill casts."},{"name":"Lost Prayer to the Sacred Winds","text":"CRIT Rate and on-field damage bonus. Needs sustained field time."},{"name":"Skyward Atlas","text":"High ATK boosts direct Electro damage."},{"name":"A Thousand Floating Dreams","text":"Large EM bonus benefits Aggravate. Lower direct damage in some builds."},{"name":"The Widsith","text":"Strong but random temporary buffs. Time the proc for Lisa’s damage window."},{"name":"Solar Pearl","text":"CRIT Rate; boosts Skill and Burst. Use Normal Attacks to activate passive."},{"name":"Mappa Mare","text":"Craftable EM and reaction damage. Trigger reactions to gain stacks."},{"name":"Favonius Codex","text":"ER and team particles ease Burst use. Requires CRIT Rate to trigger."}],"a":[{"names":["Thundering Fury"],"text":"Aggravate boost; cuts Skill CD.","stats":"ATK%/EM · Electro · CRIT"},{"names":["Gilded Dreams"],"text":"EM and ATK for Aggravate.","stats":"ATK%/EM · Electro · CRIT"},{"names":["Emblem of Severed Fate"],"text":"Boosts off-field Burst damage.","stats":"ER/ATK% · Electro · CRIT"}],"t":[{"name":"Library of Thunder","members":["Lisa","Fischl","Nahida","Xilonen"],"text":"Nahida maintains Quicken, Fischl batteries Lisa and triggers Aggravate, while Xilonen supplies resistance shred and healing.","roles":["Electro DPS / Debuffer","Off-field DPS / Battery","Dendro Enabler / Buffer","Healer / Debuffer"]},{"name":"Storm Study Group","members":["Lisa","Fischl","Yaoyao","Sucrose"],"text":"A practical Aggravate team: Yaoyao sustains Quicken and heals; Fischl batteries Lisa while Sucrose shares EM and shreds Electro RES.","roles":["Electro Driver / Debuffer","Off-field DPS / Battery","Healer / Dendro Enabler","EM Buffer / Debuffer"]},{"name":"Budget Lightning","members":["Lisa","Fischl","Traveler (Dendro)","Sayu"],"text":"Dendro Traveler enables Quicken; Fischl provides Electro damage and particles, and Sayu heals and applies VV Electro shred.","roles":["Electro Driver / Debuffer","Off-field DPS / Battery","Dendro Enabler / Battery","Healer / Debuffer"]},{"name":"Rainy Research","members":["Lisa","Fischl","Nahida","Xingqiu"],"text":"Quickbloom mixes Aggravate with Hyperbloom. Lisa must Normal Attack to trigger Xingqiu; heavy Hydro may reduce Quicken uptime.","roles":["Electro Driver / Debuffer","Off-field DPS / Battery","Dendro Enabler / Buffer","Off-field DPS / Hydro Enabler"]}],"v":"Off-Field Burst: Emblem + Favonius; prioritize enough ER to Burst each rotation.\nNoblesse Support: 4pc Noblesse + Favonius; use Burst for DEF shred and team ATK.\nF2P Aggravate: Mappa Mare + 4pc Thundering Fury; invest in CRIT, EM and ER.\nQuickbloom: Aggravate Lisa with a Hydro teammate; Quicken uptime may fall.","n":4},"seo":{"roles":["Main DPS / Sub DPS"],"about":"Lisa is an Electro DPS who excels in on-field Aggravate teams. Her attacks and Burst apply Electro often, while her Burst lowers enemy DEF by 15%. Build CRIT, ATK and EM, maintain Quicken, and use her charged Skill to deal damage and generate Energy.","pros":["Strong Aggravate damage","15% enemy DEF reduction","Flexible Electro application","Accessible free character"],"cons":["Energy-hungry Burst","Hold Skill can be unsafe","Needs Dendro for Aggravate","Longer field-time rotations"],"weapons":["Kagura's Verity","Lost Prayer to the Sacred Winds","Skyward Atlas","A Thousand Floating Dreams","The Widsith","Solar Pearl","Mappa Mare","Favonius Codex"],"arts":[{"sets":["Thundering Fury"],"pcs":"4 pcs","role":"Best"},{"sets":["Gilded Dreams"],"pcs":"4 pcs","role":""},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":""}],"main":["ATK% / Elemental Mastery","Electro DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["CR: 60% - 75%","CD: 120% - 180%","ER: 120% - 160%","EM: 100 - 300"],"vars":[{"title":"Off-Field Burst DPS","role":"Off-field DPS","weapons":["Favonius Codex","Skyward Atlas","The Widsith"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Build enough ER to Burst each rotation; use Electro goblet and CRIT circlet.","teams":"A team that funnels Electro particles to Lisa.","when":"Use Lisa for her Burst’s repeated Electro hits and 15% enemy DEF reduction while another unit plays on-field.","cond":"Burst uptime varies with team Energy.","notes":"Hold Skill supplies particles; tap Skill supplies none.","pre":false},{"title":"Noblesse DEF-Shred Support","role":"Support","weapons":["Favonius Codex","The Widsith"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER first, then CRIT Rate for Favonius; personal damage is secondary.","teams":"An ATK-scaling team without another Noblesse user.","when":"Choose when Lisa’s DEF shred and a teamwide ATK buff matter more than her individual damage.","cond":"Requires reliable Burst uptime.","notes":"","pre":false},{"title":"Accessible Aggravate DPS","role":"On-field DPS","weapons":["Mappa Mare","The Widsith","Solar Pearl"],"arts":[{"sets":["Thundering Fury"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Balance EM or ATK sands with Electro goblet and CRIT circlet.","teams":"Dendro for Quicken, preferably another Electro for Energy.","when":"Use a craftable or affordable catalyst while learning Lisa’s on-field Aggravate combos.","cond":"Keep Quicken active.","notes":"At level 90, Aggravate damage improves.","pre":false},{"title":"Quickbloom Driver","role":"On-field DPS","weapons":["A Thousand Floating Dreams","Mappa Mare","The Widsith"],"arts":[{"sets":["Thundering Fury"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM becomes more valuable; still build CRIT and enough ER for Burst.","teams":"Reliable Dendro, Electro battery and Hydro application.","when":"Use for mixed Aggravate and some Hyperbloom damage, with reaction ownership depending on the exact team.","cond":"Hydro application may reduce Quicken uptime.","notes":"Not the same as a guaranteed full-EM Hyperbloom trigger.","pre":false}],"mats":["Vajrada Amethyst Sliver","Vajrada Amethyst Fragment","Vajrada Amethyst Chunk","Vajrada Amethyst Gemstone","Lightning Prism","Teachings of Ballad","Guide to Ballad","Philosophies of Ballad","Slime Condensate","Slime Secretions","Slime Concentrate","Valberry","Dvalin's Claw","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 6-8+"},{"name":"Elemental Skill","pri":"Level 8-9+"},{"name":"Elemental Burst","pri":"Level 8-9+"}],"teams":[{"name":"Library of Thunder","members":["Lisa","Fischl","Nahida","Xilonen"]},{"name":"Storm Study Group","members":["Lisa","Fischl","Yaoyao","Sucrose"]},{"name":"Budget Lightning","members":["Lisa","Fischl","Traveler (Dendro)","Sayu"]},{"name":"Rainy Research","members":["Lisa","Fischl","Nahida","Xingqiu"]}]}}],"title":"Lisa","el":"Electro"}