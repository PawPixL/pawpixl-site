5163,0.0361,0.0289]},{"n":"Chiori","r":[0.0815,0.5689,0.0361,0.0289]},{"n":"Navia","r":[0.125,0.5689,0.0361,0.0289]},{"n":"Furina","r":[0.1685,0.5689,0.0361,0.0289]},{"n":"Bennett","r":[0.212,0.5689,0.0361,0.0289]},{"n":"Chiori","r":[0.0815,0.6281,0.0361,0.0289]},{"n":"Zibai","r":[0.125,0.6281,0.0361,0.0289]},{"n":"Linnea","r":[0.1685,0.6281,0.0361,0.0289]},{"n":"Columbina","r":[0.212,0.6281,0.0361,0.0289]},{"n":"Chiori","r":[0.0815,0.6807,0.0361,0.0289]},{"n":"Ningguang","r":[0.125,0.6807,0.0361,0.0289]},{"n":"Bennett","r":[0.212,0.6807,0.0361,0.0289]}]}]}},"thumb":"content/genshin/builds/chiori/261111-224833/en-1.t.webp","why":{"w":[{"name":"Uraku Misugiri","text":"CD, Skill DMG and DEF bonuses suit Tamoto; Geo DMG from teammates strengthens its passive."},{"name":"Primordial Jade Cutter","text":"Huge CR and an HP-based ATK bonus boost her dual-scaling DMG. Avoid excess CR."},{"name":"Peak Patrol Song","text":"DEF-focused sword that can buff party Elemental DMG, but Chiori needs on-field Normal or Plunging hits to trigger it. Requires extra field time; utility choice."},{"name":"Harbinger of Dawn","text":"Excellent low-cost CD and CR while her HP stays above 90%. Keep HP above 90%. R5 recommended."},{"name":"Cinnabar Spindle","text":"DEF% and a DEF-scaling Skill hit bonus make this a powerful option for Tamoto."},{"name":"Wolf-Fang","text":"CRIT Rate and Skill/Burst DMG bonuses help her personal output; off-field hits do not stack its CRIT passive. Skill/Burst CRIT stacks require on-field hits."},{"name":"Flute of Ezpitzal","text":"Craftable DEF% weapon that can boost DEF after casting Skill, improving Tamoto damage. Accessible Natlan craftable."},{"name":"Favonius Sword","text":"Provides Energy Recharge and team particles on CRIT hits; sacrifices personal damage for utility. Passive requires CRIT while Chiori is on-field."}],"a":[{"names":["Golden Troupe"],"text":"Strong Skill DMG amplification for Tamoto, which deals most of Chiori’s damage when played off-field.","stats":"DEF% / Geo DMG or DEF% / CRIT"},{"names":["Husk of Opulent Dreams"],"text":"Stacks DEF and Geo DMG for both dolls and Burst; a flexible option with strong substats.","stats":"DEF% / Geo DMG or DEF% / CRIT"},{"names":["Golden Troupe","Husk of Opulent Dreams"],"text":"Skill DMG plus DEF% is a practical interim set while farming a full 4-piece set.","stats":"DEF% / Geo DMG or DEF% / CRIT"}],"t":[{"name":"Oni Fashion Week","members":["Chiori","Arataki Itto","Gorou","Zhongli"],"text":"Itto’s Ushi and Zhongli’s pillar are Geo Constructs, enabling two Tamoto dolls at C0; Gorou buffs DEF.","roles":["Off-field Geo","Main DPS","DEF / Geo Buff","Shield / RES Shred"]},{"name":"Runway Ricochet","members":["Chiori","Navia","Furina","Bennett"],"text":"Navia gains Geo damage and Crystallize support; Furina buffs and Bennett heals. Chiori needs C1 for two dolls here.","roles":["Off-field DPS","On-field DPS","Off-field DPS / Buffer","Healer / Buffer"]},{"name":"Moonlit Couture","members":["Chiori","Zibai","Linnea","Columbina"],"text":"A Lunar-Crystallize Geo core can enable Chiori’s second Tamoto even at C0; check team sustain before using.","roles":["Off-field DPS","On-field DPS","Off-field DPS / Buffer","Off-field DPS / Buffer"]},{"name":"Budget Beauty Supplies","members":["Chiori","Ningguang","Traveler (Geo)","Bennett"],"text":"Ningguang and Geo Traveler create constructs for both Tamoto dolls at C0; Bennett adds healing and ATK.","roles":["Off-field DPS","On-field DPS","Geo Battery / Sub DPS","Healer / Buffer"]}],"v":"C0 Double Doll: Pair with a Geo Construct user or Lunar-Crystallize enabler for two Tamoto dolls. Otherwise expect lower damage.\nC1 Navia Pair: C1 enables a second Tamoto with any other Geo teammate, including Navia and Noelle.\nF2P CRIT Sword: R5 Harbinger of Dawn excels if Chiori stays above 90% HP; use DEF% / Geo or DEF% / CRIT artifacts.\nBurst Optional: Skill is the priority. Burst every other rotation, or skip it when its field time and energy cost are not worthwhile.\nOn-Field C6: At C6, DEF-scaling Normal Attacks support an on-field carry build. Not recommended as a default C0 playstyle.","n":3},"seo":{"roles":["Off-Field DPS"],"about":"Chiori is an off-field Geo DPS whose Tamoto dolls deal damage based on DEF and ATK. At C0, a Geo Construct or compatible Lunar-Crystallize interaction enables her second doll. C1 allows any other Geo teammate. Cast Skill twice for a quick swap and coordinated hits.","pros":["Strong off-field Geo damage","Low field-time needs","Great Geo team synergy","Flexible DEF scaling"],"cons":["C0 construct dependency","Limited reaction utility","Burst often optional","C6 for on-field carry"],"weapons":["Uraku Misugiri","Primordial Jade Cutter","Peak Patrol Song","Harbinger of Dawn","Cinnabar Spindle","Wolf-Fang","Flute of Ezpitzal","Favonius Sword"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs","role":"Best Off-field"},{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs","role":"Strong Alternative"},{"sets":["Golden Troupe","Husk of Opulent Dreams"],"pcs":"2 + 2 pcs","role":"Easy Mix"}],"main":["DEF%","Geo DMG Bonus / DEF%","CRIT Rate / CRIT DMG"],"stats":["CRIT Rate: 65% - 80%","CRIT DMG: 140% - 200%+","DEF: 2,000 - 2,400+","Energy Recharge: 100% - 130% (optional Burst)"],"vars":[{"title":"C0 Double-Tamoto Off-Field","role":"Off-field DPS","weapons":["Uraku Misugiri","Harbinger of Dawn","Cinnabar Spindle"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs"},{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"}],"stats":"Prioritize CRIT and DEF%; little ER is needed when Burst is skipped.","teams":"Use a Geo Construct teammate or compatible Lunar-Crystallize enabler.","when":"Best for C0 Itto, Zhongli, Ningguang, or Geo Traveler setups; summon both dolls before swapping.","cond":"Needs construct or Lunar-Crystallize interaction.","notes":"The extra doll is a major part of Chiori’s personal output.","pre":false},{"title":"C1 Navia Double Geo","role":"Off-field DPS","weapons":["Uraku Misugiri","Primordial Jade Cutter","Harbinger of Dawn"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs"},{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"}],"stats":"DEF% / Geo or DEF% / CRIT. Tune ER only if using Burst.","teams":"Navia plus a healer or defensive support; another Geo character is required.","when":"With C1, Chiori brings two dolls to Navia teams without needing a Geo Construct.","cond":"C1 required for second Tamoto without another enabler.","notes":"At C0, this exact Navia/Furina/Bennett team produces only one doll.","pre":false},{"title":"Budget DEF & CRIT","role":"Off-field DPS","weapons":["Harbinger of Dawn","Flute of Ezpitzal","Cinnabar Spindle"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs"},{"sets":["Golden Troupe","Husk of Opulent Dreams"],"pcs":"2 + 2 pcs"}],"stats":"Aim for balanced CRIT and DEF; keep HP above 90% with Harbinger.","teams":"A Geo Construct teammate is preferred at C0.","when":"Low-spender setup using 3-star, craftable, or previously available event equipment.","cond":"Cinnabar Spindle is past-event only.","notes":"Choose weapons by ownership; a well-refined Harbinger can be especially efficient.","pre":false},{"title":"Team Buff Utility","role":"Support","weapons":["Peak Patrol Song","Favonius Sword"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"},{"sets":["Golden Troupe"],"pcs":"4 pcs"}],"stats":"Build DEF for Peak Patrol; build CRIT Rate for Favonius triggering.","teams":"Teams that value elemental damage buffs or particles over Chiori’s own damage.","when":"A situational utility alternative when Chiori’s damage is not the team priority.","cond":"Peak Patrol requires on-field hits; Favonius must CRIT on-field.","notes":"Do not assume the Peak Patrol buff activates from off-field dolls.","pre":false},{"title":"C6 On-Field Geo Carry","role":"On-field DPS","weapons":["Uraku Misugiri","Primordial Jade Cutter"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"},{"sets":["Golden Troupe"],"pcs":"4 pcs"}],"stats":"Invest