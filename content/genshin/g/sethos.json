:[0.0815,0.5874,0.0352,0.0281]},{"n":"Fischl","r":[0.1241,0.5874,0.0352,0.0281]},{"n":"Nahida","r":[0.1667,0.5874,0.0352,0.0281]},{"n":"Zhongli","r":[0.2093,0.5874,0.0352,0.0281]},{"n":"Sethos","r":[0.0815,0.6459,0.0352,0.0281]},{"n":"Fischl","r":[0.1241,0.6459,0.0352,0.0281]},{"n":"Tighnari","r":[0.1667,0.6459,0.0352,0.0281]},{"n":"Baizhu","r":[0.2093,0.6459,0.0352,0.0281]},{"n":"Sethos","r":[0.0815,0.7044,0.0352,0.0281]},{"n":"Fischl","r":[0.1241,0.7044,0.0352,0.0281]},{"n":"Yaoyao","r":[0.1667,0.7044,0.0352,0.0281]},{"n":"Sucrose","r":[0.2093,0.7044,0.0352,0.0281]}]}]}},"thumb":"content/genshin/builds/sethos/261111-225237/en-1.t.webp","why":{"w":[{"name":"Hunter's Path","text":"CRIT and EM-scaled Charged DMG. Premium best-in-slot; marginal over Slingshot."},{"name":"Aqua Simulacra","text":"CRIT DMG and proximity-based damage. Stay close enough for its passive."},{"name":"The First Great Magic","text":"CRIT DMG and Charged Attack bonus. Passive varies with party elements."},{"name":"Skyward Harp","text":"CRIT Rate and CRIT DMG stat stick. Solid alternative if already owned."},{"name":"Slingshot","text":"Big close-range Charged Attack buff. Stay close for passive; excellent 3-star. R5 recommended."},{"name":"Scion of the Blazing Sun","text":"CRIT Rate and Charged Attack mark. Mark requires Charged Attack to hit."},{"name":"Ibis Piercer","text":"Gains EM after Charged Attacks. Event-limited; stack the EM passive."},{"name":"Cloudforged","text":"EM bow; weaker than R5 Slingshot. Use only if stronger bows are missing."}],"a":[{"names":["Wanderer's Troupe"],"text":"EM and Charged Attack damage.","stats":"EM · Electro · CRIT"},{"names":["Gilded Dreams"],"text":"EM for Quicken teams.","stats":"EM · Electro · CRIT"},{"names":["Desert Pavilion Chronicle"],"text":"Faster Burst Dusk Bolt attacks.","stats":"EM · Electro · CRIT"}],"t":[{"name":"Sandstorm Aggravate","members":["Sethos","Fischl","Kirara","Sucrose"],"text":"Fischl batteries Sethos, Kirara enables Quicken and shields, and Sucrose adds EM while shredding Electro RES. Swirl Electro before Dendro if needed.","roles":["Electro DPS","Battery / Sub DPS","Dendro / Shield","VV / EM Buffer"]},{"name":"Desert Thunder","members":["Sethos","Fischl","Nahida","Zhongli"],"text":"Nahida supplies durable Quicken and EM; Fischl provides Energy, while Zhongli shields and shreds RES without relying on difficult Electro Swirls.","roles":["Electro DPS","Battery / Sub DPS","Dendro / EM Buffer","Shield / RES Shred"]},{"name":"Twin Desert Archers","members":["Sethos","Fischl","Tighnari","Baizhu"],"text":"Alternate Sethos Shadowpiercing Shots with Tighnari Charged Shots. Fischl fuels Energy, and Baizhu keeps Quicken active with healing.","roles":["Charged Shot DPS","Battery","Quickswap DPS","Dendro / Healer"]},{"name":"Budget Sandstorm","members":["Sethos","Fischl","Yaoyao","Sucrose"],"text":"Accessible Aggravate core: Fischl batteries Sethos, Yaoyao heals and applies Dendro, and Sucrose shreds Electro RES and shares EM.","roles":["On-field DPS","Off-field DPS / Battery","Healer / Dendro Enabler","EM Buffer / Debuffer"]}],"v":"Charged Shot: Skip Burst. Use quick Shadowpiercing Shots; Energy spent speeds charge time. Prefer Fischl and a short field window.\nC6 Shot Cycle: C6 refunds Energy after a Shadowpiercing Shot once per 15s, easing the rapid-shot Energy budget.\nDual Archer: Pair with Tighnari for quickswap Quicken; alternate their short Charged Shot windows.\nBurst Speed: Burst Dusk Bolts count as Charged Attack damage. Desert Pavilion trades flexibility for attack speed.","n":4},"seo":{"roles":["Main DPS"],"about":"Sethos is an Electro DPS built for Aggravate. His Burst turns Normal Attacks into piercing Dusk Bolts that deal Charged Attack damage. Alternatively, spend Energy on rapid Shadowpiercing Shots without using Burst.","pros":["Strong Aggravate synergy","Two distinct playstyles","Great low-rarity weapon","Piercing Electro attacks"],"cons":["Wants Electro battery","Energy-sensitive shots","Needs Dendro teammate","Field time limits teams"],"weapons":["Hunter's Path","Aqua Simulacra","The First Great Magic","Skyward Harp","Slingshot","Scion of the Blazing Sun","Ibis Piercer","Cloudforged"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs","role":"Best overall"},{"sets":["Gilded Dreams"],"pcs":"4 pcs","role":"Alternative"},{"sets":["Desert Pavilion Chronicle"],"pcs":"4 pcs","role":"Burst variant"}],"main":["Elemental Mastery / Energy Recharge","Electro DMG Bonus","Crit Rate / Crit DMG"],"stats":["CRIT Rate: 60-75%","CRIT DMG: 120-160%","EM: 250-450","ER: 100-160%","Level: 90"],"vars":[{"title":"Shadowpiercing Quickswap","role":"Charged Shot DPS","weapons":["Hunter's Path","Slingshot","Aqua Simulacra","Ibis Piercer"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM/Electro/CRIT; budget Energy for 3-4 enhanced shots. ER varies sharply by Skill count.","teams":"Strong Electro battery, preferably Fischl; Dendro for Quicken.","when":"Do not use Burst. Fire charged Shadowpiercing Shots, use Skill to regenerate Energy by triggering a reaction, then resume shooting.","cond":"Energy-hungry at C0; extra Skill or fewer shots improves consistency.","notes":"At C0, 1-Skill/Fischl Charged Shot cycles can need ~140-150% ER; 2 Skills can be near 100-110%.","pre":false},{"title":"C6 Charged Shot Economy","role":"Charged Shot DPS","weapons":["Slingshot","Hunter's Path","Aqua Simulacra"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM/Electro/CRIT. C6 refunds Energy for one enhanced Shot every 15s.","teams":"Electro battery and Dendro support; stable reaction triggers on Skill.","when":"C6 enables a more forgiving 4-shot sequence or an extra fifth shot at some damage loss.","cond":"Requires C6.","notes":"Only the first four Shadowpiercing Shots can benefit from one A4 buff cycle.","pre":false},{"title":"Tighnari Dual Carry","role":"Quickswap DPS","weapons":["Slingshot","Hunter's Path","The First Great Magic"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Favor rapid shots and shorter field time; adjust ER for repeated swaps.","teams":"Tighnari, Fischl and a Dendro sustain such as Baizhu.","when":"Alternate short Sethos charged-shot windows with Tighnari combos in a Quicken rotation.","cond":"Not for extended Burst Dusk Bolt field time.","notes":"Avoid firing Burst during Sethos charged-shot windows.","pre":false},{"title":"Desert Pavilion Dusk Bolts","role":"On-field DPS","weapons":["Slingshot","Hunter's Path","Aqua Simulacra"],"arts":[{"sets":["Desert Pavilion Chronicle"],"pcs":"4 pcs"},{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"}],"stats":"EM/Electro/CRIT; prioritize Burst talent and consistent Energy.","teams":"Fischl battery and a Dendro applicator; preserve full on-field Burst window.","when":"Use Burst to convert Normal Attacks into fast, piercing Dusk Bolts; cancel long third-attack animation.","cond":"Burst stance ends if Sethos switches out.","notes":"Dusk Bolts deal Charged Attack damage but retain Normal Attack action triggers.","pre":false}],"mats":["Vajrada Amethyst Sliver","Vajrada Amethyst Fragment","Vajrada Amethyst Chunk","Vajrada Amethyst Gemstone","Cloudseam Scale","Teachings of Praxis","Guide to Praxis","Philosophies of Praxis","Faded Red Satin","Trimmed Red Silk","Rich Red Brocade","Trishiraite","Daka's Bell","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 8-9+"},{"name":"Elemental Skill","pri":"LEvel 1-6"},{"name":"Elemental Burst","pri":"Level 8-9+"}],"teams":[{"name":"Sandstorm Aggravate","members":["Sethos","Fischl","Kirara","Sucrose"]},{"name":"Desert Thunder","members":["Sethos","Fischl","Nahida","Zhongli"]},{"name":"Twin Desert Archers","members":["Sethos","Fischl","Tighnari","Baizhu"]},{"name":"Budget Sandstorm","members":["Sethos","Fischl","Yaoyao","Sucrose"]}]}}],"title":"Sethos","el":"Electro"}