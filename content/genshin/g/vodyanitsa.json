":[0.5231,0.2615,0.0463,0.037],"k":"a"},{"n":"Tenacity of the Millelith","r":[0.5231,0.3593,0.0463,0.037],"k":"a"},{"n":"Vourukasha's Glow","r":[0.575,0.3593,0.0463,0.037],"k":"a"},{"n":"Song of Days Past","r":[0.5231,0.4496,0.0463,0.037],"k":"a"},{"n":"Vodyanitsa","r":[0.0815,0.5667,0.037,0.0296]},{"n":"Vesna","r":[0.1259,0.5667,0.037,0.0296]},{"n":"Odette","r":[0.1704,0.5667,0.037,0.0296]},{"n":"Vodyanitsa","r":[0.0815,0.6274,0.037,0.0296]},{"n":"Skirk","r":[0.1259,0.6274,0.037,0.0296]},{"n":"Furina","r":[0.1704,0.6274,0.037,0.0296]},{"n":"Escoffier","r":[0.2148,0.6274,0.037,0.0296]},{"n":"Vodyanitsa","r":[0.0815,0.6881,0.037,0.0296]},{"n":"Neuvillette","r":[0.1259,0.6881,0.037,0.0296]},{"n":"Furina","r":[0.1704,0.6881,0.037,0.0296]},{"n":"Xilonen","r":[0.2148,0.6881,0.037,0.0296]},{"n":"Vodyanitsa","r":[0.0815,0.7489,0.037,0.0296]},{"n":"Yumemizuki Mizuki","r":[0.1259,0.7489,0.037,0.0296]},{"n":"Diona","r":[0.1704,0.7489,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/vodyanitsa/261111-225405/en-1.t.webp","why":{"w":[{"name":"Hymn of the Maelstrom","text":"Signature HP and healing bonuses with team ATK support, suited to Freeze and Stellar Swirl teams."},{"name":"Thrilling Tales of Dragon Slayers","text":"F2P HP catalyst with a major buff to the next active ATK-scaling teammate."},{"name":"Jadefall's Splendor","text":"HP% and Energy restoration; offers less team utility than Thrilling Tales or her signature."},{"name":"Everlasting Moonglow","text":"HP% and healing bonus with an on-field Normal Attack and Energy passive; limited on pure off-field supports."},{"name":"Prototype Amber","text":"Craftable HP% catalyst restoring Energy and healing the party after Burst; useful with Furina."},{"name":"Ash-Graven Drinking Horn","text":"Event option with an HP stat and an AoE hit equal to 40% of Max HP."}],"a":[{"names":["Tenacity of the Millelith"],"text":"Tenacity is Vodyanitsa's premier support set for ATK-scaling teams, offering additional HP and consistent teamwide ATK buffs. An excellent choice for Skirk and Vesna compositions.","stats":"HP% · HP% · HP%"},{"names":["Tenacity of the Millelith","Vourukasha's Glow"],"text":"For Neuvillette and Mizuki teams, consider 2-piece Tenacity + 2-piece Vourukasha's Glow instead of TotM 4-Piece. The additional HP is more valuable when the team's damage doesn't benefit from ATK buffs.","stats":"HP% · HP% · HP%"},{"names":["Song of Days Past"],"text":"Turns healing into a flat damage bonus for the active attacker. Use when Tenacity’s ATK buff has little value.","stats":"HP% · HP% · HP%"}],"t":[{"name":"Siren's Symphony","members":["Vodyanitsa","Vesna","Odette","Traveler (Cryo)"],"text":"Vodyanitsa provides healing, Anemo RES Shred, and damage buffs to amplify Vesna's Stellar Swirl damage. Double Cryo helps maintain consistent reactions while keeping Vesna comfortable on-field.","roles":["Healer / Buffer","On-field DPS","Cryo Enabler / Buffer","Cryo Enabler / Sub DPS"]},{"name":"Frozen Melodies","members":["Vodyanitsa","Skirk","Furina","Escoffier"],"text":"Vodyanitsa provides healing, RES Shred, and damage buffs to amplify Skirk's Cryo damage. Furina and Escoffier add powerful damage buffs and Cryo/Hydro synergy for a strong Freeze team.","roles":["Buffs","Main DPS","Buffs","Support"]},{"name":"Mermaid Mayhem","members":["Vodyanitsa","Neuvillette","Furina","Xilonen"],"text":"Vodyanitsa provides Hydro RES Shred, healing, and additional damage buffs to amplify Neuvillette's Hydro damage. Furina adds substantial DMG buffs and off-field damage, while Xilonen further boosts damage through RES Shred and healing.","roles":["Healer / Buffer","On-field DPS","Off-field DPS / Buffer","Healer / Debuffer"]},{"name":"Bubble Trouble","members":["Vodyanitsa","Yumemizuki Mizuki","Diona","Traveler (Cryo)"],"text":"Vodyanitsa provides healing, RES Shred, and Stellar Swirl damage buffs, while Cryo Traveler enables consistent reactions. Diona adds shielding, healing, and additional Cryo application, allowing Mizuki to focus on driving Stellar Swirl damage.","roles":["Healer / Buffer","On-field Driver","Shielder / Healer","Cryo Enabler / Sub DPS"]}],"v":"Freeze Support: Buff the team while healing the active unit.\nHealing Bonus: Use when Tenacity ATK buffs are less valuable.","n":4},"seo":{"roles":["Support / Healer / Res Shr"],"about":"Vodyanitsa is a versatile Hydro support who provides strong team utility, consistent Hydro application, and valuable damage buffs. She fits comfortably into a variety of reaction-focused teams.","pros":["Strong Team Buffs","Consistent Hydro Application","Flexible Team Options","Excellent Support Utility"],"cons":["Limited Personal Damage","Team-Dependent Value","Energy Requirements","Competition for Slots"],"weapons":["Hymn of the Maelstrom","Thrilling Tales of Dragon Slayers","Jadefall's Splendor","Everlasting Moonglow","Prototype Amber","Ash-Graven Drinking Horn"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"Best"},{"sets":["Tenacity of the Millelith","Vourukasha's Glow"],"pcs":"2 + 2 pcs","role":""},{"sets":["Song of Days Past"],"pcs":"4 pcs","role":""}],"main":["HP%","HP%","HP%"],"stats":["HP: 65,000"],"vars":[{"title":"Freeze Support","role":"Support","weapons":["Prototype Amber"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"}],"stats":"Build HP% and ER for sustain.","teams":"Cryo and Hydro damage allies.","when":"Buff the team while healing the active unit.","cond":"","notes":"","pre":false},{"title":"Healing Bonus","role":"Healer","weapons":["Prototype Amber","Everlasting Moonglow"],"arts":[{"sets":["Song of Days Past"],"pcs":"4 pcs"}],"stats":"Build HP% with sufficient ER.","teams":"Teams that value healing-based flat damage buffs.","when":"Use when Tenacity ATK buffs are less valuable.","cond":"","notes":"","pre":false}],"mats":["Varunada Lazurite Sliver","Varunada Lazurite Fragment","Varunada Lazurite Chunk","Varunada Lazurite Gemstone","Unscorched Blossom Branch","Teachings of Fortitude","Guide to Fortitude","Philosophies of Fortitude","Chimeric Core","Symbiotic Chimeric Nucleus","Prime Chimeric Nexus","Frostfairy Flower","Madman's Restraint","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Siren's Symphony","members":["Vodyanitsa","Vesna","Odette","Traveler (Cryo)"]},{"name":"Frozen Melodies","members":["Vodyanitsa","Skirk","Furina","Escoffier"]},{"name":"Mermaid Mayhem","members":["Vodyanitsa","Neuvillette","Furina","Xilonen"]},{"name":"Bubble Trouble","members":["Vodyanitsa","Yumemizuki Mizuki","Diona","Traveler (Cryo)"]}]}}],"title":"Vodyanitsa","el":"Hydro"}