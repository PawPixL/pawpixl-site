"a"},{"n":"Linnea","r":[0.0815,0.6711,0.037,0.0296]},{"n":"Zibai","r":[0.1259,0.6711,0.037,0.0296]},{"n":"Columbina","r":[0.1704,0.6711,0.037,0.0296]},{"n":"Illuga","r":[0.2148,0.6711,0.037,0.0296]},{"n":"Linnea","r":[0.0815,0.7319,0.037,0.0296]},{"n":"Navia","r":[0.1259,0.7319,0.037,0.0296]},{"n":"Columbina","r":[0.1704,0.7319,0.037,0.0296]},{"n":"Furina","r":[0.2148,0.7319,0.037,0.0296]},{"n":"Linnea","r":[0.0815,0.7926,0.037,0.0296]},{"n":"Arataki Itto","r":[0.1259,0.7926,0.037,0.0296]},{"n":"Columbina","r":[0.1704,0.7926,0.037,0.0296]},{"n":"Illuga","r":[0.2148,0.7926,0.037,0.0296]},{"n":"Linnea","r":[0.0815,0.8533,0.037,0.0296]},{"n":"Noelle","r":[0.1259,0.8533,0.037,0.0296]},{"n":"Aino","r":[0.1704,0.8533,0.037,0.0296]},{"n":"Illuga","r":[0.2148,0.8533,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/linnea/261119-002009/en-1.t.webp","why":{"w":[{"name":"Golden Frostbound Oath","text":"Provides 88.2% CRIT DMG and, at R1, grants 16% DEF, 40% Geo DMG, and 40% Lunar-Crystallize DMG to Linnea. When Moondrifts are nearby, teammates also gain 20% Geo and Lunar-Crystallize DMG. Linnea’s signature weapon and best-in-slot choice."},{"name":"Aqua Simulacra","text":"Provides 88.2% CRIT DMG and, at R1, increases damage by 20% when enemies are nearby, even while Linnea is off-field. An excellent 5-star alternative for maximizing her personal damage, though it lacks the DEF and team buffs of her signature."},{"name":"Polar Star","text":"Stacks ATK and DMG via Skill / Burst hits; gives CRIT Rate and rewards frequent off-field casts while…"},{"name":"Slingshot","text":"Provides 31.2% CRIT Rate and, at R5, grants 60% Normal and Charged Attack DMG when hits land within 0.3 seconds of firing. A budget option for Linnea, but its low Base ATK and conditional passive make it a considerable step down from her 5-star choices."},{"name":"Covenant of Frost and Snow","text":"Provides 51.7% DEF and, at R5, grants 240 Elemental Mastery for 12 seconds after using an Elemental Skill. A strong craftable option for Linnea, boosting her Lunar-Crystallize reaction damage, though it lacks the CRIT DMG and team buffs of her signature."}],"a":[{"names":["Aubade of Morningstar and Moon"],"text":"Provides 80 EM and increases the wearer’s Lunar Reaction DMG by 20% while off-field, rising to 60% with Ascendant Gleam. An excellent set for boosting Linnea’s personal Lunar-Crystallize damage.","stats":"DEF % · DEF % · CR/CD"},{"names":["Silken Moon's Serenade"],"text":"Provides 20% Energy Recharge and, at 4-piece, grants the team up to 120 EM and a 10% Lunar Reaction DMG Bonus. Linnea can activate the effect off-field, making this a strong support option when no other teammate carries the set.","stats":""},{"names":["Husk of Opulent Dreams","Golden Troupe"],"text":"Provides 30% DEF and up to 24% additional DEF and 24% Geo DMG Bonus at max stacks. A strong option for Linnea, boosting both her DEF scaling and personal Geo damage, though Aubade is generally better for Lunar-Crystallize damage.","stats":""}],"t":[{"name":"Crater Expectations","members":["Linnea","Zibai","Columbina","Illuga"],"text":"Zibai leads on-field Lunar-Crystallize damage, Columbina provides off-field Hydro and Lunar buffs, Linnea adds Geo RES shred, healing, and EM buffs, and Illuga boosts Geo and Lunar-Crystallize damage.","roles":["Sub DPS","DPS","Hydro Support","Support"]},{"name":"Guns & Rosés","members":["Linnea","Navia","Columbina","Furina"],"text":"Navia leads on-field Geo damage, Columbina provides Hydro application and Lunar reaction buffs, Linnea adds Geo RES shred, healing, and EM buffs, and Furina supplies off-field Hydro and a powerful teamwide DMG Bonus.","roles":["Support","Main DPS","Lunar","Buffs"]},{"name":"OniFans","members":["Linnea","Arataki Itto","Columbina","Illuga"],"text":"Itto leads on-field Geo damage, Linnea provides off-field damage, healing, and Geo RES shred, Columbina enables Lunar-Crystallize with Hydro application, and Illuga boosts Geo and Lunar-Crystallize damage.","roles":["Off-field DPS / Buffer","On-field DPS","Off-field DPS / Buffer","Geo Buffer"]},{"name":"Hopeless Impact","members":["Linnea","Noelle","Aino","Illuga"],"text":"Noelle leads on-field Geo damage and provides healing, Linnea adds off-field damage, Geo RES shred, and healing, Aino enables Hydro application and Lunar-Crystallize, and Illuga boosts Geo and Lunar reaction damage.","roles":["Off-field DPS / Buffer","On-field DPS","Off-field DPS / Enabler","Geo Buffer"]}],"v":"","n":4},"seo":{"roles":["Support / Sub DPS"],"about":"Linnea is a Geo support specializing in Lunar Crystallize, boosting team damage and enabling powerful Lunar focused comps.","pros":["Strong Lunar buffs","Low field time","Great team utility","Easy rotations"],"cons":["Niche team options","Lunar focused","Limited personal DMG","Team dependent"],"weapons":["Golden Frostbound Oath","Aqua Simulacra","Polar Star","Slingshot","The Stringless","Favonius Warbow","Covenant of Frost and Snow","Snare Hook"],"arts":[{"sets":["Aubade of Morningstar and Moon"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Silken Moon's Serenade"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Husk of Opulent Dreams","Golden Troupe"],"pcs":"4 pcs","role":"Main DPS"}],"main":["DEF %","DEF %","Crit Rate / Crit DMG"],"stats":["DEF: 2000+","Crit Rate: 70–80%","Crit DMG: 150%+","Energy Recharge: 110% - 130%"],"vars":[],"mats":["Prithiva Topaz Sliver","Prithiva Topaz Fragment","Prithiva Topaz Chunk","Prithiva Topaz Gemstone","Plume of the Fallen Watcher","Teachings of Vagrancy","Guide to Vagrancy","Philosophies of Vagrancy","Tattered Warrant","Immaculate Warrant","Frost-Etched Warrant","Etherwing Moth","Elixir of the Heretic","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Crater Expectations","members":["Linnea","Zibai","Columbina","Illuga"]},{"name":"Guns & Rosés","members":["Linnea","Navia","Columbina","Furina"]},{"name":"OniFans","members":["Linnea","Arataki Itto","Columbina","Illuga"]},{"name":"Hopeless Impact","members":["Linnea","Noelle","Aino","Illuga"]}]}}],"title":"Linnea","el":"Geo"}