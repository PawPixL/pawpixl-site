anyu","r":[0.0815,0.6593,0.0343,0.0274]},{"n":"Xiangling","r":[0.1231,0.6593,0.0343,0.0274]},{"n":"Bennett","r":[0.1648,0.6593,0.0343,0.0274]},{"n":"Zhongli","r":[0.2065,0.6593,0.0343,0.0274]},{"n":"Ganyu","r":[0.0815,0.7104,0.0343,0.0274]},{"n":"Xiangling","r":[0.1231,0.7104,0.0343,0.0274]},{"n":"Bennett","r":[0.1648,0.7104,0.0343,0.0274]},{"n":"Sucrose","r":[0.2065,0.7104,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/ganyu/261111-224949/en-1.t.webp","why":{"w":[{"name":"Astral Vulture's Crimson Plumage","text":"Top premium Melt bow with CRIT DMG and a large Charged Attack bonus after teammates trigger reactions. Strongest in Melt teams."},{"name":"The First Great Magic","text":"High CRIT DMG and Charged Attack damage. Its ATK bonus improves with additional Cryo teammates. Especially strong in Freeze and Mono Cryo."},{"name":"Hunter's Path","text":"Provides CRIT Rate and boosts Charged Attack damage using EM, making it a standout Melt option. Best for Melt. Watch CRIT Rate."},{"name":"Amos' Bow","text":"A classic Ganyu option. Its ATK and Charged Attack bonus grow with arrow travel time, including her Frostflake Bloom. Good in both Melt and Freeze."},{"name":"Aqua Simulacra","text":"Offers huge CRIT DMG and a damage bonus while Ganyu stays near enemies. Its low Base ATK favors external ATK buffs. Stay within passive range."},{"name":"Flower-Wreathed Feathers","text":"Gives ATK and strong Charged Attack damage bonuses. A useful four-star gacha bow for both Melt and Freeze. Stronger with refinements. R5 improves its value."},{"name":"Scion of the Blazing Sun","text":"CRIT Rate and a debuff that increases Charged Attack damage against marked enemies. Avoid excess CRIT in Freeze."},{"name":"Hamayumi","text":"A reliable craftable Melt bow that buffs Charged Attacks, especially when Ganyu keeps her Burst unused. Best for Melt with full Energy. R5 recommended."}],"a":[{"names":["Wanderer's Troupe"],"text":"Reliable Melt set with 80 EM and a 35% Charged Attack damage bonus.","stats":"EM / Cryo DMG / CRIT"},{"names":["Blizzard Strayer"],"text":"Best for traditional Freeze against freezable enemies. Adds substantial CRIT Rate against Cryo and Frozen targets.","stats":"ATK% / Cryo DMG / CRIT DMG"},{"names":["Unfinished Reverie"],"text":"Best for Burnmelt when teammates maintain Burning on enemies. Gives a large conditional damage bonus.","stats":"EM / Cryo DMG / CRIT"}],"t":[{"name":"Frostbound Royalty","members":["Ganyu","Furina","Escoffier","Shenhe"],"text":"Furina buffs and supplies Hydro, Escoffier heals and lowers Cryo and Hydro resistance, and Shenhe empowers Ganyu’s Cryo damage.","roles":["On-field DPS","Off-field DPS / Buffer","Healer / Debuffer","Cryo Buffer"]},{"name":"Embers in the Snow","members":["Ganyu","Emilie","Dehya","Bennett"],"text":"Emilie and Dehya maintain Burning for Ganyu’s Melt shots. Bennett buffs ATK and heals, while Dehya provides interruption resistance.","roles":["On-field DPS","Off-field DPS","Pyro Enabler / Support","Healer / Buffer"]},{"name":"Melt the Mountains","members":["Ganyu","Xiangling","Bennett","Zhongli"],"text":"Xiangling applies Pyro for Melt, Bennett boosts ATK, and Zhongli shields Ganyu while she charges her shots.","roles":["On-field DPS","Off-field DPS / Pyro Enabler","Healer / Buffer","Shielder / Debuffer"]},{"name":"Budget Blizzard","members":["Ganyu","Xiangling","Bennett","Sucrose"],"text":"Xiangling enables Melt, Bennett buffs and heals, and Sucrose shares EM and reduces Cryo resistance. Careful aiming is needed without a shield.","roles":["On-field DPS","Off-field DPS / Pyro Enabler","Healer / Buffer","EM Buffer / Debuffer"]}],"v":"Melt DPS: Use Wanderer’s Troupe, an EM Sands, and consistent off-field Pyro. Her Burst can interfere with the Pyro aura.\nFreeze DPS: Use Blizzard Strayer and focus on CRIT DMG. Frozen enemies give more CRIT Rate through the set bonus.\nBurnmelt: Unfinished Reverie shines when Burning stays active through Emilie or a Dendro and Pyro combination.\nOff-field Burst: Prioritize her Burst and enough ER to cast every rotation. A support set or Favonius Warbow can help the team.","n":4},"seo":{"roles":["Main DPS"],"about":"Ganyu is a Cryo damage dealer whose Frostflake Charged Shots deliver powerful area damage. She excels in Freeze, Melt, and Burning teams. Freeze helps control groups, while Melt rewards precise aiming and reliable Pyro application. Her Burst also makes her a useful off-field Cryo option.","pros":["Powerful Charged Shots","Great area damage","Flexible Cryo playstyles","Strong off-field Burst"],"cons":["Aiming can be tricky","Vulnerable while charging","Melt needs steady Pyro","Freeze struggles on bosses"],"weapons":["Astral Vulture's Crimson Plumage","The First Great Magic","Hunter's Path","Amos' Bow","Aqua Simulacra","Flower-Wreathed Feathers","Scion of the Blazing Sun","Hamayumi"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs","role":""},{"sets":["Blizzard Strayer"],"pcs":"4 pcs","role":""},{"sets":["Unfinished Reverie"],"pcs":"4 pcs","role":""}],"main":["ATK% / Elemental Mastery","Cryo DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["ATK: 1,800 - 2,200","CRIT Rate: 50% - 70% (Melt)","CRIT Rate: 25% - 45% (Freeze)","CRIT DMG: 160% - 220%","EM: 150 - 300 (Melt)"],"vars":[{"title":"Melt Charged Shots","role":"On-field DPS","weapons":["Astral Vulture's Crimson Plumage","The First Great Magic","Hunter's Path"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"}],"stats":"EM Sands can work; prioritize CRIT DMG and charged-shot damage.","teams":"Consistent off-field Pyro and interruption protection.","when":"Use for high-damage Frostflake Arrow Melt hits.","cond":"Needs reliable Pyro application.","notes":"","pre":false},{"title":"Freeze / Mono Cryo","role":"On-field DPS","weapons":["Amos' Bow","Aqua Simulacra"],"arts":[{"sets":["Blizzard Strayer"],"pcs":"4 pcs"}],"stats":"Reduce sheet CRIT Rate to account for Freeze bonuses.","teams":"Hydro for Freeze or strong Cryo buffers.","when":"Blizzard Strayer offers easy CRIT Rate when enemies stay Cryo-affected.","cond":"Freeze is unreliable against some bosses.","notes":"","pre":false},{"title":"Burnmelt","role":"On-field DPS","weapons":["Astral Vulture's Crimson Plumage","The First Great Magic"],"arts":[{"sets":["Unfinished Reverie"],"pcs":"4 pcs"},{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"}],"stats":"EM is valuable; still balance ATK and CRIT.","teams":"Dendro and Pyro teammates that maintain Burning.","when":"Use Burning to sustain Pyro aura for Ganyu’s Melt shots.","cond":"Unfinished Reverie needs stable Burning uptime.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Hoarfrost Core","Teachings of Diligence","Guide to Diligence","Philosophies of Diligence","Whopperflower Nectar","Shimmering Nectar","Energy Nectar","Qingxin","Shadow of the Warrior","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 9+"},{"name":"Elemental Skill","pri":"Level 6–8"},{"name":"Elemental Burst","pri":"Level 8–9"}],"teams":[{"name":"Frostbound Royalty","members":["Ganyu","Furina","Escoffier","Shenhe"]},{"name":"Embers in the Snow","members":["Ganyu","Emilie","Dehya","Bennett"]},{"name":"Melt the Mountains","members":["Ganyu","Xiangling","Bennett","Zhongli"]},{"name":"Budget Blizzard","members":["Ganyu","Xiangling","Bennett","Sucrose"]}]}}],"title":"Ganyu","el":"Cryo"}