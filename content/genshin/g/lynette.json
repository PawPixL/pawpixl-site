163,0.0343,0.0274]},{"n":"Nahida","r":[0.2065,0.6163,0.0343,0.0274]},{"n":"Lynette","r":[0.0815,0.6674,0.0343,0.0274]},{"n":"Faruzan","r":[0.1231,0.6674,0.0343,0.0274]},{"n":"Furina","r":[0.1648,0.6674,0.0343,0.0274]},{"n":"Xianyun","r":[0.2065,0.6674,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/lynette/261111-225116/en-1.t.webp","why":{"w":[{"name":"Favonius Sword","text":"ER and CRIT-triggered neutral particles help fund her costly Burst and support team rotations."},{"name":"Freedom-Sworn","text":"Elemental Mastery strengthens Swirls; triggering reactions builds teamwide ATK and Normal/Charged/Plunging Attack buffs. Best when teammates use its buffs and Burst energy is covered."},{"name":"Skyward Blade","text":"A substantial ER substat supports Burst uptime."},{"name":"Sacrificial Sword","text":"ER plus a possible extra Skill use increases Anemo particles and Swirl opportunities."},{"name":"Xiphos' Moonlight","text":"Its EM substat improves Swirl damage while converting EM into Energy Recharge for Lynette and her teammates. For EM-focused support or C6 reaction-driver builds. More refinements boost shared ER."},{"name":"Fleuve Cendre Ferryman","text":"A free fishing sword that adds Energy Recharge, Skill CRIT Rate, and temporary extra ER after using Skill. Excellent free choice if you can fish for it. R5 obtainable through fishing."},{"name":"Amenoma Kageuchi","text":"ATK% boosts personal damage, while Skill-generated Succession Seeds restore Energy after Burst. Better when multiple Skills are used across rotations; watch ER. Refinement increases Energy restored."},{"name":"Wolf-Fang","text":"CRIT Rate plus Skill and Burst damage bonuses improve her personal damage when Energy Recharge is already sufficient. Primarily damage-oriented or C6 builds; its stacks need on-field hits."}],"a":[{"names":["Viridescent Venerer"],"text":"Swirling Pyro, Hydro, Electro, or Cryo reduces that element’s enemy RES by 40% for 10s.","stats":"ER/ATK% · Anemo DMG · CRIT"},{"names":["Emblem of Severed Fate"],"text":"Converts Energy Recharge into Burst damage, ideal when another Anemo ally already provides VV shred.","stats":"ER/ATK% · Anemo DMG · CRIT"},{"names":["Noblesse Oblige"],"text":"Grants the party 20% ATK after Burst; only use if no other teammate already carries 4pc Noblesse.","stats":"ER/ATK% · Anemo DMG · CRIT"}],"t":[{"name":"Childe Vaporize","members":["Lynette","Tartaglia","Xiangling","Bennett"],"text":"Lynette Swirls Hydro or Pyro for VV shred and offers a taunt; Tartaglia enables Xiangling Vaporize while Bennett buffs and heals.","roles":["Support / Debuffer","On-field DPS / Hydro Enabler","Off-field DPS / Pyro Enabler","Healer / Buffer"]},{"name":"Crimson Catwalk","members":["Lynette","Arlecchino","Yelan","Bennett"],"text":"Lynette shreds Pyro or Hydro RES with VV; Yelan supplies off-field Hydro and buffs while Bennett buffs Arlecchino.","roles":["Support / Debuffer","On-field DPS","Off-field DPS / Buffer","Healer / Buffer"]},{"name":"Electric Masquerade","members":["Lynette","Clorinde","Fischl","Nahida"],"text":"Lynette Swirls Electro for VV shred, boosting Clorinde and Fischl; Nahida maintains Dendro for Aggravate reactions.","roles":["Support / Debuffer","On-field DPS","Off-field DPS / Battery","Dendro Enabler / Buffer"]},{"name":"C6 Plunge Revue","members":["Lynette","Faruzan","Furina","Xianyun"],"text":"At C6, Lynette uses Anemo-infused attacks and Xianyun-enabled plunges; Faruzan buffs Anemo and Furina provides damage buffs.","roles":["Support / Debuffer","Anemo Buffer / Debuffer","Off-field DPS / Buffer","Healer / Plunge Buffer"]}],"v":"C6 Anemo Carry: C6 Anemo-infused on-field attacks: Marechaussee Hunter with Furina; ATK%/Anemo/CRIT, balanced ER.\nC6 Hyperbloom Driver: C6 only: EM/EM/EM on 4pc VV or Gilded Dreams; Swirl Electro into Dendro Cores with Hydro and Dendro allies.\nBurst Damage: 4pc Emblem, ER/ATK%/CRIT; best when another teammate already handles VV resistance shred.\nNoblesse Buffer: 4pc Noblesse for 20% team ATK after Burst; avoid duplicating another Noblesse holder.\nFree-to-Play: Fleuve Cendre Ferryman and 4pc VV; prioritize enough ER to Burst, then CRIT and ATK%.","n":3},"seo":{"roles":["Support / Sub DPS"],"about":"Lynette is an off-field Anemo support whose Burst taunts enemies and deals periodic Anemo damage. Viridescent Venerer lets her reduce Swirled elemental RES, while her passive grants a modest team ATK buff. Her C6 unlocks an Anemo-infused on-field driver playstyle.","pros":["VV resistance shred","Useful Burst taunt","Free story character","C6 Anemo infusion"],"cons":["High Burst energy cost","Limited crowd control","Needs ER or a battery","C6 for on-field damage"],"weapons":["Favonius Sword","Freedom-Sworn","Skyward Blade","Sacrificial Sword","Xiphos' Moonlight","Fleuve Cendre Ferryman","Amenoma Kageuchi","Wolf-Fang"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs","role":"Best"},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":"Personal DMG"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"ATK Buffer"}],"main":["Energy Recharge / ATK%","Anemo DMG Bonus / ATK%","CRIT Rate / CRIT DMG"],"stats":["ER, solo Anemo: 180% - 200%","ER, solo Anemo (1 Skill, no Fav): 240%+","ER, 2 Skills + Fav: 115% - 160%","CRIT Rate, Favonius: 45% - 65%","CRIT Rate, damage build: 60% - 75%"],"vars":[{"title":"C6 Anemo Carry","role":"On-field DPS","weapons":["Primordial Jade Cutter","Wolf-Fang","Finale of the Deep"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"},{"sets":["Desert Pavilion Chronicle"],"pcs":"4 pcs"}],"stats":"ATK%/Anemo DMG/CRIT; maintain Burst ER; account for Marechaussee CRIT Rate.","teams":"C6 required; Faruzan and Furina/Xianyun are strong partners.","when":"Use the C6 Anemo infusion for on-field attacks and optionally Xianyun-enhanced plunges. Lynette can self-drain/heal HP for Marechaussee.","cond":"Requires C6","notes":"Desert Pavilion is an alternative when its Charged Attack activation fits your rotation.","pre":false},{"title":"C6 Hyperbloom Driver","role":"Reaction Driver","weapons":["Xiphos' Moonlight","Freedom-Sworn","Iron Sting","Favonius Sword"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM/EM/EM; use ER Sands if Burst uptime is inconsistent. Level 90 matters for reaction damage.","teams":"C6; Electro + Hydro + Dendro teammates, e.g. Fischl, Xingqiu, Nahida.","when":"Anemo-infused attacks Swirl Electro into Dendro Cores, triggering Hyperbloom; VV also enhances Hydro and Electro teammate damage.","cond":"Requires C6 and Electro aura access","notes":"Do not assume Lynette owns every Hyperbloom when Electro teammates also trigger cores.","pre":false},{"title":"Burst Damage","role":"Off-field DPS","weapons":["Favonius Sword","Skyward Blade","Sacrificial Sword","Fleuve Cendre Ferryman"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"}],"stats":"ER/ATK% Sands, Anemo Goblet, CRIT Circlet; meet Burst ER first.","teams":"Best if another Anemo already holds Viridescent Venerer or VV offers little value.","when":"Concentrates on her Burst damage rather than boosting Pyro, Hydro, Electro, or Cryo allies.","cond":"High Energy Recharge may be needed as solo Anemo","notes":"Emblem does not replace VV resistance reduction in reaction-focused teams.","pre":false},{"title":"Noblesse Team Buffer","role":"Support","weapons":["Favonius Sword","Sacrificial Sword","Fleuve Cendre Ferryman"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Prioritize ER; use CRIT Rate for Favonius, then ATK or CRIT as desired.","teams":"ATK-scaling main damage dealer; no existing 4pc Noblesse wielder.","when":"Use her Burst to provide 20% team ATK. This is a fallback when VV shred is unavailable, redundant, or assigned elsewhere.","cond":"Do not stack duplicate 4pc Noblesse buffs","notes":"Her modest built-in ATK buff remains separate from the Noblesse buff.","pre":false},{"title":"Accessible VV Support","role":"Support","weapons":["Fleuve