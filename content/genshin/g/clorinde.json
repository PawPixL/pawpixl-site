rged","r":[0.1093,0.3233,0.0472,0.0378],"k":"w"},{"n":"Haran Geppaku Futsu","r":[0.1093,0.3841,0.0472,0.0378],"k":"w"},{"n":"The Black Sword","r":[0.1093,0.4448,0.0472,0.0378],"k":"w"},{"n":"Fragment of Harmonic Whimsy","r":[0.5231,0.2552,0.0472,0.0378],"k":"a"},{"n":"Thundering Fury","r":[0.5231,0.3307,0.0472,0.0378],"k":"a"},{"n":"Gladiator's Finale","r":[0.5231,0.4063,0.0472,0.0378],"k":"a"},{"n":"Clorinde","r":[0.0815,0.5548,0.037,0.0296]},{"n":"Fischl","r":[0.1259,0.5548,0.037,0.0296]},{"n":"Nahida","r":[0.1704,0.5548,0.037,0.0296]},{"n":"Kaedehara Kazuha","r":[0.2148,0.5548,0.037,0.0296]},{"n":"Clorinde","r":[0.0815,0.6089,0.037,0.0296]},{"n":"Chevreuse","r":[0.1259,0.6089,0.037,0.0296]},{"n":"Kujou Sara","r":[0.1704,0.6089,0.037,0.0296]},{"n":"Mavuika","r":[0.2148,0.6089,0.037,0.0296]},{"n":"Clorinde","r":[0.0815,0.663,0.037,0.0296]},{"n":"Furina","r":[0.1259,0.663,0.037,0.0296]},{"n":"Xilonen","r":[0.1704,0.663,0.037,0.0296]},{"n":"Ororon","r":[0.2148,0.663,0.037,0.0296]},{"n":"Clorinde","r":[0.0815,0.7237,0.037,0.0296]},{"n":"Fischl","r":[0.1259,0.7237,0.037,0.0296]},{"n":"Kirara","r":[0.1704,0.7237,0.037,0.0296]},{"n":"Sucrose","r":[0.2148,0.7237,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/clorinde/261111-224833/en-1.t.webp","why":{"w":[{"name":"Absolution","text":"Her signature gives CRIT DMG and increases damage whenever her Bond of Life rises. Best overall damage weapon."},{"name":"Mistsplitter Reforged","text":"Provides CRIT DMG and Elemental DMG bonuses that Clorinde can use during her Electro attacks. Passive stacks depend on rotation."},{"name":"Haran Geppaku Futsu","text":"Boosts Normal Attack damage and Elemental DMG, which suit her Skill attacks. Watch for excess CRIT Rate."},{"name":"Light of Foliar Incision","text":"Huge CRIT DMG with extra Normal Attack damage that scales with Elemental Mastery. Best in Aggravate teams with some EM."},{"name":"The Black Sword","text":"CR and Normal Attack damage. Its healing is secondary to Clorinde’s own sustain; avoid excess CR."},{"name":"Lion's Roar","text":"Increases damage against enemies affected by Electro or Pyro. Needs reliable aura uptime. Higher refinements help."},{"name":"Finale of the Deep","text":"Craftable ATK sword with a Bond of Life passive Clorinde can clear using her own healing."},{"name":"Calamity of Eshu","text":"Event sword boosting Normal Attacks when shielded. Requires a consistent shield."}],"a":[{"names":["Fragment of Harmonic Whimsy"],"text":"Bond of Life changes grant damage bonuses that Clorinde stacks quickly during her Skill.","stats":"ATK% / Electro DMG / CRIT"},{"names":["Thundering Fury"],"text":"Electro reactions reduce Skill cooldown. Use with an adjusted rotation, especially Aggravate.","stats":"ATK%/EM · Electro · CR/CD"},{"names":["Gladiator's Finale"],"text":"Boosts her Normal Attack damage during Skill, making a good set while farming Whimsy.","stats":"ATK% / Electro DMG / CRIT"}],"t":[{"name":"Duelist’s Verdict","members":["Clorinde","Fischl","Nahida","Kaedehara Kazuha"],"text":"Nahida enables Quicken, Fischl adds Electro damage, and Kazuha shreds Electro resistance. Clorinde drives Aggravate.","roles":["On-field DPS","Off-field DPS / Battery","Dendro Enabler / Buffer","Buffer / Debuffer"]},{"name":"Overload Authority","members":["Clorinde","Chevreuse","Kujou Sara","Mavuika"],"text":"Chevreuse shreds Electro and Pyro resistance after Overload. Sara buffs Clorinde while Mavuika adds Pyro damage.","roles":["On-field DPS","Healer / Buffer","ATK Buffer","Off-field DPS / Pyro Enabler"]},{"name":"Charged Justice","members":["Clorinde","Furina","Xilonen","Ororon"],"text":"Furina buffs team damage, Ororon adds Electro damage, and Xilonen reduces resistance. Clorinde heals herself while attacking.","roles":["On-field DPS","Off-field DPS / Buffer","Healer / Debuffer","Off-field DPS / Battery"]},{"name":"Headed to jail","members":["Clorinde","Fischl","Kirara","Sucrose"],"text":"Kirara provides Dendro and a shield. Fischl adds Electro damage, while Sucrose shares EM and shreds Electro resistance.","roles":["On-field DPS","Off-field DPS / Battery","Shielder / Dendro Enabler","EM Buffer / Debuffer"]}],"v":"Aggravate Driver: Choose for frequent Aggravate reactions and flexible Skill rotations.\nOverloaded Duelist: Use Chevreuse’s resistance reduction and buffs for consistent Electro damage.\nShielded Budget: A lower-cost build that keeps her fast gun-and-lunge gameplay.","n":4},"seo":{"roles":["Main DPS"],"about":"Clorinde is an on-field Electro DPS who converts Bond of Life into rapid pistol shots and lunges. Her Skill supplies self-healing, and she performs well in Aggravate, Overloaded, and Electro-Charged teams.","pros":["Fast Electro damage","Strong self-healing","Flexible team options","Mobile combat style"],"cons":["Vulnerable to interruption","Long Skill cooldown","Timing matters","Needs reaction support"],"weapons":["Absolution","Mistsplitter Reforged","Haran Geppaku Futsu","Light of Foliar Incision","The Black Sword","Lion's Roar","Finale of the Deep","Calamity of Eshu"],"arts":[{"sets":["Fragment of Harmonic Whimsy"],"pcs":"4 pcs","role":"Best Overall"},{"sets":["Thundering Fury"],"pcs":"4 pcs","role":"Aggravate Rotations"},{"sets":["Gladiator's Finale"],"pcs":"4 pcs","role":"Accessible Alternative"}],"main":["ATK% / EM","Electro DMG","CR / CD"],"stats":["CR: 55–75%","CD: 140–200%+","ATK: 1,800–2,400","ER: Team-based"],"vars":[{"title":"Aggravate Driver","role":"On-field DPS","weapons":["Absolution","Light of Foliar Incision","Lion's Roar"],"arts":[{"sets":["Thundering Fury"],"pcs":"4 pcs"},{"sets":["Fragment of Harmonic Whimsy"],"pcs":"4 pcs"}],"stats":"ATK% or EM / Electro / CRIT.","teams":"Dendro application and Electro support; account for her CR buff.","when":"Choose for frequent Aggravate reactions and flexible Skill rotations.","cond":"EM matters more than in raw Electro teams","notes":"","pre":false},{"title":"Overloaded Duelist","role":"On-field DPS","weapons":["Absolution","Finale of the Deep","The Black Sword"],"arts":[{"sets":["Fragment of Harmonic Whimsy"],"pcs":"4 pcs"},{"sets":["Thundering Fury"],"pcs":"4 pcs"}],"stats":"ATK% / Electro / CRIT.","teams":"Chevreuse and only Pyro/Electro teammates.","when":"Use Chevreuse’s resistance reduction and buffs for consistent Electro damage.","cond":"Requires Overloaded to maintain Chevreuse shred","notes":"","pre":false},{"title":"Shielded Budget","role":"On-field DPS","weapons":["Calamity of Eshu","Finale of the Deep","Lion's Roar"],"arts":[{"sets":["Fragment of Harmonic Whimsy"],"pcs":"4 pcs"},{"sets":["Gladiator's Finale"],"pcs":"4 pcs"}],"stats":"ATK% / Electro / CRIT.","teams":"Reliable shielder for Calamity of Eshu.","when":"A lower-cost build that keeps her fast gun-and-lunge gameplay.","cond":"Calamity passive only works while shielded","notes":"","pre":false}],"mats":["Vajrada Amethyst Sliver","Vajrada Amethyst Fragment","Vajrada Amethyst Chunk","Vajrada Amethyst Gemstone","Fontemer Unihorn","Teachings of Justice","Guide to Justice","Philosophies of Justice","Transoceanic Pearl","Transoceanic Chunk","Xenochromatic Crystal","Lumitoile","Everamber","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 8 - 9"}],"teams":[{"name":"Duelist’s Verdict","members":["Clorinde","Fischl","Nahida","Kaedehara Kazuha"]},{"name":"Overload Authority","members":["Clorinde","Chevreuse","Kujou Sara","Mavuika"]},{"name":"Charged Justice","members":["Clorinde","Furina","Xilonen","Ororon"]},{"name":"Headed to jail","members":["Clorinde","Fischl","Kirara","Sucrose"]}]}}],"title":"Clorinde","el":"Electro"}