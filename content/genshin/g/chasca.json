.5231,0.4111,0.0481,0.0385],"k":"a"},{"n":"Chasca","r":[0.0815,0.5467,0.038,0.0304]},{"n":"Iansan","r":[0.1269,0.5467,0.038,0.0304]},{"n":"Nicole","r":[0.1722,0.5467,0.038,0.0304]},{"n":"Durin","r":[0.2176,0.5467,0.038,0.0304]},{"n":"Chasca","r":[0.0815,0.6096,0.038,0.0304]},{"n":"Odette","r":[0.1269,0.6096,0.038,0.0304]},{"n":"Nicole","r":[0.1722,0.6096,0.038,0.0304]},{"n":"Yae Miko","r":[0.2176,0.6096,0.038,0.0304]},{"n":"Chasca","r":[0.0815,0.6644,0.038,0.0304]},{"n":"Columbina","r":[0.1269,0.6644,0.038,0.0304]},{"n":"Nicole","r":[0.1722,0.6644,0.038,0.0304]},{"n":"Ineffa","r":[0.2176,0.6644,0.038,0.0304]},{"n":"Chasca","r":[0.0815,0.7193,0.038,0.0304]},{"n":"Ororon","r":[0.1269,0.7193,0.038,0.0304]},{"n":"Bennett","r":[0.1722,0.7193,0.038,0.0304]},{"n":"Diona","r":[0.2176,0.7193,0.038,0.0304]}]}]}},"thumb":"content/genshin/builds/chasca/261111-224807/en-1.t.webp","why":{"w":[{"name":"Astral Vulture's Crimson Plumage","text":"Provides massive CRIT DMG, ATK, Charged Attack, and Burst bonuses that directly boost Chasca’s overall damage."},{"name":"Aqua Simulacra","text":"High CD and a strong damage bonus while near enemies. Positioning matters."},{"name":"The First Great Magic","text":"Provides CRIT DMG and Charged Attack damage. Its ATK and movement effects depend on the party’s elemental composition."},{"name":"Thundering Pulse","text":"Offers high CRIT DMG and an ATK bonus, but its Normal Attack passive is poorly suited to Chasca’s charged shots."},{"name":"Flower-Wreathed Feathers","text":"ATK and strong Charged Attack buffs. Excellent at higher refinements."},{"name":"Scion of the Blazing Sun","text":"CR and a Charged Attack bonus against marked targets. Watch CR overcap with Codex."},{"name":"Song of Stillness","text":"Craftable ATK bow with a damage buff after healing. Overhealing can trigger it. Bring a reliable healer."},{"name":"Blackcliff Warbow","text":"Offers CRIT DMG, but its passive needs enemy defeats and is unreliable against bosses. A situational shop option."}],"a":[{"names":["Obsidian Codex"],"text":"Grants 15% damage during Nightsoul’s Blessing and up to 40% CRIT Rate when Nightsoul points are consumed.","stats":"ATK% · ATK% · CD/CR"},{"names":["Marechaussee Hunter"],"text":"Gain up to 36% CRIT Rate from HP changes. A Furina-dependent fallback to Obsidian Codex.","stats":"ATK% · ATK% · CD"},{"names":["Viridescent Venerer"],"text":"Swirl reduces enemy resistance to the Swirled element. Support-only option with much lower personal damage.","stats":"ATK% · ATK% · CR/CD"}],"t":[{"name":"Hexecutioners","members":["Chasca","Iansan","Nicole","Durin"],"text":"Chasca fires mixed-element shells. Iansan supplies ATK, Durin adds Pyro damage, and Nicole provides buffs and protection.","roles":["DPS","ATK Buffer","Support","Sub DPS"]},{"name":"Starstruck","members":["Chasca","Odette","Nicole","Yae Miko"],"text":"Chasca delivers converted shells while Odette, Nicole, and Yae Miko provide buffs, protection, and off-field damage.","roles":["DPS","Support","Support","Sub DPS"]},{"name":"Moonstruck","members":["Chasca","Columbina","Nicole","Ineffa"],"text":"Columbina and Ineffa enable Lunar-Charged damage around Chasca’s shells. Nicole provides additional buffs and protection.","roles":["DPS","Lunar Support","Support","Sub DPS"]},{"name":"Budget Airlines","members":["Chasca","Ororon","Bennett","Diona"],"text":"Ororon adds Electro damage, Bennett buffs ATK and heals, and Diona shields Chasca while enabling Cryo shells.","roles":["DPS","Sub DPS","ATK Buffer","Shield"]}],"v":"Furina CRIT Setup: Use Marechaussee Hunter when reliable HP changes maintain its CR bonus.\nBudget Flight: A lower-cost setup that retains Chasca’s charged-shell damage.\nSwirl Support: A niche alternative when Chasca’s team value matters more than her own damage.","n":4},"seo":{"roles":["Main DPS"],"about":"Chasca is an aerial on-field DPS who fires Charged Attack shells converted to Pyro, Hydro, Electro, or Cryo. Her best teams supply these elements and amplify her multi-element damage.","pros":["Elite Exploration","Scales well with constellations","Flexible Team Reactions","F2P Friendly"],"cons":["Limited AoE before C2","Shell element randomness","Buff timing matters","Teammate element limits"],"weapons":["Astral Vulture's Crimson Plumage","Aqua Simulacra","The First Great Magic","Thundering Pulse","Flower-Wreathed Feathers","Scion of the Blazing Sun","Song of Stillness","Blackcliff Warbow"],"arts":[{"sets":["Obsidian Codex"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs","role":"Support"}],"main":["ATK%","ATK%","CD / CR"],"stats":["CR: 40–60% with Codex","CD: 170–220%+","ATK: 1,800–2,300","ER: Low priority"],"vars":[{"title":"Furina CRIT Setup","role":"On-field DPS","weapons":["Astral Vulture's Crimson Plumage","Aqua Simulacra","Flower-Wreathed Feathers"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"ATK% / ATK% / CD; account for artifact CR.","teams":"Furina plus consistent healing.","when":"Use Marechaussee Hunter when reliable HP changes maintain its CR bonus.","cond":"Only with dependable HP changes","notes":"","pre":false},{"title":"Budget Flight","role":"On-field DPS","weapons":["Flower-Wreathed Feathers","Song of Stillness","Scion of the Blazing Sun"],"arts":[{"sets":["Obsidian Codex"],"pcs":"4 pcs"}],"stats":"ATK% / ATK% / CRIT; favor CD with Codex.","teams":"Pyro, Hydro, Electro, or Cryo teammates; healer for Song of Stillness.","when":"A lower-cost setup that retains Chasca’s charged-shell damage.","cond":"Song of Stillness needs healing","notes":"","pre":false},{"title":"Swirl Support","role":"Support","weapons":["Song of Stillness","Aqua Simulacra"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"Trade personal damage for Swirl utility.","teams":"Teams that benefit from resistance reduction.","when":"A niche alternative when Chasca’s team value matters more than her own damage.","cond":"Lower personal damage than Codex","notes":"","pre":false}],"mats":["Vayuda Turquoise Sliver","Vayuda Turquoise Fragment","Vayuda Turquoise Chunk","Vayuda Turquoise Gemstone","Ensnaring Gaze","Teachings of Conflict","Guide to Conflict","Philosophies of Conflict","Juvenile Fang","Seasoned Fang","Tyrant's Fang","Withering Purpurbloom","Silken Feather","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Phantom Feather Flurry","pri":"Level 1+"},{"name":"Spirit Reins, Shadow Hunt","pri":"Level 9+"},{"name":"Soul Reaper's Fatal Round","pri":"Level 6–8"}],"teams":[{"name":"Hexecutioners","members":["Chasca","Iansan","Nicole","Durin"]},{"name":"Starstruck","members":["Chasca","Odette","Nicole","Yae Miko"]},{"name":"Moonstruck","members":["Chasca","Columbina","Nicole","Ineffa"]},{"name":"Budget Airlines","members":["Chasca","Ororon","Bennett","Diona"]}]}}],"title":"Chasca","el":"Anemo"}