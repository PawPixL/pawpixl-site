]}]}]}},"thumb":"content/genshin/builds/tighnari/261111-225304/en-1.t.webp","why":{"w":[{"name":"Hunter's Path","text":"CRIT Rate and Elemental DMG boost pair with a Charged Attack bonus based on EM. His strongest personal damage weapon. Prioritize an EM Sands."},{"name":"Aqua Simulacra","text":"Massive CRIT DMG and a nearby-enemy DMG bonus enhance Charged Attacks and Burst. Stay reasonably close to enemies for the passive."},{"name":"Polar Star","text":"CR and stacking ATK improve DMG."},{"name":"The First Great Magic","text":"CD and Charged Attack DMG provide strong value."},{"name":"Skyward Harp","text":"High Base ATK plus CRIT Rate and CRIT DMG make this a reliable all-purpose damage option."},{"name":"Elegy for the End","text":"Energy Recharge and its teamwide EM and ATK buff benefit Quicken teams, trading some personal damage for team output. Team-focused choice, especially with higher ER needs."},{"name":"Slingshot","text":"Excellent 3-star option: high CRIT Rate and a large Charged Attack DMG bonus when shots land quickly. Stay close enough to trigger the fast-hit passive. R5 recommended."},{"name":"Song of Stillness","text":"Craftable ATK% bow that increases damage after receiving healing. Useful when paired with an off-field healer. Needs reliable healing to maintain its passive. R5 recommended."}],"a":[{"names":["Wanderer's Troupe"],"text":"80 EM and 35% Charged Attack DMG directly strengthen his main damage source. Excellent general-purpose choice.","stats":"EM/ATK% · Dendro DMG · CRIT"},{"names":["Gilded Dreams"],"text":"Grants EM and/or ATK after reactions.","stats":"EM/ATK% · Dendro DMG · CRIT"},{"names":["Deepwood Memories"],"text":"Reduces enemy Dendro RES by 30%.","stats":"EM/ATK% · Dendro DMG · CRIT"}],"t":[{"name":"Forest of Thunder","members":["Tighnari","Nahida","Yae Miko","Zhongli"],"text":"Nahida supplies EM and Deepwood shred, Yae maintains Quicken, and Zhongli shields Tighnari during aimed shots.","roles":["Main DPS","Dendro Support","Off-Field DPS","Shield"]},{"name":"Foxfire Circuit","members":["Tighnari","Yae Miko","Fischl","Baizhu"],"text":"Double Electro maintains Quicken, while Baizhu heals, protects, and can hold Deepwood to boost Tighnari’s Spread damage.","roles":["Main DPS","Off-Field DPS","Off-Field DPS","Healer"]},{"name":"Greenhouse Effect","members":["Tighnari","Nahida","Fischl","Kuki Shinobu"],"text":"Nahida shares EM and shreds Dendro RES, Fischl applies Electro, and Kuki adds healing and Quicken uptime.","roles":["Main DPS","Dendro Support","Off-Field DPS","Healer"]},{"name":"Budget Botanists","members":["Tighnari","Traveler (Dendro)","Fischl","Kuki Shinobu"],"text":"Dendro Traveler can carry Deepwood; Fischl and Kuki sustain Quicken, provide Electro damage, and keep the team comfortable.","roles":["Main DPS","Dendro Support","Off-Field DPS","Healer"]}],"v":"Hunter’s Path: Prioritize an EM Sands; its Charged Attack buff scales with Elemental Mastery.\nNo Deepwood Holder: Equip 4-piece Deepwood Memories if nobody else provides the essential Dendro RES reduction.\nF2P: Use R5 Slingshot near enemies, Wanderer’s Troupe, and a reliable Electro teammate for Spread.\nBurst Frequency: Two Skills per Burst needs little ER; one Skill per Burst can need much more, especially without a second Dendro.","n":3},"seo":{"roles":["Main DPS"],"about":"Tighnari is a quick-swap Dendro DPS who excels in Spread teams. His Skill greatly shortens the charge time of his next three Wreath Arrows, while his Burst adds fast Dendro damage. Rotate through Skill, three Charged Attacks, and Burst, then swap to Electro teammates to maintain Quicken.","pros":["Fast Charged Attacks","Strong Spread damage","Flexible rotations","Excellent F2P bow"],"cons":["Needs Electro uptime","Mostly single-target","Weak without Quicken","Limited off-field damage"],"weapons":["Hunter's Path","Aqua Simulacra","Polar Star","The First Great Magic","Skyward Harp","Elegy for the End","Slingshot","Song of Stillness"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs","role":"Best"},{"sets":["Gilded Dreams"],"pcs":"4 pcs","role":""},{"sets":["Deepwood Memories"],"pcs":"4 pcs","role":""}],"main":["Elemental Mastery / ATK%","Dendro DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["CRIT Rate: 60% - 75%","CRIT DMG: 130% - 200%+","Elemental Mastery: 250 - 450+","Energy Recharge: 100% - 140% (Team-dependent)","ER: 150% - 160% (Solo Dendro, Burst each Skill)"],"vars":[{"title":"Hunter’s Path Spread","role":"Quick-Swap DPS","weapons":["Hunter's Path","Aqua Simulacra"],"arts":[{"sets":["Gilded Dreams"],"pcs":"4 pcs"},{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"}],"stats":"EM Sands strongly preferred; prioritize CRIT and EM after meeting ER needs.","teams":"Keep Quicken active with an Electro teammate; another character should hold Deepwood.","when":"Choose when using his signature bow to maximize EM-based Charged Attack damage.","cond":"Hunter’s Path equipped","notes":"Gilded Dreams can slightly outperform Wanderer’s Troupe with Hunter’s Path.","pre":false},{"title":"Solo Deepwood Carrier","role":"Quick-Swap DPS","weapons":["Hunter's Path","Slingshot"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"}],"stats":"Keep normal EM/ATK%, Dendro DMG, CRIT stats; set bonus replaces a stronger personal damage set.","teams":"No other reliable Deepwood Memories user.","when":"Use when Tighnari must provide the 30% Dendro RES shred himself.","cond":"No other teammate using 4-piece Deepwood","notes":"","pre":false},{"title":"F2P Spread","role":"Quick-Swap DPS","weapons":["Slingshot","Song of Stillness"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Deepwood Memories"],"pcs":"4 pcs"}],"stats":"Aim for 60–75% CRIT Rate, solid CRIT DMG and roughly 250–450+ EM; adjust for weapon.","teams":"Fischl or another consistent Electro applier; healer needed for Song of Stillness.","when":"Affordable Spread setup built around R5 Slingshot and accessible teammates.","cond":"Slingshot passive needs close-range hits","notes":"Slingshot is a 3-star weapon and can beat many 4-star alternatives.","pre":false},{"title":"Flexible Burst Rotation","role":"Quick-Swap DPS","weapons":["Skyward Harp","Elegy for the End"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Around 100–110% ER for two Skills per Burst; ~130–160% may be needed for one Skill per Burst.","teams":"Maintain Quicken and choose the rotation that fits team energy generation.","when":"Trade frequent Bursts for stronger offensive stats in flexible 12-second quick-swap cycles.","cond":"ER depends strongly on particles and Favonius procs","notes":"","pre":false}],"mats":["Nagadus Emerald Sliver","Nagadus Emerald Fragment","Nagadus Emerald Chunk","Nagadus Emerald Gemstone","Majestic Hooked Beak","Teachings of Admonition","Guide to Admonition","Philosophies of Admonition","Fungal Spores","Luminescent Pollen","Crystalline Cyst Dust","Nilotpala Lotus","The Meaning of Aeons","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 8-9"},{"name":"Elemental Skill","pri":"Level 6-8"},{"name":"Elemental Burst","pri":"Level 8-9+"}],"teams":[{"name":"Forest of Thunder","members":["Tighnari","Nahida","Yae Miko","Zhongli"]},{"name":"Foxfire Circuit","members":["Tighnari","Yae Miko","Fischl","Baizhu"]},{"name":"Greenhouse Effect","members":["Tighnari","Nahida","Fischl","Kuki Shinobu"]},{"name":"Budget Botanists","members":["Tighnari","Traveler (Dendro)","Fischl","Kuki Shinobu"]}]}}],"title":"Tighnari","el":"Dendro"}