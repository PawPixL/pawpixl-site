0.0296]},{"n":"Fischl","r":[0.1704,0.6096,0.037,0.0296]},{"n":"Xingqiu","r":[0.2148,0.6096,0.037,0.0296]},{"n":"Xiao","r":[0.1259,0.663,0.037,0.0296]},{"n":"Zhongli","r":[0.1704,0.663,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.663,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/traveleranemo/261111-225304/en-1.t.webp","why":{"w":[{"name":"Freedom-Sworn","text":"EM improves Swirl; reaction triggers can buff ally ATK and attack damage. Needs reliable reaction triggers; premium team buff."},{"name":"Primordial Jade Cutter","text":"High CRIT Rate boosts Anemo Skill and Burst damage in hybrid builds. Best when energy and CRIT balance are covered."},{"name":"Mistsplitter Reforged","text":"Strong CRIT DMG and elemental damage; some stacks are hard to maintain. Personal damage build, not pure EM Swirl."},{"name":"Skyward Blade","text":"Energy Recharge helps Burst uptime; extra passive damage needs on-field hits. ER-focused hybrid build."},{"name":"Favonius Sword","text":"CRIT hits generate neutral particles, helping Traveler and teammates. Build enough CRIT Rate to trigger passive. Refinements improve consistency."},{"name":"Sacrificial Sword","text":"Skill cooldown reset adds Anemo particles and another chance to Swirl. Cooldown reset must trigger. Higher refinements preferred."},{"name":"Xiphos' Moonlight","text":"EM supports Swirl while passive converts EM into team Energy Recharge. EM-focused support; gacha-limited."},{"name":"Iron Sting","text":"Craftable EM option that strengthens Swirl; passive also adds personal damage. Accessible EM support."}],"a":[{"names":["Viridescent Venerer"],"text":"Swirl reduces enemy resistance to the Swirled element by 40%.","stats":"EM / ER · EM · EM"},{"names":["Noblesse Oblige"],"text":"Burst grants party ATK; use only when no teammate already equips Noblesse.","stats":"ER / ATK% · Anemo DMG · CRIT"},{"names":["Viridescent Venerer","Gladiator's Finale"],"text":"Temporary damage mix; weaker team utility than 4pc Viridescent Venerer.","stats":"ATK% / ER · Anemo DMG · CRIT"}],"t":[{"name":"Childe Vaporize","members":["Traveler (Anemo)","Tartaglia","Xiangling","Bennett"],"text":"Traveler Swirls Hydro or Pyro for VV shred, while Tartaglia enables Xiangling Vaporize. Position the tornado carefully to avoid scattering small enemies.","roles":["Support / Debuffer","On-field DPS / Hydro Enabler","Off-field DPS / Pyro Enabler","Healer / Buffer"]},{"name":"Frostwind Freeze","members":["Traveler (Anemo)","Kamisato Ayaka","Sangonomiya Kokomi","Rosaria"],"text":"Traveler shreds Cryo resistance and helps group lighter foes. Kokomi sustains Freeze, while Rosaria supplies Cryo energy and damage.","roles":["Support / Debuffer","On-field DPS","Healer / Hydro Enabler","Off-field DPS / CRIT Buffer"]},{"name":"Rainstorm Taser","members":["Traveler (Anemo)","Beidou","Fischl","Xingqiu"],"text":"Traveler Swirls Electro or Hydro to reduce resistance as Beidou, Fischl, and Xingqiu deal off-field damage. Defensive utility comes from their kits.","roles":["Support / Debuffer","Off-field DPS","Off-field DPS / Battery","Off-field DPS / Hydro Enabler"]},{"name":"Windswept Xiao","members":["Traveler (Anemo)","Xiao","Zhongli","Bennett"],"text":"Traveler provides Anemo particles and C6 Anemo RES shred for Xiao; Zhongli protects him and Bennett boosts damage. Burst can displace light enemies.","roles":["Support / Debuffer","On-field DPS","Shielder / Debuffer","Healer / Buffer"]}],"v":"EM Swirl Support: 4pc Viridescent; EM/EM/EM after meeting ER needs. Swirl an enemy element to reduce its RES.\nHybrid Quickswap: 4pc Viridescent; ATK or ER/Anemo/CRIT for personal Skill and Burst damage.\nC6 Xiao Battery: Favonius or Sacrificial Sword; use Skill for particles and Burst for Anemo RES shred.\nNoblesse Buffer: 4pc Noblesse only if no ally wears it and Burst uptime is dependable.\nBudget Support: Craft Iron Sting, build enough ER, then stack EM on 4pc Viridescent.","n":3},"seo":{"roles":["Support / Sub DPS"],"about":"Anemo Traveler is a flexible quickswap support who uses Palm Vortex and Gust Surge to trigger Swirl and reduce enemy resistance with Viridescent Venerer. Their C6 adds resistance reduction to Burst-affected enemies. The traveling tornado can push small foes away, so positioning matters.","pros":["Free C6 constellations","Useful VV RES shred","Flexible quickswap support","Skill generates Anemo energy"],"cons":["Burst carries small enemies away","Weak against immovable bosses","Limited grouping control","Needs ER for Burst uptime"],"weapons":["Freedom-Sworn","Primordial Jade Cutter","Mistsplitter Reforged","Skyward Blade","Favonius Sword","Sacrificial Sword","Xiphos' Moonlight","Iron Sting"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs","role":"Best"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""},{"sets":["Viridescent Venerer","Gladiator's Finale"],"pcs":"2 + 2 pcs","role":""}],"main":["Elemental Mastery / Energy Recharge","Elemental Mastery","Elemental Mastery"],"stats":["ER: 160% - 180%","EM: 600 - 900","Fav CR: 35% - 55%"],"vars":[{"title":"Hybrid Quickswap Damage","role":"Sub DPS","weapons":["Primordial Jade Cutter","Mistsplitter Reforged","Skyward Blade","Sacrificial Sword"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer","Gladiator's Finale"],"pcs":"2 + 2 pcs"}],"stats":"ATK% or ER Sands, Anemo DMG Goblet, CRIT Circlet; balance CRIT and ATK after meeting ER.","teams":"An allied Pyro, Hydro, Electro, or Cryo applier allows Swirl.","when":"Use for more personal Skill/Burst damage when already meeting energy needs. Four-piece VV still benefits the team most.","cond":"Best in teams with regular swaps.","notes":"Physical Normal Attack builds remain a low-damage novelty; this variant is Anemo-focused.","pre":false},{"title":"C6 Xiao Anemo Battery","role":"Support","weapons":["Favonius Sword","Sacrificial Sword","Freedom-Sworn"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"Prioritize reliable Skill particles and enough ER for Burst; build CRIT Rate with Favonius.","teams":"Requires Xiao as main carry; C6 Traveler for Anemo RES shred.","when":"Support Xiao with Anemo particles and Burst-based Anemo resistance reduction. Noblesse can buff ATK when no teammate already carries it.","cond":"C6 needed for extra Anemo RES shred.","notes":"Anemo RES shred from C6 works on Burst-hit targets. Avoid letting the tornado drag enemies beyond Xiao reach.","pre":false},{"title":"Noblesse Team Buffer","role":"Support","weapons":["Favonius Sword","Sacrificial Sword","Skyward Blade"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"ER first; optional ATK/Anemo/CRIT stats for personal damage.","teams":"No other Noblesse holder; consistent Burst access.","when":"Choose Noblesse for an ATK-scaling Anemo, Geo, or Dendro carry when VV elemental shred is less useful.","cond":"Team-specific; Noblesse buffs do not stack.","notes":"Noblesse requires Burst activation; positioning remains important.","pre":false},{"title":"Accessible EM Swirl","role":"Support","weapons":["Iron Sting","Favonius Sword","Sacrificial Sword"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"Use ER Sands until Burst is consistent; otherwise aim for EM main stats.","teams":"Bring at least one Swirlable Pyro, Hydro, Electro, or Cryo source.","when":"A budget-friendly way to provide VV shred and Swirl damage. The craftable sword works well if ER is already covered.","cond":"Level 90 increases Swirl damage.","notes":"Iron Sting is craftable; Favonius/Sacrificial are gacha alternatives. Prioritize energy before extra EM.","pre":false}],"mats":["Brilliant Diamond Sliver","Brilliant Diamond Fragment","Brilliant Diamond Chunk","Brilliant Diamond Gemstone","","Teachings of Freedom","Guide to Freedom","Philosophies of Resistance","Divining Scroll","Sealed Scroll","Sealed Scroll","Windwheel Aster","Dvalin's Sigh","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 8-9"},{"name":"Elemental Burst","pri":"Level 8-9"}],"teams":[{"name":"Childe Vaporize","members":["Traveler (Anemo)","Tartaglia","Xiangling","Bennett"]},{"name":"Frostwind Freeze","members":["Traveler (Anemo)","Kamisato Ayaka","Sangonomiya Kokomi","Rosaria"]},{"name":"Rainstorm Taser","members":["Traveler (Anemo)","Beidou","Fischl","Xingqiu"]},{"name":"Windswept Xiao","members":["Traveler (Anemo)","Xiao","Zhongli","Bennett"]}]}}],"title":"Traveler (Anemo)","el":"Anemo"}