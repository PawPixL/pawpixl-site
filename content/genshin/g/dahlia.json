content/genshin/builds/dahlia/261111-224858/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Favonius Sword","r":[0.1093,0.2552,0.0472,0.0378],"k":"w"},{"n":"Key of Khaj-Nisut","r":[0.1093,0.3307,0.0472,0.0378],"k":"w"},{"n":"Noblesse Oblige","r":[0.5231,0.2552,0.0472,0.0378],"k":"a"},{"n":"Scroll of the Hero of Cinder City","r":[0.5231,0.3307,0.0472,0.0378],"k":"a"},{"n":"Tenacity of the Millelith","r":[0.5231,0.4137,0.0472,0.0378],"k":"a"},{"n":"Vourukasha's Glow","r":[0.5759,0.4137,0.0472,0.0378],"k":"a"},{"n":"Dahlia","r":[0.0815,0.5385,0.037,0.0296]},{"n":"Skirk","r":[0.1259,0.5385,0.037,0.0296]},{"n":"Furina","r":[0.1704,0.5385,0.037,0.0296]},{"n":"Escoffier","r":[0.2148,0.5385,0.037,0.0296]},{"n":"Dahlia","r":[0.0815,0.5926,0.037,0.0296]},{"n":"Wanderer","r":[0.1259,0.5926,0.037,0.0296]},{"n":"Faruzan","r":[0.1704,0.5926,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.5926,0.037,0.0296]},{"n":"Dahlia","r":[0.0815,0.6467,0.037,0.0296]},{"n":"Kamisato Ayato","r":[0.1259,0.6467,0.037,0.0296]},{"n":"Furina","r":[0.1704,0.6467,0.037,0.0296]},{"n":"Xilonen","r":[0.2148,0.6467,0.037,0.0296]},{"n":"Dahlia","r":[0.0815,0.7007,0.037,0.0296]},{"n":"Yoimiya","r":[0.1259,0.7007,0.037,0.0296]},{"n":"Yelan","r":[0.1704,0.7007,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.7007,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/dahlia/261111-224858/en-1.t.webp","why":{"w":[{"name":"Favonius Sword","text":"ER and neutral particles help fund Dahlia’s costly Burst and recharge teammates. Build CRIT Rate to trigger its passive. Requires on-field CRIT hits to generate particles."},{"name":"Key of Khaj-Nisut","text":"Massive HP boosts his shield and helps reach the 40,000 HP cap for his A4 ATK SPD buff. Only after meeting his Burst ER requirement."},{"name":"Freedom-Sworn","text":"Can buff team ATK and Normal, Charged."},{"name":"Skyward Blade","text":"55.1% ER helps maintain Burst uptime."},{"name":"Peak Patrol Song","text":"Provides team Elemental DMG buffs when its conditions are met; competes with Dahlia’s preferred HP and ER stats. Only when team buffs outweigh lower HP and tougher ER needs."},{"name":"Sacrificial Sword","text":"Energy Recharge and a chance for another Skill improve particles and reduce Burst pressure. Passive needs to trigger; extra Skill costs field time."},{"name":"The Dockhand's Assistant","text":"HP% strengthens the shield and increases his HP-scaling Attack Speed buff. Meet ER needs first; weapon passive is secondary."},{"name":"Skyrider Sword","text":"Accessible Energy Recharge stat stick until better swords are available. Temporary F2P option; passive offers little support value."}],"a":[{"names":["Noblesse Oblige"],"text":"Reliable team ATK buff when Dahlia uses Burst every rotation. Avoid duplicating with another Noblesse holder.","stats":"ER/HP% · HP% · HP%/CRIT Rate"},{"names":["Scroll of the Hero of Cinder City"],"text":"Provides a modest reaction-based Elemental DMG buff without Nightsoul; useful for non-ATK scalers or if Noblesse is taken.","stats":"ER/HP% · HP% · HP%/CRIT Rate"},{"names":["Tenacity of the Millelith","Vourukasha's Glow"],"text":"Two HP% bonuses help reach 40,000 HP when Burst uptime is already covered; lacks a team-wide set buff.","stats":"ER/HP% · HP% · HP%/CRIT Rate"}],"t":[{"name":"Frostbound Encore","members":["Dahlia","Skirk","Furina","Escoffier"],"text":"Dahlia shields and speeds up Skirk’s Normal Attacks; Furina buffs DMG and Escoffier heals.","roles":["Shield Support","Main DPS","Sub DPS","Healer"]},{"name":"Windborne Chorus","members":["Dahlia","Wanderer","Faruzan","Bennett"],"text":"Faruzan buffs Wanderer, Bennett supplies ATK and healing.","roles":["Shield Support","Main DPS","Anemo Buffer","ATK Buffer"]},{"name":"Suprise Baptism","members":["Dahlia","Kamisato Ayato","Furina","Xilonen"],"text":"Ayato uses Dahlia’s shield and Attack Speed.","roles":["Shield Support","Main DPS","Sub DPS","Support"]},{"name":"Summer Serenade","members":["Dahlia","Yoimiya","Yelan","Bennett"],"text":"Yoimiya appreciates Dahlia’s shield and Normal Attack Speed.","roles":["Shield Support","Main DPS","Sub DPS","ATK Buffer"]}],"v":"HP Shield Focus: With ER already met, prioritize 40,000 HP for maximum A4 Attack Speed and stronger shielding.\nElemental Buff: Use 4pc Scroll for non-ATK carries or when Noblesse is taken; without Nightsoul.\nC1 Energy Saver: C1 refunds Energy through Benison stacks, lowering ER needs.\nFavonius Battery: Favonius Sword with sufficient CR helps generate team particles. Use Normal Attacks if Skill/Burst do not proc it.","n":2},"seo":{"roles":["Shield Support / Buffer"],"about":"Dahlia shields the active character with his Burst and boosts their Normal Attack Speed based on his HP, up to 20% at 40,000 HP (30% at C6). His shield can refresh with Benison stacks, but he needs substantial Energy Recharge to Burst reliably. Best with Normal Attack-focused carries.","pros":["Up to 30% ATK SPD at C6","Refreshable Burst shield","Favonius energy utility","Supports Normal Attack carries"],"cons":["Very high ER at C0","Limited off-field Hydro","Shield can break early","Little personal damage"],"weapons":["Favonius Sword","Key of Khaj-Nisut","Freedom-Sworn","Skyward Blade","Peak Patrol Song","Sacrificial Sword","The Dockhand's Assistant","Skyrider Sword"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""},{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs","role":""},{"sets":["Tenacity of the Millelith","Vourukasha's Glow"],"pcs":"2 + 2 pcs","role":""}],"main":["Energy Recharge / HP%","HP%","HP% / CRIT Rate (Favonius)"],"stats":["HP: up to 40,000 for full A4 buff","ER solo Hydro C0: 240% - 270% (1 Skill)","ER double Hydro C0: 170% - 230%","ER double Hydro C1: 140% - 165% (1 Skill)","CRIT Rate (Favonius): 40% - 60%+"],"vars":[{"title":"HP Shield Focus","role":"Shield Support","weapons":["Key of Khaj-Nisut","The Dockhand's Assistant","Favonius Sword"],"arts":[{"sets":["Tenacity of the Millelith","Vourukasha's Glow"],"pcs":"2 + 2 pcs"}],"stats":"Prioritize HP% to approach 40,000 HP after meeting rotation ER. HP% circlet; ER Sands if necessary.","teams":"Best when party weapons/particles already cover Dahlia’s high ER needs.","when":"When more shield strength and maximum A4 Attack Speed matter more than the 4pc Noblesse team ATK buff.","cond":"Burst must remain available every rotation.","notes":"Dahlia’s A4 caps at 20% Attack Speed from 40,000 HP.","pre":false},{"title":"Elemental Damage Support","role":"Support","weapons":["Favonius Sword","Skyward Blade","Freedom-Sworn"],"arts":[{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs"}],"stats":"Same ER and HP priorities; use CRIT Rate circlet for Favonius as needed.","teams":"Teams benefiting from Elemental DMG rather than ATK, or where another teammate carries Noblesse.","when":"A useful alternative for non-ATK-scaling carries or when 4pc Noblesse would duplicate another teammate.","cond":"Dahlia must trigger an appropriate elemental reaction.","notes":"Without Nightsoul, Dahlia receives only Scroll’s smaller reaction-based bonus, not the full enhanced buff.","pre":false},{"title":"C1 Double-Hydro Battery","role":"Shield Support","weapons":["Favonius Sword","Sacrificial Sword","Skyward Blade"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER can drop to roughly 140–165% with C1, double Hydro and one Skill, depending on actual Benison stacks.","teams":"Two Hydro characters; sufficient Benison generation; reliable rotations.","when":"At C1+, use energy refunds to invest additional substats into HP and improve the ATK SPD buff.","cond":"C1 and consistent Benison stacks.","notes":"Two Skills or Favonius procs can lower ER further; verify the team’s actual particle generation.","pre":false}],"mats":["Varunada Lazurite Sliver","Varunada Lazurite Fragment","Varunada Lazurite Chunk","Varunada Lazurite Gemstone","Secret Source Airflow Accumulator","Teachings of Ballad","Guide to Ballad","Philosophies of Ballad","Firm Arrowhead","