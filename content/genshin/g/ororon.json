]},{"n":"Ororon","r":[0.0815,0.8511,0.037,0.0296]},{"n":"Barbara","r":[0.1259,0.8511,0.037,0.0296]},{"n":"Fischl","r":[0.1704,0.8511,0.037,0.0296]},{"n":"Sucrose","r":[0.2148,0.8511,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/ororon/261111-225210/en-1.t.webp","why":{"w":[{"name":"Elegy for the End","text":"Excellent teamwide ATK and EM buffs with helpful ER."},{"name":"Polar Star","text":"High CR and ATK help Ororon’s passive DMG."},{"name":"Aqua Simulacra","text":"Large CRIT DMG and a general damage bonus strengthen Hypersense. Stay near enemies to activate its passive."},{"name":"Skyward Harp","text":"Strong CRIT Rate, CRIT DMG, and Base ATK improve Ororon’s off-field damage without restrictive team conditions."},{"name":"Alley Hunter","text":"ATK and off-field damage bonuses work well with Hypersense. Builds stacks while Ororon stays off the field. More competitive at R5."},{"name":"Favonius Warbow","text":"Great team battery that lowers Energy needs. Trade some personal damage for smoother Bursts. Build enough CRIT Rate to activate its passive."},{"name":"Chain Breaker","text":"Excellent craftable bow. Its ATK buff supports Hypersense, with extra EM for reactions. R5 is a strong F2P goal."},{"name":"Fading Twilight","text":"Free event bow with ER and a rotating damage bonus. A comfortable option if you already own it."}],"a":[{"names":["Scroll of the Hero of Cinder City"],"text":"Best general support set.","stats":"ATK% or ER / Electro DMG / CRIT"},{"names":["Noblesse Oblige"],"text":"Use when another teammate already carries Scroll and the team benefits from an ATK buff after Burst.","stats":"ATK% or ER / Electro DMG / CRIT"},{"names":["Instructor"],"text":"Budget team EM support if Scroll is already covered. Requires on-field reaction activation and lowers personal damage.","stats":"ER or ATK% / Electro DMG / CRIT"}],"t":[{"name":"Midnight Tides","members":["Ororon","Neuvillette","Furina","Kaedehara Kazuha"],"text":"Neuvillette and Furina enable Electro-Charged. Ororon buffs Hydro and Electro with Scroll while Kazuha groups foes and shreds resistance.","roles":["Off-field DPS / Battery","On-field DPS","Off-field DPS / Buffer","Buffer / Debuffer"]},{"name":"Moonlit Circuit","members":["Ororon","Columbina","Ifa","Ineffa"],"text":"Columbina and Ineffa enable Lunar-Charged, while Ifa drives reactions and heals. Ororon adds Electro damage and Scroll buffs.","roles":["Off-field DPS / Battery","Off-field DPS / Buffer","On-field Driver","Off-field DPS / Shielder"]},{"name":"Overload Harvest","members":["Ororon","Mavuika","Chevreuse","Iansan"],"text":"Mavuika and Iansan provide Pyro and ATK support. Ororon adds Electro and Nightsoul utility, while Chevreuse boosts Overload teams.","roles":["Off-field DPS / Battery","Off-field DPS / Pyro Enabler","Healer / Buffer","ATK Buffer"]},{"name":"Budget Night Shift","members":["Ororon","Barbara","Fischl","Sucrose"],"text":"Barbara drives Electro-Charged and heals. Fischl adds off-field Electro, Sucrose groups and shreds resistance, and Ororon buffs both elements.","roles":["Off-field DPS / Battery","Healer","Off-field DPS / Battery","EM Buffer / Debuffer"]}],"v":"Electro-Charged DPS: Use 4-piece Scroll, ATK% Sands, Electro goblet and CRIT circlet. Build enough ER for regular Burst use.\nFavonius Battery: Choose Favonius Warbow and prioritize CRIT Rate. Trade personal damage for smoother team rotations.\nLunar-Charged: Pair him with reliable Lunar-Charged enablers. Keep CRIT and ER high, with EM as a useful secondary stat.\nOverload Support: Chevreuse teams can use Scroll buffs and Electro application. Full EM is situational when Ororon owns many Overloaded reactions.\nDouble Electro: With Fischl or another Electro teammate, his ER needs often drop substantially. Shift those rolls toward CRIT and ATK.","n":3},"seo":{"roles":["Sub DPS / Support"],"about":"Ororon is an off-field Electro damage dealer and team buffer who excels in Electro-Charged and Nightsoul teams. His Hypersense passive deals much of his damage, while Scroll of the Hero of Cinder City buffs teammates. He wants reliable Hydro or Nightsoul damage to trigger his passive.","pros":["Strong off-field damage","40% elemental team buff","Excellent Electro-Charged","Helps team Energy","Useful Burst taunt"],"cons":["Needs specific team triggers","Burst can miss mobile foes","ER varies by team","Limited single-target DMG","Long cooldowns"],"weapons":["Elegy for the End","Polar Star","Aqua Simulacra","Skyward Harp","Alley Hunter","Favonius Warbow","Chain Breaker","Fading Twilight"],"arts":[{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs","role":""},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""},{"sets":["Instructor"],"pcs":"4 pcs","role":""}],"main":["ATK% / ER","Electro DMG / ATK%","CRIT Rate / CRIT DMG"],"stats":["ER: 160–195% solo Electro","ER: 100–120% double Electro","ER: 130–145% with Neuvillette","CRIT Rate: 60–70%","CRIT DMG: 120–160%+"],"vars":[{"title":"Electro-Charged Buffer","role":"Off-field DPS / Support","weapons":["Elegy for the End","Favonius Warbow"],"arts":[{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs"}],"stats":"ER for Burst uptime and CRIT for personal damage.","teams":"Hydro application; consistent Electro-Charged.","when":"Scroll buffs the carry while Ororon contributes off-field Electro.","cond":"Use qualifying elemental reactions for Scroll.","notes":"","pre":false},{"title":"Favonius Battery","role":"Support","weapons":["Favonius Warbow","Alley Hunter"],"arts":[{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Raise CRIT Rate enough to trigger Favonius; meet ER needs.","teams":"Energy-hungry team that can use his particles.","when":"Trade personal damage for more reliable team Energy.","cond":"Favonius must land CRIT hits while Ororon is on-field.","notes":"","pre":false}],"mats":["Vajrada Amethyst Sliver","Vajrada Amethyst Fragment","Vajrada Amethyst Chunk","Vajrada Amethyst Gemstone","Mark of the Binding Blessing","Teachings of Kindling","Guide to Kindling","Philosophies of Kindling","Juvenile Fang","Seasoned Fang","Tyrant's Fang","Glowing Hornshroom","Lightless Silk String","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 6–8"},{"name":"Elemental Burst","pri":"Level 8–9"}],"teams":[{"name":"Midnight Tides","members":["Ororon","Neuvillette","Furina","Kaedehara Kazuha"]},{"name":"Moonlit Circuit","members":["Ororon","Columbina","Ifa","Ineffa"]},{"name":"Overload Harvest","members":["Ororon","Mavuika","Chevreuse","Iansan"]},{"name":"Budget Night Shift","members":["Ororon","Barbara","Fischl","Sucrose"]}]}}],"title":"Ororon","el":"Electro"}