ling","r":[0.2148,0.5081,0.037,0.0296]},{"n":"Aloy","r":[0.0815,0.5615,0.037,0.0296]},{"n":"Kamisato Ayaka","r":[0.1259,0.5615,0.037,0.0296]},{"n":"Sangonomiya Kokomi","r":[0.1704,0.5615,0.037,0.0296]},{"n":"Kaedehara Kazuha","r":[0.2148,0.5615,0.037,0.0296]},{"n":"Aloy","r":[0.0815,0.6148,0.037,0.0296]},{"n":"Shenhe","r":[0.1259,0.6148,0.037,0.0296]},{"n":"Kamisato Ayaka","r":[0.1704,0.6148,0.037,0.0296]},{"n":"Jean","r":[0.2148,0.6148,0.037,0.0296]},{"n":"Aloy","r":[0.0815,0.6756,0.037,0.0296]},{"n":"Bennett","r":[0.1259,0.6756,0.037,0.0296]},{"n":"Xiangling","r":[0.1704,0.6756,0.037,0.0296]},{"n":"Sucrose","r":[0.2148,0.6756,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/aloy/261111-224739/en-1.t.webp","why":{"w":[{"name":"Polar Star","text":"CRIT and ATK boost Skill/Burst. Best with attack stack setup."},{"name":"Skyward Harp","text":"High base ATK and double CRIT stats."},{"name":"Elegy for the End","text":"ER and occasional team ATK/EM buffs. Buff may take multiple rotations."},{"name":"Sacrificial Bow","text":"Extra Skill for particles and damage. Strong at high refinements. R4+ preferred."},{"name":"Favonius Warbow","text":"Team particles and abundant ER. Needs enough CRIT Rate."},{"name":"The Stringless","text":"EM boosts Melt; buffs Skill/Burst. Best for Reverse Melt."},{"name":"Prototype Crescent","text":"ATK bonus after weak-point hits. Requires accessible weak points."},{"name":"Song of Stillness","text":"DMG bonus after healing. Needs a healer to trigger passive."}],"a":[{"names":["Noblesse Oblige"],"text":"Burst gives team +20% ATK.","stats":"ER/ATK% · Cryo · CRIT"},{"names":["Emblem of Severed Fate"],"text":"ER converts into Burst damage.","stats":"ER/EM/ATK · Cryo · CRIT"},{"names":["Blizzard Strayer"],"text":"High CRIT in Freeze teams.","stats":"ATK% · Cryo · CRIT DMG"}],"t":[{"name":"Dawnfire Detonation","members":["Aloy","Bennett","Kaedehara Kazuha","Xiangling"],"text":"Bennett buffs; Xiangling maintains Pyro; Kazuha groups Bomblets and shreds RES so Aloy can Reverse Melt.","roles":["Burst DPS","Healer/Buffer","Anemo Support","Pyro Sub DPS"]},{"name":"Frozen Horizon","members":["Aloy","Kamisato Ayaka","Sangonomiya Kokomi","Kaedehara Kazuha"],"text":"Aloy batteries Ayaka and adds Burst damage; Kokomi maintains Freeze while Kazuha groups and shreds Cryo RES.","roles":["Burst DPS / Battery","On-field DPS","Healer / Hydro Enabler","Buffer / Debuffer"]},{"name":"Glacial Dawn","members":["Aloy","Shenhe","Kamisato Ayaka","Jean"],"text":"Mono Cryo quickswap: Shenhe boosts Cryo damage, Aloy supplies particles, Ayaka deals damage, and Jean heals and shreds RES.","roles":["Burst DPS / Battery","Cryo Buffer","On-field DPS","Healer / Debuffer"]},{"name":"Where have all the good cons gone? ","members":["Aloy","Bennett","Xiangling","Sucrose"],"text":"Accessible Reverse Melt core: Bennett and Xiangling apply Pyro while Sucrose shares EM and groups Bomblets.","roles":["Burst DPS / Battery","Healer/Buffer","Pyro Sub DPS","Anemo Support"]}],"v":"Reverse Melt: EM/ATK or ER sands; The Stringless or Polar Star with Emblem. Ensure Pyro aura before Aloy Burst.\nFreeze Quickswap: Blizzard Strayer and Cryo resonance boost CRIT; avoid stacking too much CRIT Rate.\nCryo Battery: Sacrificial or Favonius Bow; funnel Skill particles to your Cryo carry and use Noblesse for team ATK.\nOn-field Rushing Ice: 4 Coil stacks unlock Cryo-infused Normals; pair Anemo Bomblet grouping with a Freeze team. Inconsistent.\nF2P Burst: Prototype Crescent needs headshots; Song of Stillness needs healing. Prioritize Burst and sufficient ER.","n":4},"seo":{"roles":["Sub DPS / Support"],"about":"Aloy is a quickswap Cryo Burst DPS and battery whose Skill produces Cryo particles and whose 40-Energy Burst can Melt for a strong hit. Her 4 Coil stacks unlock Cryo-infused attacks, but inconsistent Bomblet hits make on-field play situational.","pros":["Low-cost Cryo Burst","Strong Melt burst potential","Generates Cryo particles","Supports Freeze teams"],"cons":["Unreliable Coil stacks","Long Skill cooldown","No constellations","Limited sustained damage"],"weapons":["Polar Star","Skyward Harp","Elegy for the End","Sacrificial Bow","Favonius Warbow","The Stringless","Prototype Crescent","Song of Stillness"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":""},{"sets":["Blizzard Strayer"],"pcs":"4 pcs","role":""}],"main":["ATK% / Energy Recharge / EM (Melt)","Cryo DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["Solo ER: 140-165%","Duo ER: 100-125%","CR: 55-70%","CD: 110-160%","EM Melt: 100-250"],"vars":[{"title":"Reverse Melt Burst DPS","role":"Quickswap DPS","weapons":["Polar Star","The Stringless","Sacrificial Bow"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM/ATK% or ER sands, Cryo goblet, CRIT circlet. Balance EM with enough ER.","teams":"Needs Bennett plus sustained Pyro and preferably Anemo grouping.","when":"Set up Pyro aura and buffs, then Melt Aloy Skill and Burst. The Burst is a single powerful Cryo hit.","cond":"","notes":"","pre":false},{"title":"Freeze Quickswap DPS","role":"Cryo Sub DPS","weapons":["Skyward Harp","Polar Star","Favonius Warbow"],"arts":[{"sets":["Blizzard Strayer"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ATK% sands; Cryo goblet; favor CRIT DMG due to Freeze/Blizzard CRIT Rate.","teams":"Hydro applier, Cryo teammate, and preferably Anemo RES shred.","when":"Use Aloy for Cryo particles and a short Burst window while your Cryo carry handles field time.","cond":"","notes":"","pre":false},{"title":"Cryo Battery / Team Buffer","role":"Support","weapons":["Sacrificial Bow","Favonius Warbow","Elegy for the End"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"ER first; CRIT Rate for Favonius. Personal DPS is secondary.","teams":"A Cryo carry who benefits from particles and team buffs.","when":"Cast Skill for five Cryo particles, swap to the carry to catch particles, and Burst to refresh Noblesse.","cond":"Noblesse only if no teammate already carries it.","notes":"","pre":false},{"title":"Rushing Ice On-Field","role":"On-field Cryo DPS","weapons":["Thundering Pulse","Polar Star","Skyward Harp"],"arts":[{"sets":["Blizzard Strayer"],"pcs":"4 pcs"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"ATK%/Cryo/CRIT DMG; less CRIT Rate with Freeze. Normal Attack becomes a high-priority talent.","teams":"Anemo Bomblet grouping, Hydro for Freeze, and preferably another Cryo unit.","when":"Get 4 Coil stacks from spaced Bomblet hits to unlock 10s Cryo Normal Attacks. This setup is inconsistent.","cond":"Coil stack acquisition has a 0.1s interval.","notes":"Marechaussee Hunter requires Furina HP fluctuation.","pre":false},{"title":"Accessible Melt Burst","role":"Quickswap DPS","weapons":["Prototype Crescent","Song of Stillness","The Stringless"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER to requirement; ATK% or EM sands depending on Pyro/Bennett buffs.","teams":"Pyro application; weak-point target for Prototype Crescent or healer for Song of Stillness.","when":"An accessible burst-oriented build that still prioritizes reactions and consistent Energy.","cond":"Weapon passives require their stated triggers.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Crystalline Bloom","Teachings of Freedom","Guide to Freedom","Philosophies of Freedom","Spectral Husk","Spectral Heart","Spectral Nucleus","Crystal Marrow","Molten Moment","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1"},{"name":"Elemental Skill","pri":"Level 8-9+"},{"name":"Elemental Burst","pri":"Level 8-9+"}],"teams":[{"name":"Dawnfire Detonation","members":["Aloy","Bennett","Kaedehara Kazuha","Xiangling"]},{"name":"Frozen Horizon","members":["Aloy","Kamisato Ayaka","Sangonomiya Kokomi","Kaedehara Kazuha"]},{"name":"Glacial Dawn","members":["Aloy","Shenhe","Kamisato Ayaka","Jean"]},{"name":"Where have all the good cons gone?","members":["Aloy","Bennett","Xiangling","Sucrose"]}]}}],"title":"Aloy","el":"Cryo"}