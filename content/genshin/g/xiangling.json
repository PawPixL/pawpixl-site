.0463,0.037],"k":"a"},{"n":"Crimson Witch of Flames","r":[0.5231,0.3215,0.0463,0.037],"k":"a"},{"n":"Noblesse Oblige","r":[0.5231,0.3896,0.0463,0.037],"k":"a"},{"n":"Crimson Witch of Flames","r":[0.575,0.3896,0.0463,0.037],"k":"a"},{"n":"Xiangling","r":[0.0815,0.5067,0.037,0.0296]},{"n":"Xingqiu","r":[0.1259,0.5067,0.037,0.0296]},{"n":"Bennett","r":[0.1704,0.5067,0.037,0.0296]},{"n":"Sucrose","r":[0.2148,0.5067,0.037,0.0296]},{"n":"Xiangling","r":[0.0815,0.56,0.037,0.0296]},{"n":"Raiden Shogun","r":[0.1259,0.56,0.037,0.0296]},{"n":"Xingqiu","r":[0.1704,0.56,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.56,0.037,0.0296]},{"n":"Xiangling","r":[0.0815,0.6133,0.037,0.0296]},{"n":"Tartaglia","r":[0.1259,0.6133,0.037,0.0296]},{"n":"Kaedehara Kazuha","r":[0.1704,0.6133,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.6133,0.037,0.0296]},{"n":"Xiangling","r":[0.0815,0.6741,0.037,0.0296]},{"n":"Bennett","r":[0.1259,0.6741,0.037,0.0296]},{"n":"Fischl","r":[0.1704,0.6741,0.037,0.0296]},{"n":"Chevreuse","r":[0.2148,0.6741,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/xiangling/261111-225405/en-1.t.webp","why":{"w":[{"name":"Staff of the Scarlet Sands","text":"Premium CRIT Rate and EM-to-ATK conversion benefit reaction-focused Pyronado. Do not waste field time stacking its passive. Best when reactions and EM investment matter."},{"name":"Engulfing Lightning","text":"Converts ER into ATK and buffs Burst DMG."},{"name":"Staff of Homa","text":"Large CRIT DMG and HP-based ATK make it a strong damage option, though its low-HP bonus is not always active. Meet ER needs through artifacts and teammates."},{"name":"\"The Catch\"","text":"Outstanding free choice: ER."},{"name":"Wavebreaker's Fin","text":"Boosts Burst damage based on the team’s combined Energy costs; competitive with high refinements and strong CRIT artifacts. Best with high-cost Bursts. R5 preferred."},{"name":"Favonius Lance","text":"Generates neutral particles on an on-field CRIT hit, reducing team Energy pressure; lower personal damage than offensive options. Build enough CRIT Rate and trigger passive on field. Higher refinements improve consistency."},{"name":"Dragon's Bane","text":"Provides EM and bonus damage against Hydro/Pyro-affected enemies, making it strong in Vaporize and Overvape teams. Use in reaction teams; solve ER separately. Refinements improve passive damage."},{"name":"Kitain Cross Spear","text":"Craftable EM polearm that restores Energy through its Skill passive; good in energy-hungry reaction teams. Use Skill after Burst to manage its initial Energy cost. R5 preferred."}],"a":[{"names":["Emblem of Severed Fate"],"text":"Best general set: 20% ER and Burst DMG scaling with ER strengthen Pyronado while helping meet Energy requirements.","stats":"ER / EM / ATK% · Pyro DMG · CRIT"},{"names":["Crimson Witch of Flames"],"text":"Good in reaction-heavy teams, especially Overvape.","stats":"ER / EM / ATK% · Pyro DMG · CRIT"},{"names":["Noblesse Oblige","Crimson Witch of Flames"],"text":"Flexible interim 2-piece Burst DMG and 2-piece Pyro DMG while farming a complete Emblem set.","stats":"ER / EM / ATK% · Pyro DMG · CRIT"}],"t":[{"name":"National Kitchen","members":["Xiangling","Xingqiu","Bennett","Sucrose"],"text":"Xingqiu enables Pyronado Vaporize, Bennett fuels and buffs Xiangling, and Sucrose shares EM and shreds resistance with Viridescent Venerer.","roles":["Off-Field DPS","Hydro Sub DPS","Healer / Buffer","Anemo Support"]},{"name":"Raiden Hot Pot","members":["Xiangling","Raiden Shogun","Xingqiu","Bennett"],"text":"Raiden helps recharge the team while Xingqiu enables Vaporize. Cast Pyronado inside Bennett’s Burst to snapshot his ATK buff.","roles":["Off-Field DPS","On-Field DPS","Hydro Sub DPS","Healer / Buffer"]},{"name":"International Heat","members":["Xiangling","Tartaglia","Kaedehara Kazuha","Bennett"],"text":"Tartaglia applies Hydro for frequent Pyronado Vaporizes; Kazuha buffs and groups while Bennett supplies ATK and Pyro particles.","roles":["Off-Field DPS","Hydro Driver","Anemo Buffer","Healer / Buffer"]},{"name":"Overload Express","members":["Xiangling","Bennett","Fischl","Chevreuse"],"text":"Chevreuse supports a Pyro/Electro-only Overloaded team; Fischl adds off-field Electro and Bennett strengthens Xiangling’s Pyronado.","roles":["Off-Field DPS","Healer / Buffer","Electro Sub DPS","Overloaded Support"]}],"v":"Vaporize: 4pc Emblem, The Catch or Scarlet Sands; prioritize ER, CRIT and EM. Snapshot Bennett before Pyronado.\nOverloaded: 4pc Emblem with Chevreuse and Pyro/Electro allies; build ER and CRIT rather than full EM.\nNo Bennett: Engulfing Lightning or Favonius; expect higher ER requirements and reduced snapshot ATK buffs.\nBurgeon: 4pc Gilded Dreams or Flower of Paradise Lost; stack EM after meeting steep Burst ER needs.\nBudget: R5 The Catch + 4pc Emblem; funnel Bennett particles and use an ER Sands if needed.","n":2},"seo":{"roles":["Sub DPS / Off-Field DPS"],"about":"Xiangling is an off-field Pyro DMG dealer whose Pyronado delivers powerful AoE DMG and reaction application. Cast it inside Bennett’s Burst to snapshot his ATK buff, then use a Hydro or Electro teammate to enable reactions.","pros":["Strong off-field AoE","Excellent Pyro application","Powerful Vaporize teams","Outstanding free weapon"],"cons":["High Energy needs","Bennett often preferred","Needs particle funneling","Guoba positioning matters"],"weapons":["Staff of the Scarlet Sands","Engulfing Lightning","Staff of Homa","\"The Catch\"","Wavebreaker's Fin","Favonius Lance","Dragon's Bane","Kitain Cross Spear"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":""},{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs","role":""},{"sets":["Noblesse Oblige","Crimson Witch of Flames"],"pcs":"2 + 2 pcs","role":""}],"main":["Energy Recharge / Elemental Mastery / ATK%","Pyro DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["Energy Recharge: 190% - 250% (team-dependent)","CRIT Rate: 60% - 75%","CRIT DMG: 120% - 170%+","Elemental Mastery: 100 - 250 (Vaporize)","ATK: varies with Bennett buffs"],"vars":[{"title":"Accessible National","role":"Off-field Pyro DPS","weapons":["\"The Catch\"","Favonius Lance","Kitain Cross Spear"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"}],"stats":"Meet team ER first; then CRIT, EM and ATK%.","teams":"Bennett plus a Hydro applier such as Xingqiu; Anemo flex works well.","when":"An accessible way to learn Vaporize Xiangling without premium weapons. Catch R5 is a standout option.","cond":"Funnel Bennett Skill particles to Xiangling.","notes":"Bennett buffs should be active when Pyronado is cast.","pre":false},{"title":"Chevreuse Overloaded","role":"Off-field Pyro DPS","weapons":["\"The Catch\"","Deathmatch","Wavebreaker's Fin"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"}],"stats":"Prioritize ER and CRIT; do not stack full EM solely for Overloaded.","teams":"Only Pyro and Electro teammates when relying on Chevreuse’s team passive.","when":"Use in Pyro/Electro damage teams where Chevreuse improves damage and RES shred.","cond":"Requires Chevreuse and compatible Pyro/Electro-only party.","notes":"Xiangling snapshots applicable ATK buffs when casting Burst.","pre":false},{"title":"No-Bennett Pyronado","role":"Off-field Pyro DPS","weapons":["Engulfing Lightning","Favonius Lance","\"The Catch\""],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"}],"stats":"Raise ER significantly; ATK% can become more valuable without Bennett.","teams":"Needs strong battery or multiple Favonius procs; consider Raiden.","when":"For teams using Bennett on the other side, accepting much more demanding Burst uptime.","cond":"Energy requirements vary widely by team.","notes":"Do not imply Pyronado is consistently available without sufficient Energy.","pre":false},{"title":"Burgeon Trigger","role":"Reaction DPS","weapons":["Kitain Cross Spear","Dragon's Bane","Favonius Lance"],"arts":[{"sets":["Flower of Paradise Lost"],"pcs":"4 pcs