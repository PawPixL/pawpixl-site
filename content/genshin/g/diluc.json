037,0.0296]},{"n":"Bennett","r":[0.2148,0.5556,0.037,0.0296]},{"n":"Diluc","r":[0.0815,0.6089,0.037,0.0296]},{"n":"Xianyun","r":[0.1259,0.6089,0.037,0.0296]},{"n":"Furina","r":[0.1704,0.6089,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.6089,0.037,0.0296]},{"n":"Diluc","r":[0.0815,0.6622,0.037,0.0296]},{"n":"Kaedehara Kazuha","r":[0.1259,0.6622,0.037,0.0296]},{"n":"Xianyun","r":[0.1704,0.6622,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.6622,0.037,0.0296]},{"n":"Diluc","r":[0.0815,0.723,0.037,0.0296]},{"n":"Sucrose","r":[0.1259,0.723,0.037,0.0296]},{"n":"Xingqiu","r":[0.1704,0.723,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.723,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/diluc/261111-224858/en-1.t.webp","why":{"w":[{"name":"Wolf's Gravestone","text":"High ATK and a conditional team ATK buff. A strong general option."},{"name":"Beacon of the Reed Sea","text":"CR and ATK after taking damage or using Skill. Excellent damage stat stick for Diluc. Shielding may limit part of its passive."},{"name":"Redhorn Stonethresher","text":"Large CD stat stick. Its DEF-based Normal Attack passive is weak on Diluc; use for CRIT stats."},{"name":"Serpent Spine","text":"BP CR and stacking damage with field time. Protect stacks from hits. Stronger at high refinements."},{"name":"Blackcliff Slasher","text":"Provides CRIT DMG and stacking ATK after defeating enemies. Best against waves rather than single bosses."},{"name":"Rainslasher","text":"EM and damage against Hydro-affected enemies; strong in Vaporize. Requires Hydro uptime."},{"name":"Prototype Archaic","text":"Craftable ATK claymore with occasional bonus Physical damage. Solid budget fallback."},{"name":"Mailed Flower","text":"Gives Elemental Mastery and grants ATK and more EM after using his Skill or triggering a reaction. Good for Vaporize teams."}],"a":[{"names":["Crimson Witch of Flames"],"text":"Strong general set for Pyro reaction damage and Skill-based rotations.","stats":"ATK%/EM · Pyro · CR/CD"},{"names":["Marechaussee Hunter"],"text":"CRIT alternative when Furina enables consistent HP changes.","stats":"ATK%/EM · Pyro · CD"},{"names":["Gilded Dreams"],"text":"EM-focused reaction alternative, generally weaker than Crimson Witch.","stats":"EM/ATK% · Pyro · CR/CD"}],"t":[{"name":"Melt Force One","members":["Diluc","Xianyun","Citlali","Bennett"],"text":"Xianyun enables plunging attacks while Citlali shields and supplies Cryo for Melt. Bennett provides healing and ATK.","roles":["DPS","Support","Support","Support"]},{"name":"Splash Landing","members":["Diluc","Xianyun","Furina","Bennett"],"text":"Xianyun turns Diluc’s attacks into plunges, Furina supplies Hydro and damage buffs, and Bennett boosts ATK and heals.","roles":["DPS","Support","Support","Support"]},{"name":"Dawn & Tonic","members":["Diluc","Kaedehara Kazuha","Xianyun","Bennett"],"text":"Xianyun enables plunges while Kazuha groups and shreds Pyro resistance. Bennett adds ATK and healing; this focuses on raw Pyro damage.","roles":["DPS","Support","Support","Support"]},{"name":"F2P-Wan Kenobi","members":["Diluc","Sucrose","Xingqiu","Bennett"],"text":"Xingqiu enables Vaporize, Sucrose boosts EM and reduces Pyro resistance, and Bennett heals and increases ATK.","roles":["DPS","Support","Support","Support"]}],"v":"Vaporize DPS: A flexible reaction build that amplifies Diluc’s Skill and infused attacks.\nFurina Plunge: Use high-multiplier plunges and Furina’s HP changes to enable a CRIT-focused set.\nMelt Plunge: Focus on Melt-enhanced plunges with Citlali or other Cryo enablers.","n":4},"seo":{"roles":["DPS"],"about":"Diluc is an on-field Pyro claymore DPS with flexible Vaporize and Melt teams. He can also use Xianyun’s plunge support for strong plunging attacks. Build ATK, Pyro damage, and CRIT, with EM when reactions are reliable.","pros":["Easy to play","Flexible combos","Strong reactions","Low-cost Burst"],"cons":["Lower damage ceiling","Wants reactions","Support reliant","Plunge wants Xianyun"],"weapons":["Wolf's Gravestone","Beacon of the Reed Sea","Redhorn Stonethresher","Serpent Spine","Blackcliff Slasher","Rainslasher","Prototype Archaic","Mailed Flower"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Gilded Dreams"],"pcs":"4 pcs","role":"Main DPS"}],"main":["ATK% / EM","Pyro DMG","CR / CD"],"stats":["CR: 65–80%","CD: 140–200%+","ATK: 1,800–2,400","EM: Vape/Melt only"],"vars":[{"title":"Vaporize DPS","role":"On-field DPS","weapons":["Wolf's Gravestone","Rainslasher","Serpent Spine"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"}],"stats":"ATK% or EM / Pyro / CRIT.","teams":"Reliable Hydro such as Xingqiu.","when":"A flexible reaction build that amplifies Diluc’s Skill and infused attacks.","cond":"EM has value only with dependable reactions","notes":"","pre":false},{"title":"Furina Plunge","role":"On-field DPS","weapons":["Serpent Spine","Wolf's Gravestone","Redhorn Stonethresher"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"ATK% or EM / Pyro / CD; avoid CR overcap.","teams":"Xianyun plunge support and Furina with healing.","when":"Use high-multiplier plunges and Furina’s HP changes to enable a CRIT-focused set.","cond":"Requires reliable HP fluctuation","notes":"","pre":false},{"title":"Melt Plunge","role":"On-field DPS","weapons":["Wolf's Gravestone","Serpent Spine","Mailed Flower"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"}],"stats":"ATK% or EM / Pyro / CRIT.","teams":"Xianyun and sufficient Cryo application.","when":"Focus on Melt-enhanced plunges with Citlali or other Cryo enablers.","cond":"Melt frequency depends on Cryo uptime","notes":"","pre":false}],"mats":["Agnidus Agate Sliver","Agnidus Agate Fragment","Agnidus Agate Chunk","Agnidus Agate Gemstone","Everflame Seed","Teachings of Resistance","Guide to Resistance","Philosophies of Resistance","Recruit's Insignia","Sergeant's Insignia","Lieutenant's Insignia","Small Lamp Grass","Dvalin's Plume","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 9+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Melt Force One","members":["Diluc","Xianyun","Citlali","Bennett"]},{"name":"Splash Landing","members":["Diluc","Xianyun","Furina","Bennett"]},{"name":"Dawn & Tonic","members":["Diluc","Kaedehara Kazuha","Xianyun","Bennett"]},{"name":"F2P-Wan Kenobi","members":["Diluc","Sucrose","Xingqiu","Bennett"]}]}}],"title":"Diluc","el":"Pyro"}