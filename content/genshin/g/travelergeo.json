","r":[0.2176,0.6178,0.038,0.0304]},{"n":"Noelle","r":[0.1269,0.6726,0.038,0.0304]},{"n":"Gorou","r":[0.1722,0.6726,0.038,0.0304]},{"n":"Furina","r":[0.2176,0.6726,0.038,0.0304]},{"n":"Ningguang","r":[0.1269,0.7274,0.038,0.0304]},{"n":"Bennett","r":[0.1722,0.7274,0.038,0.0304]},{"n":"Xiangling","r":[0.2176,0.7274,0.038,0.0304]}]}]}},"thumb":"content/genshin/builds/travelergeo/261111-225334/en-1.t.webp","why":{"w":[{"name":"Exaiphanes Blade","text":"Exaiphanes Blade is excellent for Geo Traveler because it provides CRIT Rate, ATK buffs, and Energy regeneration,all of which improve their Skill and Burst damage."},{"name":"Primordial Jade Cutter","text":"Provides a huge CRIT Rate stat stick and converts HP to ATK."},{"name":"Haran Geppaku Futsu","text":"Provides CRIT Rate and increases Normal Attack damage through its Wavespike passive."},{"name":"Mistsplitter Reforged","text":"Gives CRIT DMG and up to 12% Elemental DMG Bonus across its stacks."},{"name":"Wolf-Fang","text":"Battle Pass sword giving CRIT Rate and boosting both Skill and Burst damage."},{"name":"Favonius Sword","text":"Energy battery for the team; low base ATK but high ER, best for support roles rather than raw damage."},{"name":"Amenoma Kageuchi","text":"ATK% sword that restores energy after Burst, letting you spam Burst without heavy ER investment."},{"name":"Festering Desire","text":"Event sword that boosts Skill damage and CRIT Rate on Skill hit."}],"a":[{"names":["Archaic Petra","Noblesse Oblige"],"text":"Balanced Geo and Burst damage.","stats":"ATK% · Geo DMG · CRIT"},{"names":["Emblem of Severed Fate"],"text":"Converts ER into Burst damage.","stats":"ATK%/ER · Geo DMG · CRIT"},{"names":["Noblesse Oblige"],"text":"Team ATK buff after Burst.","stats":"ER/ATK% · Geo DMG · CRIT"}],"t":[{"name":"Meteorite Resonance","members":["Traveler (Geo)","Zhongli","Albedo","Bennett"],"text":"Zhongli resonates with Traveler constructs, Albedo adds Geo damage, and Bennett boosts attacks.","roles":["Geo Battery / Sub DPS","Shielder / Debuffer","Off-field DPS","Healer / Buffer"]},{"name":"Oni Support Squad","members":["Traveler (Geo)","Arataki Itto","Gorou","Zhongli"],"text":"Traveler supplies Geo particles and C1 CRIT Rate; Gorou buffs Itto while Zhongli shields.","roles":["Geo Battery / Sub DPS","On-field DPS","DEF Buffer","Shielder / Debuffer"]},{"name":"Geo Powerhouse","members":["Traveler (Geo)","Noelle","Gorou","Furina"],"text":"Traveler batteries Noelle and grants CRIT Rate; Gorou buffs DEF while Furina raises damage.","roles":["Geo Battery / Sub DPS","On-field DPS / Healer","DEF Buffer","Off-field DPS / Buffer"]},{"name":"Budget Rockslide","members":["Traveler (Geo)","Ningguang","Bennett","Xiangling"],"text":"Geo resonance boosts Geo damage while Bennett and Xiangling add Pyro pressure.","roles":["Geo Battery / Sub DPS","On-field DPS","Healer / Buffer","Off-field DPS / Pyro Enabler"]}],"v":"Battery Support: Favonius + Noblesse; prioritize ER and CRIT Rate to feed Geo carries.\nQuickswap DPS: Use Skill and Burst on cooldown; favor Geo DMG, ATK and balanced CRIT.\nBoss Fights: Aim constructs carefully so boulders do not obstruct melee allies.","n":4},"seo":{"roles":["Sub DPS / Support"],"about":"Geo Traveler is a quickswap Geo damage dealer and battery with strong Skill and Burst hits. Their Burst grants nearby allies CRIT Rate at C1, while Geo constructs offer utility and synergy with Zhongli. Positioning matters: boulders can obstruct movement.","pros":["Strong quickswap damage","Geo particle generation","C1 team CRIT buff","Flexible support builds"],"cons":["Constructs obstruct allies","Requires careful aim","Low base stats","Best with Geo resonance"],"weapons":["Exaiphanes Blade","Primordial Jade Cutter","Haran Geppaku Futsu","Mistsplitter Reforged","Wolf-Fang","Favonius Sword","Amenoma Kageuchi","Festering Desire"],"arts":[{"sets":["Archaic Petra","Noblesse Oblige"],"pcs":"2 + 2 pcs","role":""},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":""},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""}],"main":["ATK% / Energy Recharge","Geo DMG Bonus","Crit Rate / Crit DMG"],"stats":["CRIT Rate: 60-75%","CRIT DMG: 120-180%","ATK: 1,500-2,000","ER: 120-150%"],"vars":[{"title":"Geo Battery Support","role":"Support","weapons":["Favonius Sword","Amenoma Kageuchi"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Archaic Petra"],"pcs":"4 pcs"}],"stats":"Prioritize ER and Favonius CRIT Rate. ER Sands may be needed when funneling particles to a Geo carry.","teams":"Best alongside an Energy-hungry Geo damage dealer; use Burst for C1 CRIT Rate.","when":"Choose when team Energy and buff uptime matter more than Traveler personal damage. Pick up matching Crystallize shards for Petra buff.","cond":"C1 required for Burst CRIT Rate buff.","notes":"Archaic Petra buffs the element of the shard picked up, not Geo damage itself.","pre":false},{"title":"Quickswap Geo Damage","role":"Off-field DPS","weapons":["Primordial Jade Cutter","Haran Geppaku Futsu","Mistsplitter Reforged","Wolf-Fang"],"arts":[{"sets":["Archaic Petra","Noblesse Oblige"],"pcs":"2 + 2 pcs"},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"}],"stats":"ATK% Sands, Geo DMG Goblet and CRIT Circlet. Seek enough ER to Burst on rotation.","teams":"Another Geo ally is recommended for resonance and particle support.","when":"Swap in for Starfell Sword and Wake of Earth, then return to the main damage dealer.","cond":"Avoid placing constructs where they obstruct allies.","notes":"This is the preferred personal-damage playstyle.","pre":false}],"mats":["Brilliant Diamond Sliver","Brilliant Diamond Fragment","Brilliant Diamond Chunk","Brilliant Diamond Gemstone","","Teachings of Prosperity","Guide to Prosperity","Philosophies of Diligence","Firm Arrowhead","Sharp Arrowhead","Sharp Arrowhead","Windwheel Aster","Tail of Boreas","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Meteorite Resonance","members":["Traveler (Geo)","Zhongli","Albedo","Bennett"]},{"name":"Oni Support Squad","members":["Traveler (Geo)","Arataki Itto","Gorou","Zhongli"]},{"name":"Geo Powerhouse","members":["Traveler (Geo)","Noelle","Gorou","Furina"]},{"name":"Budget Rockslide","members":["Traveler (Geo)","Ningguang","Bennett","Xiangling"]}]}}],"title":"Traveler (Geo)","el":"Geo"}