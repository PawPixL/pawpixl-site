89]},{"n":"Nicole","r":[0.1685,0.6081,0.0361,0.0289]},{"n":"Durin","r":[0.212,0.6081,0.0361,0.0289]},{"n":"Emilie","r":[0.0815,0.6674,0.0361,0.0289]},{"n":"Mualani","r":[0.125,0.6674,0.0361,0.0289]},{"n":"Mavuika","r":[0.1685,0.6674,0.0361,0.0289]},{"n":"Nahida","r":[0.212,0.6674,0.0361,0.0289]},{"n":"Emilie","r":[0.0815,0.7267,0.0361,0.0289]},{"n":"Bennett","r":[0.125,0.7267,0.0361,0.0289]},{"n":"Xiangling","r":[0.1685,0.7267,0.0361,0.0289]},{"n":"Sucrose","r":[0.212,0.7267,0.0361,0.0289]}]}]}},"thumb":"content/genshin/builds/emilie/261111-224858/en-1.t.webp","why":{"w":[{"name":"Lumidouce Elegy","text":"Signature CR, ATK and damage bonuses that synergize with Burning teams."},{"name":"Calamity Queller","text":"High Base ATK, elemental damage bonus and an ATK passive that gains value off-field."},{"name":"Symphonist of Scents","text":"CD stat stick and ATK; its healing-based team buff is normally inactive on Emilie. For personal stats, not its healing passive."},{"name":"Staff of Homa","text":"CD and HP-based ATK; a solid general damage alternative without Burning-specific buffs."},{"name":"Deathmatch","text":"BP CR with conditional ATK; convenient for balancing CRIT."},{"name":"Tamayuratei no Ohanashi","text":"Provides Energy Recharge and an ATK bonus after using her Skill. A usable event weapon when stronger damage options are unavailable."},{"name":"Kitain Cross Spear","text":"Craftable EM and Skill-based Energy return; not ideal for her ATK-focused damage."},{"name":"\"The Catch\"","text":"Free ER and Burst bonuses; Skill damage does not benefit from its passive."}],"a":[{"names":["Unfinished Reverie"],"text":"Best general personal damage set when Burning is maintained.","stats":"ATK% · Dendro · CR/CD"},{"names":["Deepwood Memories"],"text":"Use when no teammate carries Deepwood and Dendro RES shred is needed.","stats":"ATK% · Dendro · CR/CD"},{"names":["Golden Troupe"],"text":"Boosts off-field Skill damage, but not all of Emilie’s damage sources.","stats":"ATK% · Dendro · CR/CD"}],"t":[{"name":"pixl Burn","members":["Emilie","Kinich","Nicole","Durin"],"text":"Kinich deals on-field damage while Emilie benefits from Burning. Durin maintains Pyro, and Nicole adds buffs and protection.","roles":["Sub DPS","DPS","Support","Sub DPS"]},{"name":"Bombing Mondstat","members":["Emilie","Klee","Nicole","Durin"],"text":"Klee supplies sustained Pyro for Emilie’s Burning damage. Durin adds off-field Pyro and Nicole provides buffs and protection.","roles":["Sub DPS","DPS","Support","Sub DPS"]},{"name":"Beach Day","members":["Emilie","Mualani","Mavuika","Nahida"],"text":"Mavuika maintains Pyro for Burning, Emilie deals off-field Dendro damage, and Mualani contributes Hydro damage. Nahida supports Dendro.","roles":["Sub DPS","DPS","Support","Sub DPS"]},{"name":"Burning at home","members":["Emilie","Bennett","Xiangling","Sucrose"],"text":"Xiangling maintains Burning while Emilie adds off-field Dendro damage. Bennett boosts ATK and heals; Sucrose groups enemies.","roles":["Sub DPS","DPS","Support","Sub DPS"]}],"v":"Burning Off-field DPS: Default damage-focused setup for teams that maintain Burning.\nDeepwood Utility: Trade some personal damage to supply Dendro resistance reduction.\nAccessible Weapons: Lower-cost weapon alternatives while retaining her Burning-focused playstyle.","n":4},"seo":{"roles":["Off-Field DPS"],"about":"Emilie is an off-field Dendro DPS who thrives when enemies are Burning. Her damage comes largely from her Skill and Burst, so prioritize ATK, Dendro damage, and CRIT rather than stacking EM.","pros":["Strong damage","Easy rotations","Off-field application","Burning synergy"],"cons":["Burning reliant","Limited reactions","Team restrictive"],"weapons":["Lumidouce Elegy","Calamity Queller","Symphonist of Scents","Staff of Homa","Deathmatch","Tamayuratei no Ohanashi","Kitain Cross Spear","\"The Catch\""],"arts":[{"sets":["Unfinished Reverie"],"pcs":"4 pcs","role":"Best"},{"sets":["Deepwood Memories"],"pcs":"4 pcs","role"