,0.0361,0.0289]},{"n":"Furina","r":[0.125,0.5459,0.0361,0.0289]},{"n":"Xingqiu","r":[0.1685,0.5459,0.0361,0.0289]},{"n":"Xianyun","r":[0.212,0.5459,0.0361,0.0289]},{"n":"Yanfei","r":[0.0815,0.5985,0.0361,0.0289]},{"n":"Yelan","r":[0.125,0.5985,0.0361,0.0289]},{"n":"Bennett","r":[0.1685,0.5985,0.0361,0.0289]},{"n":"Kaedehara Kazuha","r":[0.212,0.5985,0.0361,0.0289]},{"n":"Yanfei","r":[0.0815,0.6511,0.0361,0.0289]},{"n":"Fischl","r":[0.125,0.6511,0.0361,0.0289]},{"n":"Beidou","r":[0.1685,0.6511,0.0361,0.0289]},{"n":"Chevreuse","r":[0.212,0.6511,0.0361,0.0289]},{"n":"Yanfei","r":[0.0815,0.7104,0.0361,0.0289]},{"n":"Xingqiu","r":[0.125,0.7104,0.0361,0.0289]},{"n":"Bennett","r":[0.1685,0.7104,0.0361,0.0289]},{"n":"Sucrose","r":[0.212,0.7104,0.0361,0.0289]}]}]}},"thumb":"content/genshin/builds/yanfei/261111-225430/en-1.t.webp","why":{"w":[{"name":"Lost Prayer to the Sacred Winds","text":"Excellent CRIT Rate and growing Elemental DMG while Yanfei stays on the field. Best for long field time."},{"name":"Cashflow Supervision","text":"Huge CRIT Rate and Charged Attack bonuses when her HP changes. Best with Furina and consistent healing."},{"name":"Tome of the Eternal Flow","text":"High CRIT DMG and a powerful Charged Attack bonus when HP changes. Best with Furina and a healer."},{"name":"Skyward Atlas","text":"Provides high ATK and an unconditional Elemental DMG bonus. A consistent premium option."},{"name":"The Widsith","text":"Massive short-term buffs make this a top four-star choice. The random passive and downtime affect consistency. Especially strong in Vaporize. R5 is excellent."},{"name":"Sacrificial Jade","text":"CRIT Rate and EM help Vaporize. Its off-field activation limits longer on-field rotations. Best when rotating her out regularly."},{"name":"Flowing Purity","text":"Craftable ATK catalyst that boosts Elemental DMG after her Skill. Healing clears its Bond of Life for another bonus. Works best with a strong healer."},{"name":"Mappa Mare","text":"Craftable EM option that increases Elemental DMG after Yanfei triggers reactions. Use in reaction teams. Refinements improve its bonus."}],"a":[{"names":["Crimson Witch of Flames"],"text":"Best general Vaporize set. Buffs Pyro damage and Pyro reaction damage.","stats":"ATK% / EM, Pyro DMG, CRIT"},{"names":["Marechaussee Hunter"],"text":"Best with Furina when team HP changes reliably. Provides up to 36% CRIT Rate.","stats":"ATK% / EM, Pyro DMG, CRIT DMG"},{"names":["Wanderer's Troupe"],"text":"Offers EM and an unconditional Charged Attack damage bonus. Excellent for traditional Yanfei builds.","stats":"ATK% / EM, Pyro DMG, CRIT"}],"t":[{"name":"Courtroom Deluge","members":["Yanfei","Furina","Xingqiu","Xianyun"],"text":"Furina buffs the team, Xingqiu sustains Hydro for Vaporize, and Xianyun heals while enabling Yanfei to Vaporize plunges.","roles":["On-field DPS","Off-field DPS / Buffer","Off-field DPS / Hydro Enabler","Healer / Plunge Buffer"]},{"name":"Crimson Testimony","members":["Yanfei","Yelan","Bennett","Kaedehara Kazuha"],"text":"Yelan applies Hydro and buffs Yanfei. Bennett boosts ATK and heals, while Kazuha shreds Pyro resistance and groups enemies.","roles":["On-field DPS","Off-field DPS / Buffer","Healer / Buffer","Buffer / Debuffer"]},{"name":"Overload Objection","members":["Yanfei","Fischl","Beidou","Chevreuse"],"text":"Fischl and Beidou provide off-field Electro damage. Chevreuse buffs Pyro and Electro while Yanfei drives Overloaded.","roles":["On-field DPS","Off-field DPS / Battery","Off-field DPS","Healer / Buffer"]},{"name":"Budget Verdict","members":["Yanfei","Xingqiu","Bennett","Sucrose"],"text":"Xingqiu enables Vaporize, Bennett heals and buffs ATK, and Sucrose shares EM while reducing Pyro resistance.","roles":["On-field DPS","Off-field DPS / Hydro Enabler","Healer / Buffer","EM Buffer / Debuffer"]}],"v":"Vaporize DPS: Use Crimson Witch with EM or ATK Sands. Follow Normal Attacks with Charged Attacks to maintain Hydro reactions.\nFurina DPS: Use Marechaussee Hunter with a healer. Lower your external CRIT Rate target to account for its 36% bonus.\nOverloaded: Pair Yanfei with Chevreuse and only Pyro or Electro teammates. Prioritize steady off-field Electro application.\nC4 Shield Support: At C4, her Burst creates a shield. Use HP and ER with Prototype Amber for a separate support build.","n":4},"seo":{"roles":["Main DPS"],"about":"Yanfei is an on-field Pyro DPS who powers up her Charged Attacks with Scarlet Seals. She excels in Vaporize teams and can also drive Overloaded reactions. Her attacks reach distant enemies, but she appreciates healing or a shield to avoid interruptions.","pros":["Strong Charged Attacks","Reliable Pyro application","Great Vaporize damage","Accessible weapon options"],"cons":["Charged Attacks use stamina","Needs field time","Can be interrupted","Burst needs Energy"],"weapons":["Lost Prayer to the Sacred Winds","Cashflow Supervision","Tome of the Eternal Flow","Skyward Atlas","The Widsith","Sacrificial Jade","Flowing Purity","Mappa Mare"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs","role":""},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":""},{"sets":["Wanderer's Troupe"],"pcs":"4 pcs","role":""}],"main":["ATK% / EM","Pyro DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["CRIT Rate: 60% - 75%","CRIT DMG: 120% - 180%","ATK: 1,600 - 2,100","EM: 100 - 250 (Vape)","ER: 110% - 140% (variable)"],"vars":[{"title":"Vaporize Charged Attacks","role":"On-field DPS","weapons":["Lost Prayer to the Sacred Winds","The Widsith"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"},{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"}],"stats":"ATK% or EM Sands; Pyro DMG and CRIT.","teams":"Reliable Hydro to Vaporize Charged Attacks.","when":"Use Scarlet Seal stacks for amplified Charged Attack damage.","cond":"Manage stamina and reaction aura.","notes":"","pre":false},{"title":"Furina CRIT Carry","role":"On-field DPS","weapons":["Cashflow Supervision","The Widsith"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"Build around Marechaussee CRIT Rate.","teams":"Furina plus consistent healing.","when":"Use Furina’s HP changes for a CRIT-heavy alternative.","cond":"Only when HP fluctuations are reliable.","notes":"","pre":false},{"title":"C4 Shield Support","role":"Support","weapons":["The Widsith","Sacrificial Jade"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"}],"stats":"ER and HP for shield reliability; personal damage secondary.","teams":"C4 Yanfei and a team needing protection.","when":"Use Yanfei’s Burst shield as a situational support option.","cond":"C4 is required; high ER may be needed.","notes":"","pre":false}],"mats":["Agnidus Agate Sliver","Agnidus Agate Fragment","Agnidus Agate Chunk","Agnidus Agate Gemstone","Juvenile Jade","Teachings of Gold","Guide to Gold","Philosophies of Gold","Treasure Hoarder Insignia","Silver Raven Insignia","Golden Raven Insignia","Noctilucous Jade","Bloodjade Branch","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 9+"},{"name":"Elemental Skill","pri":"Level 6–8"},{"name":"Elemental Burst","pri":"Level 8–9"}],"teams":[{"name":"Courtroom Deluge","members":["Yanfei","Furina","Xingqiu","Xianyun"]},{"name":"Crimson Testimony","members":["Yanfei","Yelan","Bennett","Kaedehara Kazuha"]},{"name":"Overload Objection","members":["Yanfei","Fischl","Beidou","Chevreuse"]},{"name":"Budget Verdict","members":["Yanfei","Xingqiu","Bennett","Sucrose"]}]}}],"title":"Yanfei","el":"Pyro"}