n":"Linnea","r":[0.2065,0.623,0.0343,0.0274]},{"n":"Noelle","r":[0.0815,0.68,0.0343,0.0274]},{"n":"Columbina","r":[0.1231,0.68,0.0343,0.0274]},{"n":"Furina","r":[0.1648,0.68,0.0343,0.0274]},{"n":"Linnea","r":[0.2065,0.68,0.0343,0.0274]},{"n":"Noelle","r":[0.0815,0.737,0.0343,0.0274]},{"n":"Nicole","r":[0.1231,0.737,0.0343,0.0274]},{"n":"Durin","r":[0.1648,0.737,0.0343,0.0274]},{"n":"Xilonen","r":[0.2065,0.737,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/noelle/261111-225210/en-1.t.webp","why":{"w":[{"name":"Redhorn Stonethresher","text":"Best personal DPS weapon: huge CRIT DMG, DEF and DEF-based Normal/Charged Attack damage."},{"name":"Gest of the Mighty Wolf","text":"CRIT Rate and strong offensive bonuses. Particularly effective in qualifying Hexerei teams; less specialized outside them."},{"name":"A Thousand Blazing Suns","text":"High Base ATK, CRIT Rate and a Skill/Burst-triggered ATK and CRIT DMG buff; less DEF synergy than Redhorn. ATK passive is less useful than DEF scaling."},{"name":"Serpent Spine","text":"Serpent Spine is an excellent 4-star alternative, offering valuable CRIT Rate and stacking DMG bonuses that significantly boost Noelle's overall damage."},{"name":"Skyward Pride","text":"Skyward Pride provides valuable Energy Recharge for Burst uptime, along with increased damage and additional vacuum blade damage after using her Burst."},{"name":"Favonius Greatsword","text":"Favonius Greatsword provides Energy Recharge and generates extra particles through CRIT hits, helping Noelle and her teammates maintain consistent Burst uptime."},{"name":"Whiteblind","text":"Craftable DEF% claymore; Normal/Charged hits grant extra DEF and ATK."},{"name":"Sacrificial Greatsword","text":"Energy Recharge and a chance to reset Skill cooldown. Better for extra casts than personal damage."}],"a":[{"names":["Husk of Opulent Dreams"],"text":"4pc Husk of Opulent Dreams is Noelle's best overall artifact set, providing DEF% and Geo DMG bonuses that directly enhance her C6 damage, shielding, and healing.","stats":"DEF% · Geo DMG · CR/CD"},{"names":["Marechaussee Hunter"],"text":"4pc Marechaussee Hunter is a strong alternative when paired with Furina, providing up to 36% CRIT Rate through HP fluctuations. This allows Noelle to prioritize CRIT DMG while maintaining excellent damage output.","stats":"DEF% · Geo DMG · CR/CD"},{"names":["Archaic Petra"],"text":"4pc Archaic Petra makes Noelle a team support option, granting a 35% Elemental DMG Bonus to the element corresponding to the Crystallize shard she collects, benefiting elemental-focused teammates.","stats":"DEF%/ER · DEF% · DEF%/Healing Bonus"}],"t":[{"name":"Geo Moonrise","members":["Noelle","Columbina","Ineffa","Linnea"],"text":"Noelle leads with Geo damage and healing. Columbina supports Lunar reactions, Ineffa adds off-field Electro damage, and Linnea provides Geo support.","roles":["On-field DPS","Off-field DPS / Buffer","Off-field DPS / Shielder","Off-field DPS / Buffer"]},{"name":"Hopeless Impact","members":["Noelle","Columbina","Illuga","Linnea"],"text":"Noelle leads as the on-field DPS, while Columbina enables Lunar-Crystallize reactions. Linnea provides Geo RES shred and off-field damage, while Illuga boosts Noelle's Geo damage and CRIT potential for stronger overall output.","roles":["On-field DPS","Off-field DPS / Buffer","Geo Buffer","Off-field DPS / Buffer"]},{"name":"Heavenly Deluge","members":["Noelle","Columbina","Furina","Linnea"],"text":"Noelle drives the team with Geo damage and healing, while Furina buffs overall damage, Columbina boosts Lunar reactions, and Linnea provides Geo RES shred and off-field damage.","roles":["On-field DPS","Off-field DPS / Buffer","Off-field DPS / Buffer","Off-field DPS / Buffer"]},{"name":"Big Boom","members":["Noelle","Nicole","Durin","Xilonen"],"text":"Noelle leads with Geo damage while Durin provides off-field Pyro damage, Nicole boosts team performance through Hexerei synergy, and Xilonen adds buffs and resistance shred.","roles":["On-field DPS","Shielder / Buffer","Off-field DPS / Buffer","Healer / Debuffer"]}],"v":"On-field Geo: Focus on Burst-infused attacks and team healing.\nFurina Driver: Use Noelle’s healing and attacks to enable Furina’s Fanfare.","n":4},"seo":{"roles":["Main DPS & Support"],"about":"Noelle combines strong Geo AoE damage with shielding and healing. At C6, she becomes a powerful DEF-scaling Main DPS with excellent survivability.","pros":["Strong AoE damage","Built-in healing","Reliable survivability","Excellent C6 scaling"],"cons":["Energy-hungry Burst","Requires field time","C6-dependent damage","Shield downtime"],"weapons":["Redhorn Stonethresher","Gest of the Mighty Wolf","A Thousand Blazing Suns","Serpent Spine","Skyward Pride","Favonius Greatsword","Whiteblind","Sacrificial Greatsword"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs","role":"Best Overall Set"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Main DPS with Furina"},{"sets":["Archaic Petra"],"pcs":"4 pcs","role":"Support / Healer"}],"main":["DEF% / ER","Geo DMG / DEF%","CRIT / DEF% / Healing"],"stats":["DEF: 1,800 - 2,300+","CRIT Rate: 70% - 80%","CRIT DMG: 180% - 220%+","Energy Recharge: 130% - 150%"],"vars":[{"title":"On-field Geo","role":"Main DPS","weapons":["Whiteblind","Serpent Spine"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"}],"stats":"DEF% / Geo DMG / CRIT; manage ER.","teams":"Geo battery and off-field damage allies.","when":"Focus on Burst-infused attacks and team healing.","cond":"","notes":"","pre":false},{"title":"Furina Driver","role":"Main DPS","weapons":["Whiteblind","Serpent Spine"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"Build around artifact CRIT Rate; retain DEF.","teams":"Furina and enough ER for Noelle Burst.","when":"Use Noelle’s healing and attacks to enable Furina’s Fanfare.","cond":"","notes":"","pre":false}],"mats":["Prithiva Topaz Sliver","Prithiva Topaz Fragment","Prithiva Topaz Chunk","Prithiva Topaz Gemstone","Basalt Pillar","Teachings of Resistance","Guide to Resistance","Philosophies of Resistance","Damaged Mask","Stained Mask","Ominous Mask","Valberry","Dvalin's Claw","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 9+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Geo Moonrise","members":["Noelle","Columbina","Ineffa","Linnea"]},{"name":"Hopeless Impact","members":["Noelle","Columbina","Illuga","Linnea"]},{"name":"Heavenly Deluge","members":["Noelle","Columbina","Furina","Linnea"]},{"name":"Big Boom","members":["Noelle","Nicole","Durin","Xilonen"]}]}}],"title":"Noelle","el":"Geo"}