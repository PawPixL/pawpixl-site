24,0.743,0.0435,0.0348]},{"n":"Xianyun","r":[0.1833,0.743,0.0435,0.0348]},{"n":"Furina","r":[0.2343,0.743,0.0435,0.0348]}]}]}},"thumb":"content/genshin/builds/faruzan/261111-224925/en-1.t.webp","why":{"w":[{"name":"Elegy for the End","text":"Provides Energy Recharge, teamwide ATK and Elemental Mastery buffs."},{"name":"Favonius Warbow","text":"Provides Energy Recharge and generates particles for her burst."},{"name":"Breezeborne Refrain","text":"Provides Energy Recharge and boosts Stellar dmg."},{"name":"Skyward Harp","text":"Provides CRIT Rate and CRIT DMG for DPS focused builds."},{"name":"End of the Line","text":"Provides Energy Recharge and deals extra area damage after using her Skill. Mostly a fallback when better support bows are unavailable."},{"name":"Fading Twilight","text":"Energy Recharge and a rotating damage bonus. A usable off-field option, though the buff level varies."},{"name":"Sacrificial Bow","text":"Energy Recharge and a chance to reset Skill cooldown after Skill damage. More useful for extra casts than raw damage."}],"a":[{"names":["Tenacity of the Millelith"],"text":"At C6, repeated Skill hits maintain a team ATK buff. Not recommended before C6.","stats":"ER / Flexible / CRIT Rate if Favonius"},{"names":["Noblesse Oblige"],"text":"Provides a team ATK buff after her Burst. Use when another teammate does not already carry it.","stats":"Energy Recharge first"},{"names":["Viridescent Venerer"],"text":"Reduces resistance to Swirled elements, but does not reduce Anemo resistance for hypercarries.","stats":"Energy Recharge first"}],"t":[{"name":"PawPixl's Team","members":["Faruzan","Wanderer","Nicole","Durin"],"text":"Faruzan provides Anemo buffs and resistance shredding while Nicole and Durin increase team damage.","roles":["Support","Main DPS","Shielder / Buffer","Off-field DPS / Buffer"]},{"name":"She was a Farie","members":["Faruzan","Vesna","Vodyanitsa","Odette"],"text":"Faruzan buffs Vesna's Anemo damage and shreds resistance while the team maximizes Stellar-Swirl reactions.","roles":["Anemo Buffer / Debuffer","On-field DPS","Healer / Buffer","Cryo Enabler / Buffer"]},{"name":"Bad Dreams","members":["Faruzan","Yumemizuki Mizuki","Odette","Traveler (Cryo)"],"text":"Faruzan boosts Anemo damage while Mizuki drives Swirl. Odette and Cryo Traveler provide additional reaction support, though Faruzan is less valuable here than for Anemo hypercarries.","roles":["Anemo Buffer / Debuffer","On-field Driver","Cryo Enabler / Buffer","Cryo Enabler / Sub DPS"]},{"name":"Terminal Velocity","members":["Faruzan","Xiao","Xianyun","Furina"],"text":"Faruzan buffs Xiao's Anemo damage while Xianyun boosts plunges and Furina provides powerful DMG buffs.","roles":["Anemo Buffer","Main DPS","Healer / Plunge Buff","Hydro Buffer"]}],"v":"ER Before C6: Prioritize ER for Burst uptime. Her requirements drop significantly at C6, freeing stats for damage.","n":4},"seo":{"roles":["Support"],"about":"Faruzan is an Anemo support who shreds resistance, boosts Anemo damage, and offers a new Stellar support niche, expanding her usefulness beyond traditional Anemo teams.","pros":["Powerful buffs","RES shredding","Stellar synergy","C6 grouping"],"cons":["High ER Needs","C6 dependent","Limited flexibility","Low damage"],"weapons":["Elegy for the End","Favonius Warbow","Breezeborne Refrain","Skyward Harp","End of the Line","Fading Twilight","Sacrificial Bow"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"C6 Support"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"General Support"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs","role":"Swirl Support"}],"main":["Energy Recharge / ATK%","Anemo DMG","Crit Rate / Crit DMG"],"stats":["Energy Recharge: 225% - 245%","ATK: 1,400-1,600+","Crit Rate: 60% - 75%","Crit DMG: 130-150%"],"vars":[{"title":"Anemo Hypercarry Buffer","role":"Support","weapons":["Favonius Warbow","Elegy for the End"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Prioritize ER first; add CR for Favonius.","teams":"Anemo on-field carry; C6 improves support uptime.","when":"Amplify Wanderer or another Anemo carry with RES reduction and damage buffs.","cond":"ER requirements are much higher before C6.","notes":"","pre":false},{"title":"Accessible Burst Support","role":"Support","weapons":["Favonius Warbow","End of the Line"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"ER Sands and enough CR to trigger Favonius.","teams":"Anemo DPS and regular Burst uptime.","when":"A flexible low-investment support setup when premium weapons are unavailable.","cond":"Use VV mainly when Swirl shred benefits the team.","notes":"","pre":false}],"mats":["Vayuda Turquoise Sliver","Vayuda Turquoise Fragment","Vayuda Turquoise Chunk","Vayuda Turquoise Gemstone","Light Guiding Tetrahedron","Teachings of Admonition","Guide to Admonition","Philosophies of Admonition","Faded Red Satin","Trimmed Red Silk","Rich Red Brocade","Henna Berry","Puppet Strings","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"PawPixl's Team","members":["Faruzan","Wanderer","Nicole","Durin"]},{"name":"She was a Farie","members":["Faruzan","Vesna","Vodyanitsa","Odette"]},{"name":"Bad Dreams","members":["Faruzan","Yumemizuki Mizuki","Odette","Traveler (Cryo)"]},{"name":"Terminal Velocity","members":["Faruzan","Xiao","Xianyun","Furina"]}]}}],"title":"Faruzan","el":"Anemo"}