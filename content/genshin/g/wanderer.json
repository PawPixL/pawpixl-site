uff dependent","Limited AoE"],"weapons":["Tulaytullah's Remembrance","Cashflow Supervision","Skyward Atlas","Kagura's Verity","Solar Pearl","The Widsith","Dodoco Tales","Mappa Mare"],"arts":[{"sets":["Desert Pavilion Chronicle"],"pcs":"4 pcs","role":""},{"sets":["Echoes of an Offering"],"pcs":"4 pcs","role":""},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":""}],"main":["ATK%","Anemo DMG","Crit Rate / Crit DMG"],"stats":["Crit Rate: 70% - 80%","Crit DMG: 160%+","ATK: 2,000+","Energy Recharge: 110% - 130%"],"vars":[{"title":"Anemo Hypercarry","role":"On-field DPS","weapons":["Tulaytullah's Remembrance","Cashflow Supervision","Solar Pearl"],"arts":[{"sets":["Desert Pavilion Chronicle"],"pcs":"4 pcs"},{"sets":["Echoes of an Offering"],"pcs":"4 pcs"}],"stats":"ATK% / Anemo DMG / CRIT; enough ER for desired Burst use.","teams":"Faruzan plus strong buffers and protection.","when":"Focus on sustained airborne Normal and Charged Attacks.","cond":"Needs protection against interruption.","notes":"","pre":false},{"title":"Furina CRIT Setup","role":"On-field DPS","weapons":["Tulaytullah's Remembrance","Cashflow Supervision"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"},{"sets":["Desert Pavilion Chronicle"],"pcs":"4 pcs"}],"stats":"Adjust CRIT Rate around Marechaussee stacks.","teams":"Furina and strong, dependable healing.","when":"Use HP changes to unlock a competitive alternative artifact set.","cond":"No Furina or HP shifts means no reliable set bonus.","notes":"","pre":false}],"mats":["Vayuda Turquoise Sliver","Vayuda Turquoise Fragment","Vayuda Turquoise Chunk","Vayuda Turquoise Gemstone","Perpetual Caliber","Teachings of Praxis","Guide to Praxis","Philosophies of Praxis","Old Handguard","Kageuchi Handguard","Famed Handguard","Rukkhashava Mushrooms","Daka's Bell","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 10 👑"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"na