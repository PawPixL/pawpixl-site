,0.0437],"k":"a"},{"n":"Tenacity of the Millelith","r":[0.5231,0.3133,0.0546,0.0437],"k":"a"},{"n":"Obsidian Codex","r":[0.5231,0.3807,0.0546,0.0437],"k":"a"},{"n":"Kachina","r":[0.0815,0.5319,0.0435,0.0348]},{"n":"Navia","r":[0.1324,0.5319,0.0435,0.0348]},{"n":"Bennett","r":[0.1833,0.5319,0.0435,0.0348]},{"n":"Xiangling","r":[0.2343,0.5319,0.0435,0.0348]},{"n":"Kachina","r":[0.0815,0.5919,0.0435,0.0348]},{"n":"Noelle","r":[0.1324,0.5919,0.0435,0.0348]},{"n":"Gorou","r":[0.1833,0.5919,0.0435,0.0348]},{"n":"Furina","r":[0.2343,0.5919,0.0435,0.0348]},{"n":"Kachina","r":[0.0815,0.6593,0.0435,0.0348]},{"n":"Mualani","r":[0.1324,0.6593,0.0435,0.0348]},{"n":"Xiangling","r":[0.1833,0.6593,0.0435,0.0348]},{"n":"Candace","r":[0.2343,0.6593,0.0435,0.0348]},{"n":"Kachina","r":[0.0815,0.7193,0.0435,0.0348]},{"n":"Ningguang","r":[0.1324,0.7193,0.0435,0.0348]},{"n":"Bennett","r":[0.1833,0.7193,0.0435,0.0348]},{"n":"Fischl","r":[0.2343,0.7193,0.0435,0.0348]}]}]}},"thumb":"content/genshin/builds/kachina/261111-225016/en-1.t.webp","why":{"w":[{"name":"Mountain-Bracing Bolt","text":"Boosts Skill damage and DEF-based hits. For personal damage."},{"name":"Favonius Lance","text":"Generates particles to support the team. Needs CRIT hits."},{"name":"Skyward Spine","text":"Energy Recharge helps Burst uptime."},{"name":"Deathmatch","text":"CRIT Rate and DEF improve damage. Best versus multiple foes."},{"name":"Footprint of the Rainbow","text":"Large DEF boost after using her Skill."},{"name":"Prototype Starglitter","text":"Craftable Energy Recharge stat stick."},{"name":"\"The Catch\"","text":"Helps Burst damage, not her Skill hits."}],"a":[{"names":["Scroll of the Hero of Cinder City"],"text":"Crystallize buffs team damage.","stats":"ER/DEF% · Geo/DEF% · CR/DEF%"},{"names":["Tenacity of the Millelith"],"text":"Skill hits boost team ATK.","stats":"ER/DEF% · Geo · CR"},{"names":["Obsidian Codex"],"text":"For on-field Turbo Twirly damage.","stats":"DEF% · Geo DMG · CRIT"}],"t":[{"name":"Crystal Cannon","members":["Kachina","Navia","Bennett","Xiangling"],"text":"Kachina fuels Navia with Crystallize shards and Scroll buffs; Bennett and Xiangling provide Pyro support.","roles":["Support","Main DPS","Buffer","Sub DPS"]},{"name":"Rock Solid","members":["Kachina","Noelle","Gorou","Furina"],"text":"Kachina buffs Geo damage, Gorou boosts DEF, and Noelle heals the team to support Furina’s damage buff.","roles":["Off-field DPS / Buffer","On-field DPS / Healer","DEF Buffer","Off-field DPS / Buffer"]},{"name":"Surf and Stone","members":["Kachina","Mualani","Xiangling","Candace"],"text":"Kachina can buff Hydro with Scroll; Xiangling supplies Pyro for Mualani’s Vaporizes. Manage aura timing.","roles":["Off-field DPS / Buffer","On-field DPS","Off-field DPS / Pyro Enabler","Hydro Buffer"]},{"name":"Crystal Budget","members":["Kachina","Ningguang","Bennett","Fischl"],"text":"Fischl enables Electro Crystallize for Scroll buffs; Ningguang supplies Geo damage and Bennett boosts ATK.","roles":["Sub DPS","Main DPS","Healer","Sub DPS"]}],"v":"On-field DPS: Obsidian Codex + Footprint; DEF/Geo/CRIT. Ride Turbo Twirly for personal damage.\nTeam Battery: Favonius Lance + Scroll; stack ER and enough CRIT Rate to trigger particles.\nC4 DEF Buff: In multi-target fights, C4 buffs the active character’s DEF inside Burst field.","n":4},"seo":{"roles":["Support","Sub DPS"],"about":"Kachina is a DEF-scaling Geo support whose Turbo Twirly deals off-field damage. She excels at triggering Crystallize to activate Scroll of the Hero of Cinder City, boosting Geo and the reacted element. Favonius Lance supports team Energy.","pros":["Strong Scroll buffs","Off-field Geo hits","F2P-friendly gear","Useful Geo battery"],"cons":["Low personal damage","Small Skill area","Needs Crystallize","Buff requires setup"],"weapons":["Mountain-Bracing Bolt","Favonius Lance","Skyward Spine","Deathmatch","Footprint of the Rainbow","Prototype Starglitter","\"The Catch\""],"arts":[{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs","role":""},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":""},{"sets":["Obsidian Codex"],"pcs":"4 pcs","role":""}],"main":["Energy Recharge / DEF%","Geo DMG / DEF%","Crit Rate / DEF%"],"stats":["ER: 150% - 180%","CR (Fav): 40%+","DEF: 1,600+"],"vars":[{"title":"On-field Turbo Twirly","role":"On-field DPS","weapons":["Footprint of the Rainbow","Mountain-Bracing Bolt","Deathmatch"],"arts":[{"sets":["Obsidian Codex"],"pcs":"4 pcs"}],"stats":"DEF% sands, Geo DMG goblet, CRIT circlet; prioritize DEF and CRIT after needed ER.","teams":"Appreciates Geo battery and DEF buffs such as Gorou.","when":"For players who enjoy riding Turbo Twirly on-field. More personal damage, but generally less team value than Scroll support.","cond":"Needs on-field Nightsoul uptime.","notes":"A fun alternative rather than her strongest overall team contribution.","pre":false},{"title":"Favonius Team Battery","role":"Support","weapons":["Favonius Lance","Prototype Starglitter"],"arts":[{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs"}],"stats":"Build enough CRIT Rate to reliably trigger Favonius on-field; prioritize ER to meet Burst needs.","teams":"Teams where allied Bursts need extra particles.","when":"Use if the team struggles to recharge. Kachina still provides Scroll buffs after triggering Crystallize.","cond":"Favonius passive needs an on-field CRIT hit.","notes":"ER needs vary by team and whether Burst is used every rotation.","pre":false}],"mats":["Prithiva Topaz Sliver","Prithiva Topaz Fragment","Prithiva Topaz Chunk","Prithiva Topaz Gemstone","Overripe Flamegranate","Teachings of Conflict","Guide to Conflict","Philosophies of Conflict","Sentry's Wooden Whistle","Warrior's Metal Whistle","Saurian-Crowned Warrior's Golden Whistle","Quenepa Berry","Fading Candle","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 6-8"}],"teams":[{"name":"Crystal Cannon","members":["Kachina","Navia","Bennett","Xiangling"]},{"name":"Rock Solid","members":["Kachina","Noelle","Gorou","Furina"]},{"name":"Surf and Stone","members":["Kachina","Mualani","Xiangling","Candace"]},{"name":"Crystal Budget","members":["Kachina","Ningguang","Bennett","Fischl"]}]}}],"title":"Kachina","el":"Geo"}