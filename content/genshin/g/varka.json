"n":"Varka","r":[0.0815,0.8526,0.0444,0.0356]},{"n":"Prune","r":[0.1333,0.8526,0.0444,0.0356]},{"n":"Furina","r":[0.1852,0.8526,0.0444,0.0356]},{"n":"Vodyanitsa","r":[0.237,0.8526,0.0444,0.0356]}]}]}},"thumb":"content/genshin/builds/varka/261111-225334/en-1.t.webp","why":{"w":[{"name":"Gest of the Mighty Wolf","text":"Provides CRIT Rate, ATK SPD, and stacking damage buffs that perfectly complement Varka's fast attacks and Hexerei synergy."},{"name":"A Thousand Blazing Suns","text":"Provides CR, ATK, and CD buffs."},{"name":"Beacon of the Reed Sea","text":"CRIT Rate and ATK boosts from Skill hits or taking damage; HP bonus when unshielded."},{"name":"Wolf's Gravestone","text":"Very high ATK and a team ATK buff when hitting low-HP enemies; conditional uptime."},{"name":"Serpent Spine","text":"Provides CR and stacking DMG bonuses."},{"name":"Prototype Archaic","text":"Offers high Base ATK, ATK%."},{"name":"Blackcliff Slasher","text":"CRIT DMG with an ATK bonus after defeating enemies; unreliable against single bosses."},{"name":"Tidal Shadow","text":"Craftable ATK weapon with an additional ATK buff after healing; needs a healer."}],"a":[{"names":["A Day Carved From Rising Winds"],"text":"Gives ATK after attacking and extra CRIT Rate once Witch’s Homework is complete; his best general set.","stats":"ATK% · ATK%/Pyro DMG · CR/CD"},{"names":["Shimenawa's Reminiscence"],"text":"Boosts Normal and Charged Attack damage by 50% after using his Skill, at the cost of 15 Energy.","stats":"ATK% · ATK%/Pyro DMG · CR/CD"},{"names":["Marechaussee Hunter"],"text":"Gain up to 36% CRIT Rate through HP changes. Only effective with reliable HP fluctuation, usually Furina.","stats":"ATK% · DMG% · CD"}],"t":[{"name":"Knight Shift","members":["Varka","Venti","Nicole","Durin"],"text":"Venti groups enemies and shreds resistance, Nicole buffs and shields.","roles":["DPS","Support","Support","Sub DPS"]},{"name":"Prune & Punishment","members":["Varka","Prune","Odette","Escoffier"],"text":"Prune buffs Varka's DMG, Odette enables Stellar Swirl.","roles":["On-field DPS","Anemo Buffer","Cryo Enabler / Buffer","Healer / Debuffer"]},{"name":"Watt the Fischl","members":["Varka","Prune","Ineffa","Fischl"],"text":"Prune boosts Varka's damage while Ineffa and Fischl provide consistent off-field Electro and Lunar-Charged support.","roles":["On-field DPS","Anemo Buffer","Off-field DPS / Shielder","Off-field DPS / Battery"]},{"name":"Category Varka","members":["Varka","Prune","Furina","Vodyanitsa"],"text":"Prune amplifies Varka's DMG, Furina adds Hydro DMG and buffs.","roles":["On-field DPS","Anemo Buffer","Off-field DPS / Buffer","Healer / Buffer"]}],"v":"Pyro Hexerei: Pair Varka with a second Anemo and two Pyro teammates for maximum passive damage. Nicole, Durin, and Bennett are excellent partners.\nHydro Core: Use two Hydro teammates with an Anemo support. Furina and Vodyanitsa offer strong buffs.\nCryo Stellar Swirl: Pair Prune and Odette with another Cryo teammate.\nFurina CRIT Build: Marechaussee Hunter is a strong alternative with Furina.\nAccessible Setup: Use accessible supports and a craftable claymore. Prioritize Skill DMG, balanced CRIT stats.","n":2},"seo":{"roles":["Main DPS"],"about":"Varka is an Anemo on-field DPS built around fast, aggressive combat and reaction driven teams. He shines with strong supports, especially in Stellar Swirl teams.","pros":["Strong personal damage","Fast Gameplay","Stellar Swirl synergy","Flexible teammates"],"cons":["Wants key supports","High Investment","Team reliant damage","Long field time"],"weapons":["Gest of the Mighty Wolf","A Thousand Blazing Suns","Beacon of the Reed Sea","Wolf's Gravestone","Serpent Spine","Prototype Archaic","Blackcliff Slasher","Tidal Shadow"],"arts":[{"sets":["A Day Carved From Rising Winds"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Furina teams"}],"main":["ATK%","ATK% / Element DMG","Crit Rate / Crit DMG"],"stats":["ATK: 2,500–3,000+","CRIT Rate: 60% - 80%","CRIT DMG: 170–200%+"],"vars":[{"title":"Furina CRIT","role":"Main DPS","weapons":["Gest of the Mighty Wolf","Serpent Spine"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"Avoid overcapping CRIT Rate with artifact stacks.","teams":"Furina and reliable HP variation.","when":"Trade Rising Winds for an HP-change CRIT setup.","cond":"","notes":"","pre":false}],"mats":["Vayuda Turquoise Sliver","Vayuda Turquoise Fragment","Vayuda Turquoise Chunk","Vayuda Turquoise Gemstone","Prismatic Severed Tail","Teachings of Freedom","Guide to Freedom","Philosophies of Freedom","Broken Drive Shaft","Reinforced Drive Shaft","Precision Drive Shaft","Wolfhook","Ascended Sample: Rook","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 6+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 6–8"}],"teams":[{"name":"Knight Shift","members":["Varka","Venti","Nicole","Durin"]},{"name":"Prune & Punishment","members":["Varka","Prune","Odette","Escoffier"]},{"name":"Watt the Fischl","members":["Varka","Prune","Ineffa","Fischl"]},{"name":"Category Varka","members":["Varka","Prune","Furina","Vodyanitsa"]}]}}],"title":"Varka","el":"Anemo"}