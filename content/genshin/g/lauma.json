065,0.783,0.05,0.04],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.8348,0.05,0.04],"k":"m"}]},{"img":"content/genshin/builds/lauma/261111-225049/zh-3.webp","t":"content/genshin/builds/lauma/261111-225049/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Nightweaver's Looking Glass","r":[0.1093,0.2537,0.0426,0.0341],"k":"w"},{"n":"Etherlight Spindlelute","r":[0.1093,0.3107,0.0426,0.0341],"k":"w"},{"n":"Silken Moon's Serenade","r":[0.5231,0.267,0.0426,0.0341],"k":"a"},{"n":"Deepwood Memories","r":[0.5231,0.3574,0.0426,0.0341],"k":"a"},{"n":"Gilded Dreams","r":[0.5231,0.4478,0.0426,0.0341],"k":"a"},{"n":"Wanderer's Troupe","r":[0.5713,0.4478,0.0426,0.0341],"k":"a"},{"n":"Lauma","r":[0.0815,0.5674,0.0343,0.0274]},{"n":"Nefer","r":[0.1231,0.5674,0.0343,0.0274]},{"n":"Columbina","r":[0.1648,0.5674,0.0343,0.0274]},{"n":"Nahida","r":[0.2065,0.5674,0.0343,0.0274]},{"n":"Lauma","r":[0.0815,0.6185,0.0343,0.0274]},{"n":"Neuvillette","r":[0.1231,0.6185,0.0343,0.0274]},{"n":"Furina","r":[0.1648,0.6185,0.0343,0.0274]},{"n":"Ineffa","r":[0.2065,0.6185,0.0343,0.0274]},{"n":"Lauma","r":[0.0815,0.6756,0.0343,0.0274]},{"n":"Alhaitham","r":[0.1231,0.6756,0.0343,0.0274]},{"n":"Xingqiu","r":[0.1648,0.6756,0.0343,0.0274]},{"n":"Kuki Shinobu","r":[0.2065,0.6756,0.0343,0.0274]},{"n":"Lauma","r":[0.0815,0.7326,0.0343,0.0274]},{"n":"Aino","r":[0.1231,0.7326,0.0343,0.0274]},{"n":"Xingqiu","r":[0.1648,0.7326,0.0343,0.0274]},{"n":"Kuki Shinobu","r":[0.2065,0.7326,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/lauma/261111-225049/en-1.t.webp","why":{"w":[{"name":"Nightweaver's Looking Glass","text":"Signature EM catalyst granting powerful party bonuses to Bloom, Hyperbloom, Burgeon and Lunar-Bloom."},{"name":"Etherlight Spindlelute","text":"Event ER catalyst with EM after Skill. Good F2P option balancing Burst uptime and reaction support."},{"name":"A Thousand Floating Dreams","text":"Provides 265 EM, with up to 96 additional EM or 30% Element DMG depending on team composition. grants nearby teammates 40 EM."},{"name":"Sunny Morning Sleep-In","text":"Elemental Mastery and reaction-related damage utility; best suited to reaction-centered builds."},{"name":"Starcaller's Watch","text":"Elemental Mastery catalyst that buffs the active character after creating a shield."},{"name":"Blackmarrow Lantern","text":"EM and strong Bloom/Lunar-Bloom bonuses; especially valuable with Ascendant Gleam active."},{"name":"Sacrificial Fragments","text":"Elemental Mastery and a chance to reset Skill cooldown; extra casts depend on Skill hits."},{"name":"Fruit of Fulfillment","text":"Craftable Energy Recharge catalyst that gains EM through reactions while reducing ATK."}],"a":[{"names":["Silken Moon's Serenade"],"text":"Grants 20% ER from its 2-piece bonus. The 4-piece effect provides 60 EM to the entire team and increases Lunar Reaction DMG by 10% per different Gleaming Moon effect. Lauma's best artifact set for supporting Lunar-Bloom teams.","stats":"ER/EM · EM · EM"},{"names":["Deepwood Memories"],"text":"Provides 15% Dendro DMG Bonus and reduces enemies' Dendro RES by 30% for 8s after Lauma's Skill or Burst hits, making it a strong support option for boosting team Dendro damage, particularly when no other teammate carries the set.","stats":"ER/EM · EM · EM"},{"names":["Gilded Dreams","Wanderer's Troupe"],"text":"Provides 160 EM, making this an excellent alternative for maximizing Lauma's Lunar-Bloom buffs and reaction DMG. A strong, flexible combination when farming a dedicated 4-piece set isn't practical.","stats":"ER/EM · EM · EM"}],"t":[{"name":"Celestial Bloom","members":["Lauma","Nefer","Columbina","Nahida"],"text":"Lauma and Nahida supply Dendro and buffs; Columbina enables Lunar-Bloom. The on-field carry capitalizes on their reactions.","roles":["Buffs","Main DPS","Lunar","EM Buffs"]},{"name":"Mossy Water","members":["Lauma","Neuvillette","Furina","Ineffa"],"text":"Neuvillette and Furina provide Hydro damage, while Lauma adds Dendro and reaction support. Ineffa shields and triggers Hyperbloom and Lunar-Charged damage.","roles":["Dendro Buffer / Enabler","On-field DPS","Off-field DPS / Buffer","Off-field DPS / Shielder"]},{"name":"Leaf It Alone","members":["Lauma","Alhaitham","Xingqiu","Kuki Shinobu"],"text":"Alhaitham deals on-field Dendro damage, Xingqiu applies Hydro, and Kuki heals while triggering Hyperbloom. Lauma adds Dendro and reaction support.","roles":["Dendro Buffer / Enabler","On-field DPS","Off-field DPS / Hydro Enabler","Healer / Reaction Trigger"]},{"name":"Four-Star Garden","members":["Lauma","Aino","Xingqiu","Kuki Shinobu"],"text":"Lauma supplies Dendro and buffs, Aino and Xingqiu apply Hydro, and Kuki heals and triggers Hyperbloom. Accessible teammates support a premium Lauma core.","roles":["Dendro Buffer / Enabler","Off-field DPS / Enabler","Off-field DPS / Hydro Enabler","Healer / Reaction Trigger"]}],"v":"Lunar-Bloom Team Buffer: Carry the Lunar team buff while supporting reaction damage.\nDeepwood Dendro Support: Provide Dendro RES shred while maintaining support utility.","n":2},"seo":{"roles":["Buff Support"],"about":"Lauma is a powerful Dendro support specializing in Lunar-Bloom, offering strong reaction buffs, excellent team synergy, and solid off-field utility.","pros":["Massive Lunar-Bloom buffs","Strong Dendro application","Excellent off-field support","Flexible team utility"],"cons":["Less specialized outside Bloom teams","Restricted team synergies","Healing locked behind C1"],"weapons":["Nightweaver's Looking Glass","Etherlight Spindlelute","A Thousand Floating Dreams","Sunny Morning Sleep-In","Starcaller's Watch","Blackmarrow Lantern","Sacrificial Fragments","Fruit of Fulfillment"],"arts":[{"sets":["Silken Moon's Serenade"],"pcs":"4 pcs","role":"Best for Lunar"},{"sets":["Deepwood Memories"],"pcs":"4 pcs","role":"Support"},{"sets":["Gilded Dreams","Wanderer's Troupe"],"pcs":"2 + 2 pcs","role":"Support"}],"main":["Energy Recharge / Elemental Mastery","EM","EM / Crit"],"stats":["Elemental Mastery: 1,000 (with buffs)","Energy Recharge: 160% - 200%","CRIT Rate: 40% - 50% (if Favonius)","CRIT DMG: 100%+ (optional)"],"vars":[{"title":"Lunar-Bloom Team Buffer","role":"Support","weapons":["Nightweaver's Looking Glass","Etherlight Spindlelute","A Thousand Floating Dreams"],"arts":[{"sets":["Silken Moon's Serenade"],"pcs":"4 pcs"}],"stats":"EM and enough ER to maintain abilities.","teams":"Hydro and Dendro teammates able to trigger Lunar-Bloom.","when":"Carry the Lunar team buff while supporting reaction damage.","cond":"Avoid a second Silken Moon holder.","notes":"","pre":false},{"title":"Deepwood Dendro Support","role":"Support","weapons":["Etherlight Spindlelute","A Thousand Floating Dreams","Blackmarrow Lantern"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"}],"stats":"EM first; adjust ER for Burst uptime.","teams":"Dendro damage team with no other Deepwood carrier.","when":"Provide Dendro RES shred while maintaining support utility.","cond":"Use only when Deepwood is not already covered.","notes":"","pre":false}],"mats":["Nagadus Emerald Sliver","Nagadus Emerald Fragment","Nagadus Emerald Chunk","Nagadus Emerald Gemstone","Lightbearing Scale-Feather","Teachings of Moonlight","Guide to Moonlight","Philosophies of Moonlight","Tattered Warrant","Immaculate Warrant","Frost-Etched Warrant","Moonfall Silver","Eroded Scale-Feather","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Celestial Bloom","members":["Lauma","Nefer","Columbina","Nahida"]},{"name":"Mossy Water","members":["Lauma","Neuvillette","Furina","Ineffa"]},{"name":"Leaf It Alone","members":["Lauma","Alhaitham","Xingqiu","Kuki Shinobu"]},{"name":"Four-Star Garden","members":["Lauma","Aino","Xingqiu","Kuki Shinobu"]}]}}],"title":"Lauma","el":"Dendro"}