":"Hu Tao","r":[0.1259,0.6889,0.037,0.0296]},{"n":"Xingqiu","r":[0.1704,0.6889,0.037,0.0296]},{"n":"Zhongli","r":[0.2148,0.6889,0.037,0.0296]},{"n":"Rosaria","r":[0.0815,0.7496,0.037,0.0296]},{"n":"Kaeya","r":[0.1259,0.7496,0.037,0.0296]},{"n":"Xiangling","r":[0.1704,0.7496,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.7496,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/rosaria/261111-225237/en-1.t.webp","why":{"w":[{"name":"Staff of the Scarlet Sands","text":"Provides massive CRIT Rate and converts Elemental Mastery into ATK, making it an exceptional choice for Rosaria's Reverse Melt build."},{"name":"Staff of Homa","text":"Provides substantial CRIT DMG and ATK, making it a powerful universal option for Rosaria's personal damage across multiple team types."},{"name":"Fractured Halo","text":"CRIT DMG and ATK after Skill or Burst. Its Lunar-Charged party bonus requires the wielder to create a shield. Shield-creation passive unavailable."},{"name":"Calamity Queller","text":"High Base ATK and Elemental DMG bonus with stacking ATK after Skill, including off-field."},{"name":"Wavebreaker's Fin","text":"High Base ATK and Burst damage scaling with team Energy costs; better at high refinements."},{"name":"Dragon's Bane","text":"Elemental Mastery and extra damage against Pyro/Hydro-affected enemies; situational."},{"name":"Missive Windspear","text":"Event ATK polearm that raises ATK and EM after triggering reactions."},{"name":"\"The Catch\"","text":"Provides Energy Recharge, Burst DMG, and Burst CRIT Rate, making it a strong free option for Rosaria's Burst-focused damage and support builds."}],"a":[{"names":["Gilded Dreams"],"text":"Strong for Reverse Melt at manageable ER needs; boosts EM and ATK after reactions. Not a universal best set.","stats":"CRIT Rate > CRIT DMG > EM > ER > ATK%"},{"names":["Blizzard Strayer"],"text":"Best in Freeze teams. Grants substantial CRIT Rate against Cryo-affected or Frozen enemies; avoid CRIT overcap.","stats":"CRIT Rate > CRIT DMG > ATK% > ER"},{"names":["Noblesse Oblige"],"text":"Best general team-buff option for ATK-scaling allies when no teammate already uses it.","stats":"CRIT Rate > ER > CRIT DMG > ATK%"}],"t":[{"name":"Melt & Mayhem","members":["Rosaria","Mavuika","Citlali","Bennett"],"text":"Rosaria and Citlali provide Cryo application for Mavuika's Melt reactions. Bennett adds healing, ATK buffs, and Pyro Resonance.","roles":["Off-field DPS / CRIT Buffer","On-field DPS","Shielder / Buffer","Healer / Buffer"]},{"name":"Cryo Queens","members":["Rosaria","Skirk","Furina","Escoffier"],"text":"Rosaria provides additional Cryo damage and CRIT Rate sharing while Furina supplies Hydro application and damage buffs. Escoffier provides healing and Cryo/Hydro RES reduction.","roles":["Off-field DPS / CRIT Buffer","On-field DPS","Off-field DPS / Buffer","Healer / Debuffer"]},{"name":"Ghosts & Vapors","members":["Rosaria","Hu Tao","Xingqiu","Zhongli"],"text":"Xingqiu enables Vaporize while Rosaria adds Cryo application for occasional Melt reactions. Zhongli provides shielding and resistance reduction.","roles":["Off-field DPS / CRIT Buffer","On-field DPS","Off-field DPS / Hydro Enabler","Shielder / Debuffer"]},{"name":"Budget Blizzard","members":["Rosaria","Kaeya","Xiangling","Bennett"],"text":"Rosaria and Kaeya provide consistent Cryo damage and application while Xiangling triggers Reverse Melt. Bennett supplies healing, ATK buffs, and energy support.","roles":["Cryo DPS / Battery","Off-field Cryo DPS","Pyro application","ATK buffer / Healer"]}],"v":"Freeze: Blizzard Strayer, Staff of Homa, ATK%/Cryo DMG/CD\nSupport: Noblesse Oblige, Favonius Lance, ATK%/Cryo DMG/CR. May also use Emblem of Severed Fates artifact set to meet ER needs.","n":4},"seo":{"roles":["Support"],"about":"Rosaria is a Cryo polearm Sub-DPS who provides consistent off-field Cryo damage, strong Burst support, and a valuable CRIT Rate buff for the team. She shares up to 15% CRIT Rate with her passive.","pros":["Off-field Cryo damage","CRIT Rate buff","Low field time","Flexible teams"],"cons":["Limited range","ER hungry","Limited application","Struggles vs. mobile enemies"],"weapons":["Staff of the Scarlet Sands","Staff of Homa","Fractured Halo","Calamity Queller","Wavebreaker's Fin","Dragon's Bane","Missive Windspear","\"The Catch\""],"arts":[{"sets":["Gilded Dreams"],"pcs":"4 pcs","role":"Reverse Melt"},{"sets":["Blizzard Strayer"],"pcs":"4 pcs","role":"Freeze / Sub DPS"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"Support"}],"main":["Elemental Mastery / ATK%","Cryo DMG","Crit Rate / Crit DMG"],"stats":["CR: Tune to team and set","CD: Balance after CR","ER: Depends on rotation","EM: For Reverse Melt"],"vars":[{"title":"Cryo Burst Support","role":"Off-field DPS","weapons":["Staff of Homa","Wavebreaker's Fin"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Blizzard Strayer"],"pcs":"4 pcs"}],"stats":"ER to Burst consistently; CRIT for personal hits and sharing.","teams":"Cryo damage or Physical teams using Cryo application.","when":"Noblesse supports team ATK while her Burst deals Cryo damage.","cond":"CRIT sharing does not apply to all snapshot cases.","notes":"","pre":false},{"title":"Freeze Sub DPS","role":"Off-field DPS","weapons":["Staff of Homa","Wavebreaker's Fin"],"arts":[{"sets":["Blizzard Strayer"],"pcs":"4 pcs"}],"stats":"Balance CRIT around Freeze bonuses and team buffs.","teams":"Hydro plus Cryo teams.","when":"Use Blizzard Strayer for Cryo-affected or Frozen targets.","cond":"Freeze is less reliable versus bosses.","notes":"","pre":false},{"title":"Melt Quickswap","role":"Off-field DPS","weapons":["Staff of the Scarlet Sands","Dragon's Bane"],"arts":[{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM helps only for Rosaria-triggered Melts; balance ER/CRIT.","teams":"Pyro aura and dependable Cryo Burst hits.","when":"Build for Rosaria’s personal reverse Melt damage.","cond":"Reaction ownership changes how much EM is useful.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Hoarfrost Core","Teachings of Ballad","Guide to Ballad","Philosophies of Ballad","Recruit's Insignia","Sergeant's Insignia","Lieutenant's Insignia","Valberry","Shadow of the Warrior","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Melt & Mayhem","members":["Rosaria","Mavuika","Citlali","Bennett"]},{"name":"Cryo Queens","members":["Rosaria","Skirk","Furina","Escoffier"]},{"name":"Ghosts & Vapors","members":["Rosaria","Hu Tao","Xingqiu","Zhongli"]},{"name":"Budget Blizzard","members":["Rosaria","Kaeya","Xiangling","Bennett"]}]}}],"title":"Rosaria","el":"Cryo"}