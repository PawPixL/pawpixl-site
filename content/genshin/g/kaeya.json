:"a"},{"n":"Noblesse Oblige","r":[0.5231,0.3889,0.0491,0.0393],"k":"a"},{"n":"Kaeya","r":[0.0815,0.517,0.0389,0.0311]},{"n":"Chongyun","r":[0.1278,0.517,0.0389,0.0311]},{"n":"Xingqiu","r":[0.1741,0.517,0.0389,0.0311]},{"n":"Sucrose","r":[0.2204,0.517,0.0389,0.0311]},{"n":"Kaeya","r":[0.0815,0.5726,0.0389,0.0311]},{"n":"Rosaria","r":[0.1278,0.5726,0.0389,0.0311]},{"n":"Furina","r":[0.1741,0.5726,0.0389,0.0311]},{"n":"Jean","r":[0.2204,0.5726,0.0389,0.0311]},{"n":"Kaeya","r":[0.0815,0.6356,0.0389,0.0311]},{"n":"Rosaria","r":[0.1278,0.6356,0.0389,0.0311]},{"n":"Xiangling","r":[0.1741,0.6356,0.0389,0.0311]},{"n":"Bennett","r":[0.2204,0.6356,0.0389,0.0311]},{"n":"Kaeya","r":[0.0815,0.6911,0.0389,0.0311]},{"n":"Kamisato Ayaka","r":[0.1278,0.6911,0.0389,0.0311]},{"n":"Sangonomiya Kokomi","r":[0.1741,0.6911,0.0389,0.0311]},{"n":"Kaedehara Kazuha","r":[0.2204,0.6911,0.0389,0.0311]}]}]}},"thumb":"content/genshin/builds/kaeya/261111-225016/en-1.t.webp","why":{"w":[{"name":"Mistsplitter Reforged","text":"High CRIT DMG and elemental damage."},{"name":"Light of Foliar Incision","text":"Strong CRIT DMG stat stick."},{"name":"Haran Geppaku Futsu","text":"CRIT Rate and Normal Attack boosts. Avoid CRIT overcap in Freeze."},{"name":"Primordial Jade Cutter","text":"Huge CRIT Rate and an ATK boost. Avoid CRIT overcap in Freeze."},{"name":"Wolf-Fang","text":"Boosts Skill and Burst damage. Better in Melt builds."},{"name":"Kagotsurube Isshin","text":"Free ATK-focused damage option."},{"name":"Favonius Sword","text":"Energy for Kaeya and his team. Build CRIT Rate to trigger passive."},{"name":"Amenoma Kageuchi","text":"Craftable ATK and energy refund."}],"a":[{"names":["Blizzard Strayer"],"text":"Best against Frozen enemies; grants substantial CRIT Rate.","stats":"ATK% · Cryo DMG · CRIT DMG"},{"names":["Emblem of Severed Fate"],"text":"Reliable Burst damage outside Freeze, especially with high ER.","stats":"ATK% / ER · Cryo DMG · CRIT"},{"names":["Noblesse Oblige"],"text":"Boosts team ATK after Kaeya uses his Burst.","stats":"ER · Cryo DMG · CRIT Rate"}],"t":[{"name":"Frostbound Knights","members":["Kaeya","Chongyun","Xingqiu","Sucrose"],"text":"Chongyun infuses Kaeya’s attacks, Xingqiu enables Freeze, and Sucrose groups enemies and shreds Cryo resistance.","roles":["On-field Cryo DPS","Cryo infusion","Hydro / Off-field DPS","VV / Grouping"]},{"name":"Winter’s Court","members":["Kaeya","Rosaria","Furina","Jean"],"text":"Double Cryo sustains damage and energy; Furina buffs the team while Jean heals and shreds Cryo resistance.","roles":["Cryo DPS","Cryo DPS / Battery","Hydro / Buffer","Healer / VV"]},{"name":"Melting Point","members":["Kaeya","Rosaria","Xiangling","Bennett"],"text":"Xiangling maintains Pyro for Kaeya and Rosaria to Reverse Melt. Bennett boosts ATK and batteries Xiangling.","roles":["Off-field Cryo DPS","Cryo DPS / Battery","Pyro application","ATK buffer / Healer"]},{"name":"Glacial Assist","members":["Kaeya","Kamisato Ayaka","Sangonomiya Kokomi","Kaedehara Kazuha"],"text":"Kaeya batteries Ayaka and contributes Cryo damage; Kokomi enables Freeze and Kazuha groups and buffs.","roles":["Cryo battery / Support","Main DPS","Hydro / Healer","VV / Grouping"]}],"v":"Off-field Burst: Use Emblem with enough ER for every Burst; prioritize Burst over Normal Attack.\nReverse Melt: Use Emblem or Gilded Dreams with Pyro application; add EM after meeting ER needs.\nTeam Support: Favonius Sword + Noblesse; prioritize ER and enough CRIT Rate to trigger particles.\nFreeze CRIT: Blizzard Strayer and Cryo Resonance give up to 55% CRIT Rate against Frozen foes.","n":4},"seo":{"roles":["Main DPS","Sub DPS"],"about":"Kaeya is a flexible Cryo damage dealer who excels in Freeze and quickswap teams. His Burst deals off-field Cryo damage, while his Skill generates energy. Use Blizzard Strayer against freezable enemies; use Emblem or Melt builds when Freeze is unreliable.","pros":["Reliable Cryo application","Strong Freeze battery","Flexible quickswap teams","Free starter character"],"cons":["Short Burst duration","Close-range Burst","Freeze-resistant bosses","Constellations hard to obtain"],"weapons":["Mistsplitter Reforged","Light of Foliar Incision","Haran Geppaku Futsu","Primordial Jade Cutter","Wolf-Fang","Kagotsurube Isshin","Favonius Sword","Amenoma Kageuchi"],"arts":[{"sets":["Blizzard Strayer"],"pcs":"4 pcs","role":"Freeze DPS"},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":"General Burst DPS"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"Team Support"}],"main":["ATK%","Cryo DMG","Crit DMG"],"stats":["CR: 25% - 45%","CD: 150% - 220%","ATK: 1600 - 2100","ER: 120% - 160%"],"vars":[{"title":"Reverse Melt DPS","role":"Off-field DPS","weapons":["Primordial Jade Cutter","Mistsplitter Reforged","Wolf-Fang","Lion's Roar"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Build more ER than Freeze (often 150–190% with double Cryo); EM becomes useful. Use CRIT Rate or DMG circlet.","teams":"Consistent Pyro application, ideally Xiangling + Bennett and a second Cryo damage dealer.","when":"Choose this against bosses or enemies that cannot be Frozen. Melt some of Kaeya’s Burst hits while rotating through teammates.","cond":"Only some Burst hits can trigger Melt.","notes":"ER needs vary widely with teammates and Skill uses.","pre":false},{"title":"Off-field Cryo Support","role":"Support","weapons":["Favonius Sword","Skyward Blade","Amenoma Kageuchi"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"}],"stats":"ER first for Burst uptime, then CRIT Rate for Favonius; personal damage is secondary.","teams":"A Cryo or Pyro on-field carry who values extra Cryo application, particles, or Noblesse buffs.","when":"Use Kaeya as a low-field-time Cryo battery and Burst support rather than a dedicated carry.","cond":"Favonius requires CRIT hits; Noblesse should not duplicate another holder.","notes":"Solo Cryo teams may require substantially more ER.","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Hoarfrost Core","Teachings of Ballad","Guide to Ballad","Philosophies of Ballad","Treasure Hoarder Insignia","Silver Raven Insignia","Golden Raven Insignia","Calla Lily","Spirit Locket of Boreas","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 6+"},{"name":"Elemental Skill","pri":"Level 8-9+"},{"name":"Elemental Burst","pri":"Level 8-9+"}],"teams":[{"name":"Frostbound Knights","members":["Kaeya","Chongyun","Xingqiu","Sucrose"]},{"name":"Winter’s Court","members":["Kaeya","Rosaria","Furina","Jean"]},{"name":"Melting Point","members":["Kaeya","Rosaria","Xiangling","Bennett"]},{"name":"Glacial Assist","members":["Kaeya","Kamisato Ayaka","Sangonomiya Kokomi","Kaedehara Kazuha"]}]}}],"title":"Kaeya","el":"Cryo"}