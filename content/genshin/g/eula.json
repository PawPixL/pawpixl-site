7,0.0343,0.0274]},{"n":"Eula","r":[0.0815,0.5881,0.0343,0.0274]},{"n":"Raiden Shogun","r":[0.1231,0.5881,0.0343,0.0274]},{"n":"Rosaria","r":[0.1648,0.5881,0.0343,0.0274]},{"n":"Zhongli","r":[0.2065,0.5881,0.0343,0.0274]},{"n":"Eula","r":[0.0815,0.6393,0.0343,0.0274]},{"n":"Columbina","r":[0.1231,0.6393,0.0343,0.0274]},{"n":"Ineffa","r":[0.1648,0.6393,0.0343,0.0274]},{"n":"Mika","r":[0.2065,0.6393,0.0343,0.0274]},{"n":"Eula","r":[0.0815,0.6904,0.0343,0.0274]},{"n":"Fischl","r":[0.1231,0.6904,0.0343,0.0274]},{"n":"Diona","r":[0.1648,0.6904,0.0343,0.0274]},{"n":"Lisa","r":[0.2065,0.6904,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/eula/261114-071958/en-1.t.webp","why":{"w":[{"name":"Song of Broken Pines","text":"High base ATK, Physical DMG and team ATK SPD synergize with her Normal Attacks and Lightfall stacking. Reliable all-round signature; speed changes combos."},{"name":"Beacon of the Reed Sea","text":"CR and ATK buffs make this a top contender, sometimes stronger than her signature."},{"name":"Wolf's Gravestone","text":"Huge ATK and an enemy-low-HP team ATK buff strengthen her Burst and Normal Attacks."},{"name":"The Unforged","text":"ATK stat and shield-enhanced ATK stacks offer strong DMG when protected."},{"name":"Skyward Pride","text":"Energy Recharge eases Burst uptime; its vacuum blades add Physical damage during normal attacks. Excellent if struggling to fund her Burst."},{"name":"Serpent Spine","text":"CRIT Rate and stacked DMG bonus provide excellent sustained damage at higher refinements. A shielder helps preserve stacks. High refinement improves value."},{"name":"Akuoumaru","text":"Raises Burst damage based on the party’s combined Energy costs, rewarding Burst-heavy teams. Use in high team-Burst-cost compositions. R5 particularly valuable."},{"name":"Tidal Shadow","text":"Craftable ATK weapon whose passive grants more ATK after Eula receives healing. Requires reliable healing and passive uptime. Refinements improve ATK buff."}],"a":[{"names":["Pale Flame"],"text":"Best general Physical build: Skill hits stack ATK and double the 2-piece Physical DMG bonus.","stats":"ATK% · Physical DMG · CRIT"},{"names":["Pale Flame","Bloodstained Chivalry"],"text":"Unconditional 50% Physical DMG bonus, easier to use when 4-piece Pale Flame stacks are inconsistent.","stats":"ATK% · Physical DMG · CRIT"},{"names":["Marechaussee Hunter"],"text":"With Furina’s HP changes, gains up to 36% CRIT Rate, making damage stats easier to balance.","stats":"ATK% · Physical DMG · CRIT (Furina only)"}],"t":[{"name":"Keomi Fox Vengeance","members":["Eula","Raiden Shogun","Furina","Mika"],"text":"Keomi Fox brings the vengeance! Raiden enables Superconduct and energy; Furina buffs damage; Mika heals and boosts Physical attacks.","roles":["On-field DPS","On-field DPS / Battery","Off-field DPS / Buffer","Healer / Physical Buffer"]},{"name":"Frostbound Retribution","members":["Eula","Raiden Shogun","Rosaria","Zhongli"],"text":"Raiden enables Superconduct, Rosaria supplies Cryo energy and CRIT support, and Zhongli shields Eula during Burst stacking.","roles":["On-field DPS","On-field DPS / Battery","Off-field DPS / CRIT Buffer","Shielder / Debuffer"]},{"name":"Knights of High Heels and Mika","members":["Eula","Columbina","Ineffa","Mika"],"text":"Eula combines powerful Physical damage with off-field Lunar-Charged reactions for a hybrid DPS playstyle.","roles":["On-field DPS","Off-field DPS / Battery","Off-field DPS / CRIT Buffer","Healer / Physical Buffer"]},{"name":"Budget Icebreaker","members":["Eula","Fischl","Diona","Lisa"],"text":"Fischl enables Superconduct; Diona shields, heals, and batteries; Lisa offers DEF reduction with her Burst and Thrilling Tales support.","roles":["On-field DPS","Off-field DPS / Battery","Shielder / Healer","Electro DPS / Debuffer"]}],"v":"Furina CRIT: Use Marechaussee Hunter with Furina and a healer; lower sheet CRIT Rate to account for its 36% bonus.\nShielded Carry: Serpent Spine or The Unforged shines with a strong shielder; prioritize uninterrupted Lightfall stacks.\nEnergy Comfort: Skyward Pride or an ER Sands helps if her Burst is not ready each rotation.\nF2P Physical: Tidal Shadow with a healer offers a craftable option; use Pale Flame and prioritize enough ER.\nLunar Charged:  Eula combines her devastating Physical attacks and Burst damage with Columbina and Ineffa’s off-field Lunar-Charged reactions for a powerful hybrid playstyle.","n":4},"seo":{"roles":["Main DPS"],"about":"Eula is an on-field Physical DPS who builds Lightfall Sword stacks before a massive Burst detonation. Electro teammates enable Superconduct to lower Physical RES, while Cryo batteries help fund her costly Burst. Keep her on-field through the explosion when using Mika’s buffs.","pros":["Huge Burst finishers","Strong Physical attacks","Superconduct synergy","Powerful at C0"],"cons":["Backloaded Burst damage","High energy demands","Burst can miss","Physical-resistant foes"],"weapons":["Song of Broken Pines","Beacon of the Reed Sea","Wolf's Gravestone","The Unforged","Skyward Pride","Serpent Spine","Akuoumaru","Tidal Shadow"],"arts":[{"sets":["Pale Flame"],"pcs":"4 pcs","role":""},{"sets":["Pale Flame","Bloodstained Chivalry"],"pcs":"2 + 2 pcs","role":""},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":""}],"main":["ATK% / Energy Recharge (if needed)","Physical DMG","CRIT Rate / CRIT DMG"],"stats":["CRIT Rate: 65% - 80% (Before buffs)","CRIT DMG: 140% - 200%+","Energy Recharge: 120% - 160%","ATK: 1,800 - 2,400 (Wep dependent)","Marechaussee: ★ 40% - 64%"],"vars":[{"title":"Furina Marechaussee","role":"On-field Physical DPS","weapons":["Song of Broken Pines","Beacon of the Reed Sea","Serpent Spine"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"Target 40–64% sheet CRIT Rate before the 36% set bonus; favor CRIT DMG after reaching effective CRIT cap.","teams":"Furina plus a reliable healer such as Mika; an Electro teammate for Superconduct.","when":"When Furina is on the team and her HP fluctuations reliably maintain Marechaussee Hunter stacks.","cond":"Requires consistent HP changes.","notes":"Mika’s buffs need Eula to stay on-field through the Burst detonation.","pre":false},{"title":"Shielded Physical Carry","role":"On-field Physical DPS","weapons":["The Unforged","Serpent Spine","Song of Broken Pines"],"arts":[{"sets":["Pale Flame"],"pcs":"4 pcs"}],"stats":"Balance ATK and CRIT; ensure enough ER despite the lack of an ER weapon.","teams":"Bring Zhongli, Diona, or another reliable shielder plus an Electro Superconduct enabler.","when":"Best for comfortable Burst stacking and maintaining Serpent Spine stacks or The Unforged shield condition.","cond":"Shield uptime must cover Eula’s combo.","notes":"Shielding improves consistency but does not remove her energy requirements.","pre":false},{"title":"Energy-Friendly Burst","role":"On-field Physical DPS","weapons":["Skyward Pride","Akuoumaru","Tidal Shadow"],"arts":[{"sets":["Pale Flame"],"pcs":"4 pcs"},{"sets":["Pale Flame","Bloodstained Chivalry"],"pcs":"2 + 2 pcs"}],"stats":"Use ER Sands if necessary; often 140–160%+ ER on teams with weak Cryo battery support.","teams":"An Electro teammate and preferably a Cryo battery such as Rosaria or Diona.","when":"When inconsistent Burst uptime is a bigger damage loss than dropping some offensive substats.","cond":"ER varies greatly with teammates and Favonius procs.","notes":"Prioritize getting Burst every rotation over chasing a fixed ATK target.","pre":false},{"title":"Craftable F2P","role":"On-field Physical DPS","weapons":["Tidal Shadow"],"arts":[{"sets":["Pale Flame"],"pcs":"4 pcs"},{"sets":["Pale Flame","Bloodstained Chivalry"],"pcs":"2 + 2 pcs"}],"stats":"ATK% / Physical DMG / CRIT; build ER as needed for consistent Burst uptime.","teams":"A healer to activate Tidal Shadow, Electro for Superconduct, and ideally a Cryo battery.","when":"For low-spender or F2P teams seeking a reliable craftable weapon and accessible teammates.","cond":"Tidal S