"r":[0.1259,0.8511,0.037,0.0296]},{"n":"Bennett","r":[0.1704,0.8511,0.037,0.0296]},{"n":"Xiangling","r":[0.2148,0.8511,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/diona/261111-224858/en-1.t.webp","why":{"w":[{"name":"Favonius Warbow","text":"Generates neutral particles for the whole team. Build CR to trigger its passive on-field."},{"name":"Sacrificial Bow","text":"Can reset her multi-hit Hold Skill for extra Cryo particles and improved shield coverage."},{"name":"Elegy for the End","text":"Provides ER and team ATK/EM buffs when its sigils activate; buff timing can be inconsistent."},{"name":"Breezeborne Refrain","text":"Provides ER and a team Stellar Glimmer DMG buff after using Skill."},{"name":"Recurve Bow","text":"HP% improves her shield and healing, but provides no Energy support for her Burst. Need more ER from artifacts."}],"a":[{"names":["Noblesse Oblige"],"text":"Buffs party ATK after Burst. Best for ATK-scaling carries when nobody else uses Noblesse.","stats":"HP%/ER · HP% · HP%/CR"},{"names":["Tenacity of the Millelith"],"text":"Witch's Revelation follow-up paws can maintain ATK buffs during Cryo Swirl or Superconduct/Stellar reactions.","stats":"HP%/ER · HP% · HP%/CR"},{"names":["Song of Days Past"],"text":"Converts Burst healing into extra damage for the active character when Noblesse is already covered.","stats":"HP%/ER · HP% · HP%/Healing"}],"t":[{"name":"The Purrfect Storm","members":["Diona","Sandrone","Yae Miko","Odette"],"text":"Sandrone drives Stellar-Conduct; Yae supplies Electro and Odette buffs the reaction. C6 Diona shields and buffs from her Burst field.","roles":["Shield / Buffer","Main DPS","Electro DPS","Cryo Support"]},{"name":"Cat-5 Snowstorm","members":["Diona","Vesna","Odette","Faruzan"],"text":"Vesna drives Stellar Swirl, Odette enables and buffs it, and Faruzan boosts Anemo damage. C6 Diona supplies shields and reaction buffs.","roles":["Shield / Buffer","Main DPS","Cryo Support","Anemo Support"]},{"name":"Freeze Frame","members":["Diona","Kamisato Ayaka","Mona","Kaedehara Kazuha"],"text":"Ayaka deals Cryo damage, Mona applies Hydro and boosts Burst damage, and Kazuha groups and shreds Cryo RES. Diona batteries Ayaka.","roles":["Shield / Healer","Main DPS","Hydro Support","Anemo Support"]},{"name":"Melted Ice Cream","members":["Diona","Ganyu","Bennett","Xiangling"],"text":"Diona shields Ganyu's Charged Shots, Bennett buffs ATK, and Xiangling applies Pyro for Reverse Melt. Avoid Diona Burst if it steals Melts.","roles":["Shield","Main DPS","Healer / Buffer","Pyro DPS"]}],"v":"Stellar-Conduct C6: 4pc Tenacity with Witch’s Revelation; shield and buff Sandrone/Cyno teams with Cryo + Electro reactions.\nStellar Swirl C6: 4pc Tenacity and Favonius/Breezeborne; shield Vesna while buffing Stellar Swirl inside Burst.\nCryo Battery: Sacrificial Bow and 4pc Noblesse; double Hold Skill for more Cryo particles and shield coverage.\nHealing Focus: 4pc Song of Days Past and HP%/Healing Bonus; use when another ally carries Noblesse.","n":3},"seo":{"roles":["Shield","Healer"],"about":"Diona is a Cryo support who shields with her Hold Skill, heals with her Burst, and generates Cryo particles. At C6 she grants EM to healthier allies; with Witch's Revelation unlocked, she also buffs Stellar-Conduct and Stellar Swirl teams.","pros":["Reliable Shields","Burst Healing","Cryo Battery","C6 Reaction Buffs"],"cons":["Low Personal DMG","Burst Field Limited","ER Needs Vary","C6 Buff Conditions"],"weapons":["Favonius Warbow","Sacrificial Bow","Elegy for the End","Breezeborne Refrain","Recurve Bow"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"General Support"},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"Stellar Support"},{"sets":["Song of Days Past"],"pcs":"4 pcs","role":"Healing Alternative"}],"main":["HP% / Energy Recharge","HP%","HP% / CRIT Rate (Fav.) / Healing Bonus"],"stats":["ER: 130–150% (C1+, double Cryo/Fav.)","ER: 160–180% (C0, double Cryo/Fav.)","ER: Higher without Cryo battery","HP: 25,000–35,000+","CRIT Rate: Enough for Favonius"],"vars":[{"title":"Stellar-Conduct C6","role":"Shield / Reaction Buffer","weapons":["Breezeborne Refrain","Favonius Warbow","Elegy for the End"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER to Burst reliably, then HP% and Favonius CRIT.","teams":"Stellar-Conduct enabler (Sandrone, Odette or Cryo Traveler), Electro unit and C6 Diona.","when":"Witch’s Revelation follow-up Icy Paws help sustain Tenacity while her C6 Burst area boosts reaction damage.","cond":"C6 + Witch’s Revelation unlocked; active ally in Burst field","notes":"Tenacity uptime has brief gaps; avoid duplicate Noblesse.","pre":false},{"title":"Stellar Swirl C6","role":"Shield / Reaction Buffer","weapons":["Breezeborne Refrain","Favonius Warbow"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER as needed, then HP%; CRIT Rate if Favonius.","teams":"Vesna or Mizuki with Odette/Cryo Traveler; ideally another Anemo buffer.","when":"Protect the Stellar Swirl driver and apply Diona’s C6 reaction bonus while the driver remains inside her Burst.","cond":"C6 + Witch’s Revelation unlocked","notes":"For Mizuki, ensure a separate Stellar Swirl enabler.","pre":false},{"title":"Cryo Battery / Freeze","role":"Shield / Battery","weapons":["Sacrificial Bow","Favonius Warbow"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER until Burst is consistent, then HP% for shields.","teams":"Cryo carry such as Ayaka or Ganyu; Hydro for Freeze teams.","when":"Sacrificial Bow can provide a second Hold Skill and additional Cryo energy for Burst-hungry Cryo damage dealers.","cond":"Sacrificial reset depends on cooldown and rotation","notes":"Diona works at C0; C1 lowers ER demand.","pre":false},{"title":"Healing Focus","role":"Healer / Shield","weapons":["Favonius Warbow","Sacrificial Bow","Recurve Bow"],"arts":[{"sets":["Song of Days Past"],"pcs":"4 pcs"}],"stats":"HP% / HP% / Healing Bonus; get enough ER for Burst.","teams":"A team with another Noblesse holder and a carry who can benefit from healing-based damage.","when":"Trade some shield strength for stronger Burst healing; Song of Days Past adds damage to the active ally.","cond":"Song value depends on healing and rotation","notes":"Healing Bonus improves healing, not the shield.","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Hoarfrost Core","Teachings of Freedom","Guide to Freedom","Philosophies of Freedom","Firm Arrowhead","Sharp Arrowhead","Weathered Arrowhead","Calla Lily","Shard of a Foul Legacy","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1"},{"name":"Elemental Skill","pri":"Level 8–9+"},{"name":"Elemental Burst","pri":"Level 8–9+"}],"teams":[{"name":"The Purrfect Storm","members":["Diona","Sandrone","Yae Miko","Odette"]},{"name":"Cat-5 Snowstorm","members":["Diona","Vesna","Odette","Faruzan"]},{"name":"Freeze Frame","members":["Diona","Kamisato Ayaka","Mona","Kaedehara Kazuha"]},{"name":"Melted Ice Cream","members":["Diona","Ganyu","Bennett","Xiangling"]}]}}],"title":"Diona","el":"Cryo"}