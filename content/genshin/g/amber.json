:[0.5065,0.5019,0.0537,0.043],"k":"a"},{"n":"Scroll of the Hero of Cinder City","r":[0.0815,0.5619,0.0537,0.043],"k":"a"},{"n":"Agnidus Agate Gemstone","r":[0.0815,0.6707,0.0537,0.043],"k":"m"},{"n":"Everflame Seed","r":[0.5065,0.6707,0.0537,0.043],"k":"m"},{"n":"Philosophies of Freedom","r":[0.0815,0.7248,0.0537,0.043],"k":"m"},{"n":"Weathered Arrowhead","r":[0.5065,0.7248,0.0537,0.043],"k":"m"},{"n":"Small Lamp Grass","r":[0.0815,0.7789,0.0537,0.043],"k":"m"},{"n":"Dvalin's Sigh","r":[0.5065,0.7789,0.0537,0.043],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.833,0.0537,0.043],"k":"m"}]},{"img":"content/genshin/builds/amber/261111-224739/zh-3.webp","t":"content/genshin/builds/amber/261111-224739/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Elegy for the End","r":[0.1093,0.2604,0.0472,0.0378],"k":"w"},{"n":"Favonius Warbow","r":[0.1093,0.3507,0.0472,0.0378],"k":"w"},{"n":"Noblesse Oblige","r":[0.5231,0.2456,0.0472,0.0378],"k":"a"},{"n":"Instructor","r":[0.5231,0.3063,0.0472,0.0378],"k":"a"},{"n":"Scroll of the Hero of Cinder City","r":[0.5231,0.3744,0.0472,0.0378],"k":"a"},{"n":"Amber","r":[0.0815,0.4919,0.037,0.0296]},{"n":"Hu Tao","r":[0.1259,0.4919,0.037,0.0296]},{"n":"Xingqiu","r":[0.1704,0.4919,0.037,0.0296]},{"n":"Kaedehara Kazuha","r":[0.2148,0.4919,0.037,0.0296]},{"n":"Amber","r":[0.0815,0.5526,0.037,0.0296]},{"n":"Lyney","r":[0.1259,0.5526,0.037,0.0296]},{"n":"Bennett","r":[0.1704,0.5526,0.037,0.0296]},{"n":"Zhongli","r":[0.2148,0.5526,0.037,0.0296]},{"n":"Amber","r":[0.0815,0.6133,0.037,0.0296]},{"n":"Citlali","r":[0.1259,0.6133,0.037,0.0296]},{"n":"Xilonen","r":[0.1704,0.6133,0.037,0.0296]},{"n":"Bennett","r":[0.2148,0.6133,0.037,0.0296]},{"n":"Amber","r":[0.0815,0.6741,0.037,0.0296]},{"n":"Collei","r":[0.1259,0.6741,0.037,0.0296]},{"n":"Sangonomiya Kokomi","r":[0.1704,0.6741,0.037,0.0296]},{"n":"Rosaria","r":[0.2148,0.6741,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/amber/261111-224739/en-1.t.webp","why":{"w":[{"name":"Elegy for the End","text":"Her rapid-hit Burst stacks Elegy to grant team EM and ATK; its ER substat helps meet demanding Burst needs. Ideal in reaction teams benefiting from EM and ATK."},{"name":"Favonius Warbow","text":"ER and neutral particles help Amber and her team cycle Bursts. Build CRIT Rate and land a field-time CRIT to trigger it. Requires CRIT hits while Amber is on-field. Higher refinements improve proc consistency."},{"name":"The First Great Magic","text":"Provides substantial ER, but the Skill reset is inconsistent because Baron Bunny may explode after Amber has left the field. Use mainly for its ER substat; do not rely on the reset."},{"name":"Skyward Harp","text":"Event bow with ER and a rotating DMG bonus."},{"name":"Sacrificial Bow","text":"Fishing bow with ER and modest extra damage. Practical permanent-access fallback for Burst uptime. Purchased through Sumeru fishing exchange."},{"name":"Fading Twilight","text":"Normal Attacks may group smaller enemies briefly; its CRIT Rate can help Fav-like stat goals, but lacks ER. Paid Battle Pass; only a niche utility choice."}],"a":[{"names":["Noblesse Oblige"],"text":"Reliable 20% party ATK buff after Burst.","stats":"ER · flexible goblet · CRIT Rate (Fav) / flexible"},{"names":["Instructor"],"text":"Reaction-triggered team EM buff.","stats":"ER · flexible · CRIT Rate (Fav)"},{"names":["Scroll of the Hero of Cinder City"],"text":"Situational elemental DMG buff if Amber triggers a relevant reaction; less potent without Nightsoul mechanics.","stats":"ER · flexible · CRIT Rate (Fav)"}],"t":[{"name":"Outrider VV Vape","members":["Amber","Hu Tao","Xingqiu","Kaedehara Kazuha"],"text":"Amber sets up Pyro for Kazuha to Swirl, enabling Pyro RES shred before Hu Tao attacks. Xingqiu enables Vaporize; no dedicated sustain.","roles":["Pyro buffer","Main DPS","Hydro enabler","VV support"]},{"name":"Firework Support Crew","members":["Amber","Lyney","Bennett","Zhongli"],"text":"Triple Pyro supports Lyney. Amber offers Pyro Resonance, Burst utility and possible Elegy/Noblesse buffs; Zhongli protects charged shots.","roles":["Burst buffer","Main DPS","ATK buffer / healer","Shielder"]},{"name":"Outrider Frostfire","members":["Amber","Citlali","Xilonen","Bennett"],"text":"Alternate Melt DPS build: Citlali offers Cryo and protection while Xilonen and Bennett boost Amber’s Charged Shots.","roles":["Melt Charged DPS","Cryo support","RES shred / healer","ATK buffer"]},{"name":"Bunny Bloom Patrol","members":["Amber","Collei","Sangonomiya Kokomi","Rosaria"],"text":"Alternate EM Burgeon build: Collei and Kokomi form Dendro Cores; Rosaria adds Freeze. Aim Pyro shots at cores, not enemies.","roles":["Burgeon trigger","Dendro applier","Hydro / healer","Cryo support"]}],"v":"Melt Charged Shot: 4pc Wanderer’s Troupe; Astral Vulture’s Crimson Plumage or Hamayumi; EM/ATK%, Pyro, CRIT. Normal Attack first.\nC2+ Bunny Bomber: 4pc Crimson Witch; manual Baron Bunny foot detonation at C2. C4 gives a second charge; prioritize Skill.\nBurgeon Trigger: 4pc Flower of Paradise Lost; EM/EM/EM, Level 90. Aim Charged Shots at Dendro Cores; avoid Burst-driven Burning.\nBudget Burst Support: Favonius Warbow and 4pc Noblesse or Instructor; stack ER and CRIT Rate for Favonius.\nReverse Melt Utility: Fast Burst Pyro enables a short Cryo Melt window and shield breaking; requires deliberate team timing.","n":2},"seo":{"roles":["Support / Sub DPS"],"about":"Amber is a flexible Pyro support whose rapid-hit Burst enables Pyro Swirls, shield breaking, and buffs from Elegy or support artifacts. She needs substantial Energy Recharge for frequent Bursts. Her alternate playstyles include C0 Melt Charged Shots, C2+ Baron Bunny detonations, and EM-based Burgeon.","pros":["Fast Burst Pyro application","Great shield breaking","Free starter character","Useful buff options"],"cons":["High Burst ER needs","Short buff setup window","Unreliable Skill particles","Low personal support damage"],"weapons":["Elegy for the End","Favonius Warbow","The First Great Magic","Skyward Harp","Sacrificial Bow","Fading Twilight","End of the Line","The Viridescent Hunt"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""},{"sets":["Instructor"],"pcs":"4 pcs","role":""},{"sets":["Scroll of the Hero of Cinder City"],"pcs":"4 pcs","role":""}],"main":["Energy Recharge","Pyro DMG / HP% (utility)","Crit Rate (Favonius) / Flexible"],"stats":["Energy Recharge (Elegy): 225% - 240% solo baseline","Energy Recharge (Favonius): 165% - 175% solo baseline","Crit Rate (Favonius): ~40% - 60%","Level: 70+ utility / 90 for Burgeon"],"vars":[{"title":"Melt Charged Shot","role":"On-field DPS","weapons":["Astral Vulture's Crimson Plumage","The First Great Magic","Amos' Bow","Hamayumi"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Shimenawa's Reminiscence"],"pcs":"4 pcs"}],"stats":"EM or ATK% / Pyro DMG / CRIT; 150–300 EM as a starting aim; level Normal Attack first.","teams":"Reliable Cryo aura, protection against interruption, and offensive buffs.","when":"For C0+ Amber fans who enjoy aimed-shot Melt; a balanced CRIT build is safer against weak-spotless bosses.","cond":"Accuracy and Cryo uptime matter.","notes":"Shimenawa consumes energy. Hamayumi rewards saving Burst; do not combine those assumptions indiscriminately.","pre":false},{"title":"C2+ Bunny Bomber","role":"Skill DPS","weapons":["Astral Vulture's Crimson Plumage","The First Great Magic","Amos' Bow","Hamayumi"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Build EM/ATK%, Pyro DMG and CRIT; prioritize Skill over Normal Attack as C4+ becomes available.","teams":"Pyro-friendly Melt setup and time to detonate Baron Bunny with fully charged shots at its feet.","when":"Use when you want big manual Baron Bunny detonation damage and AoE.","cond":"C2 required; C4 strongly preferred.","notes":"C2 enables manual foot detonation, and C4 adds a second charge and lowers cooldown.","pre":false},{"title":"Burgeon Trigger","role":"Reaction DPS","weapons":["The Stringless","Cloudforged","King's Squire","Raven Bow"],"arts":[{"sets":["Flower of Paradise Lost"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Level 90; EM/EM/EM with maximum EM. Talent investment is optional; Burst is not part of standard rotation.","teams":"Reliable Dendro Core generation from Hydro + Dendro, plus interruption resistance or Freeze.","when":"Aim Amber’s Charged Shots at Dendro Cores to trigger controlled AoE Burgeon.","cond":"Needs generated cores; avoid aiming at enemies and causing Burning.","notes":"Avoid Burst because heavy Pyro application may prevent Dendro Core production.","pre":false},{"title":"Accessible Burst Utility","role":"Support","weapons":["Favonius Warbow","End of the Line","Sacrificial Bow"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"Prioritize ER; add CRIT Rate if using Favonius. Offensive stats are optional.","teams":"ATK-scaling carry for Noblesse, or reaction-oriented carry for Instructor.","when":"Use when you want Amber’s quick Pyro setup and team buffs without premium weapons.","cond":"Instructor must trigger a reaction while Amber is on-field.","notes":"ER varies widely with Favonius procs; do not assume Burst uptime at low ER.","pre":false},{"title":"Reverse Melt Enabler","role":"Support","weapons":["Elegy for the End","Favonius Warbow"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"Prioritize Burst access with ER; personal damage is secondary.","teams":"Cryo characters that can use a short, rapid Pyro application window.","when":"Use Burst to help set up specific reverse Melt actions or break shields.","cond":"Short Pyro window; not a substitute for sustained off-field Pyro.","notes":"Check rotation timing and aura consistency for the exact team.","pre":false}],"mats":["Agnidus Agate Sliver","Agnidus Agate Fragment","Agnidus Agate Chunk","Agnidus Agate Gemstone","Everflame Seed","Teachings of Freedom","Guide to Freedom","Philosophies of Freedom","Firm Arrowhead","Sharp Arrowhead","Weathered Arrowhead","Small Lamp Grass","Dvalin's Sigh","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 6-8"},{"name":"Elemental Burst","pri":"Level 8-9"}],"teams":[{"name":"Outrider VV Vape","members":["Amber","Hu Tao","Xingqiu","Kaedehara Kazuha"]},{"name":"Firework Support Crew","members":["Amber","Lyney","Bennett","Zhongli"]},{"name":"Outrider Frostfire","members":["Amber","Citlali","Xilonen","Bennett"]},{"name":"Bunny Bloom Patrol","members":["Amber","Collei","Sangonomiya Kokomi","Rosaria"]}]}}],"title":"Amber","el":"Pyro"}