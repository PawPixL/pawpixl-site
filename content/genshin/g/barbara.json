0.043],"k":"m"},{"n":"Cleansing Heart","r":[0.5065,0.6707,0.0537,0.043],"k":"m"},{"n":"Philosophies of Freedom","r":[0.0815,0.7248,0.0537,0.043],"k":"m"},{"n":"Forbidden Curse Scroll","r":[0.5065,0.7248,0.0537,0.043],"k":"m"},{"n":"Philanemo Mushroom","r":[0.0815,0.7789,0.0537,0.043],"k":"m"},{"n":"Ring of Boreas","r":[0.5065,0.7789,0.0537,0.043],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.833,0.0537,0.043],"k":"m"}]},{"img":"content/genshin/builds/barbara/261111-224807/zh-3.webp","t":"content/genshin/builds/barbara/261111-224807/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Thrilling Tales of Dragon Slayers","r":[0.1093,0.2574,0.0426,0.0341],"k":"w"},{"n":"Everlasting Moonglow","r":[0.1093,0.3144,0.0426,0.0341],"k":"w"},{"n":"Prototype Amber","r":[0.1093,0.3715,0.0426,0.0341],"k":"w"},{"n":"Ocean-Hued Clam","r":[0.5231,0.2574,0.0426,0.0341],"k":"a"},{"n":"Song of Days Past","r":[0.5231,0.3278,0.0426,0.0341],"k":"a"},{"n":"Maiden Beloved","r":[0.5231,0.3981,0.0426,0.0341],"k":"a"},{"n":"Barbara","r":[0.0815,0.5111,0.0343,0.0274]},{"n":"Nilou","r":[0.1231,0.5111,0.0343,0.0274]},{"n":"Collei","r":[0.2065,0.5111,0.0343,0.0274]},{"n":"Barbara","r":[0.0815,0.5681,0.0343,0.0274]},{"n":"Nahida","r":[0.1231,0.5681,0.0343,0.0274]},{"n":"Kuki Shinobu","r":[0.1648,0.5681,0.0343,0.0274]},{"n":"Xingqiu","r":[0.2065,0.5681,0.0343,0.0274]},{"n":"Barbara","r":[0.0815,0.6252,0.0343,0.0274]},{"n":"Furina","r":[0.1231,0.6252,0.0343,0.0274]},{"n":"Yelan","r":[0.1648,0.6252,0.0343,0.0274]},{"n":"Kaedehara Kazuha","r":[0.2065,0.6252,0.0343,0.0274]},{"n":"Barbara","r":[0.0815,0.6763,0.0343,0.0274]},{"n":"Fischl","r":[0.1231,0.6763,0.0343,0.0274]},{"n":"Beidou","r":[0.1648,0.6763,0.0343,0.0274]},{"n":"Sucrose","r":[0.2065,0.6763,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/barbara/261111-224807/en-1.t.webp","why":{"w":[{"name":"Thrilling Tales of Dragon Slayers","text":"HP% improves healing, while switching directly to your damage dealer grants a large ATK buff at R5. Best when the next character benefits from ATK. R5 strongly recommended."},{"name":"Everlasting Moonglow","text":"HP% and Healing Bonus increase healing."},{"name":"Prototype Amber","text":"Craftable HP% catalyst that restores party HP and refunds Barbara Energy after using Burst. Useful for frequent emergency healing; passive only triggers on Burst."},{"name":"Favonius Codex","text":"Creates neutral particles after an on-field CRIT, helping the team generate Energy. Needs enough CRIT Rate and an on-field hit to trigger."},{"name":"Sacrificial Fragments","text":"EM helps Bloom damage; Skill damage can reset her long cooldown, improving uptime. On-field Bloom driver; Skill must hit enemies for reset."},{"name":"A Thousand Floating Dreams","text":"Large EM stat supports Barbara-triggered Bloom and provides a small team EM benefit. Bloom-focused driver only; poor value for pure healing."},{"name":"Hakushin Ring","text":"Craftable ER option that can buff reaction elements when on-field Barbara triggers Electro-Charged. Only in teams consistently triggering Electro reactions."}],"a":[{"names":["Ocean-Hued Clam"],"text":"Converts Barbara’s healing into extra Physical bubble damage, adding value beyond pure healing.","stats":"HP% · HP% · Healing Bonus"},{"names":["Song of Days Past"],"text":"Converts healing into a limited damage bonus for an active attacker; useful when the team can exploit it.","stats":"HP% · HP% · Healing Bonus"},{"names":["Maiden Beloved"],"text":"Raises healing output, but often overheals without contributing extra team damage.","stats":"HP% · HP% · Healing Bonus"}],"t":[{"name":"Idol Bloom Brigade","members":["Barbara","Nilou","Traveler (Dendro)","Collei"],"text":"Barbara drives Bountiful Blooms with on-field Hydro while healing their self-damage. Nilou enables enhanced cores; the Dendro duo supplies aura.","roles":["Healer","Bloom Buffer / Hydro Enabler","Dendro Enabler / Battery","Dendro Enabler"]},{"name":"Hyperbloom Harmony","members":["Barbara","Nahida","Kuki Shinobu","Xingqiu"],"text":"Barbara drives with Hydro attacks, Nahida sustains Dendro, and Kuki triggers Hyperblooms. Xingqiu adds reliable off-field Hydro.","roles":["Healer","Dendro Enabler / Buffer","Healer / Reaction Trigger","Off-field DPS / Hydro Enabler"]},{"name":"Hydro Healthcare","members":["Barbara","Furina","Yelan","Kaedehara Kazuha"],"text":"On-field Barbara heals the team to build Furina Fanfare while driving Yelan’s Burst; Kazuha buffs and shreds Hydro resistance.","roles":["Healer","Off-field DPS / Buffer","Off-field DPS / Buffer","Buffer / Debuffer"]},{"name":"Electro Idol Tour","members":["Barbara","Fischl","Beidou","Sucrose"],"text":"Barbara drives Electro-Charged and team healing, Fischl and Beidou add off-field Electro, and Sucrose groups foes and shreds resistance.","roles":["Healer","Off-field DPS / Battery","Off-field DPS","EM Buffer / Debuffer"]}],"v":"Bloom Driver: Sacrificial Fragments, Flower of Paradise Lost or Gilded Dreams; EM/EM/EM with HP or Healing Bonus as needed for survival.\nHyperbloom Driver: Barbara applies Hydro on-field; Kuki triggers the Hyperblooms. Keep Barbara on HP/Healing Bonus or Clam, not full EM.\nElectro-Charged: Ocean-Hued Clam with HP/HP/Healing Bonus; drive Fischl and Beidou while healing and applying Hydro.\nVaporize DPS: Wanderer’s Troupe, EM or ATK%/Hydro DMG/CRIT with a damage catalyst; niche Charged Attack Vaporize build.\nBudget Healer: R5 Thrilling Tales and HP/HP/Healing Bonus; prioritize Skill healing and switch directly to an ATK-scaling carry.","n":3},"seo":{"roles":["Healer / Support"],"about":"Barbara is an accessible Hydro healer who keeps teams healthy through her Skill and emergency teamwide Burst. She can buff an ally with Thrilling Tales or drive Bloom and reaction teams with on-field Hydro attacks. Her Skill's self-Wet application and limited off-field Hydro reach require care.","pros":["Strong teamwide healing","Excellent F2P catalyst","On-field Hydro driver","Emergency Burst healing"],"cons":["Skill can self-apply Wet","Weak off-field Hydro reach","Long Skill cooldown","Burst has high Energy cost"],"weapons":["Thrilling Tales of Dragon Slayers","Everlasting Moonglow","Prototype Amber","Favonius Codex","Sacrificial Fragments","A Thousand Floating Dreams","Hakushin Ring"],"arts":[{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs","role":"Best overall"},{"sets":["Song of Days Past"],"pcs":"4 pcs","role":"Buff alternative"},{"sets":["Maiden Beloved"],"pcs":"4 pcs","role":"Maximum healing"}],"main":["HP%","HP%","Healing Bonus / HP%"],"stats":["HP: 28,000 - 38,000+ (Healer goal)","Energy Recharge: Team-dependent; Burst is optional","CRIT Rate: 40% - 60% (Favonius only)"],"vars":[{"title":"Nilou Bloom Driver","role":"On-field Hydro driver / Healer","weapons":["Sacrificial Fragments","A Thousand Floating Dreams","Prototype Amber"],"arts":[{"sets":["Flower of Paradise Lost"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"Build EM/EM/EM for Bloom damage; replace one or more pieces with HP% or Healing Bonus if healing is insufficient.","teams":"Nilou plus two Dendro or Hydro allies; only Hydro and Dendro party members for Nilou passive.","when":"Use Barbara on-field to apply Hydro, trigger Bountiful Blooms, and heal through self-damage.","cond":"Barbara must trigger Blooms to benefit from her EM.","notes":"Sacrificial Fragments reset requires Skill damage to hit an enemy.","pre":false},{"title":"Hyperbloom Hydro Driver","role":"On-field Hydro driver / Healer","weapons":["Prototype Amber","Thrilling Tales of Dragon Slayers","Favonius Codex"],"arts":[{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs"},{"sets":["Maiden Beloved"],"pcs":"4 pcs"}],"stats":"HP%/HP%/Healing Bonus; Barbara usually does not need EM because the Electro unit triggers Hyperbloom.","teams":"Dendro source, reliable Electro trigger built with EM, and enough Hydro application.","when":"Drive with Barbara’s attacks while an Electro teammate triggers Hyperblooms and Barbara maintains healing.","cond":"EM belongs primarily on the Electro Hyperbloom trigger.","notes":"On-field Barbara helps supplement her limited off-field Hydro application.","pre":false},{"title":"Electro-Charged Clam Driver","role":"On-field Hydro driver / Healer","weapons":["Prototype Amber","Favonius Codex","Hakushin Ring"],"arts":[{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs"},{"sets":["Song of Days Past"],"pcs":"4 pcs"}],"stats":"HP%/HP%/Healing Bonus; prioritize enough healing to support Ocean-Hued Clam bubble damage.","teams":"Off-field Electro damage sources such as Fischl and Beidou.","when":"Keep Barbara on-field using Normal and Charged Attacks for continuous healing, Hydro application, and Clam damage.","cond":"Hakushin Ring requires Barbara to trigger an Electro-related reaction.","notes":"Clam bubble damage is Physical and does not scale with Hydro DMG Bonus.","pre":false},{"title":"Charged Attack Vaporize DPS","role":"On-field DPS","weapons":["A Thousand Floating Dreams","Lost Prayer to the Sacred Winds","The Widsith"],"arts":[{"sets":["Wanderer's Troupe"],"pcs":"4 pcs"},{"sets":["Heart of Depth"],"pcs":"4 pcs"}],"stats":"EM or ATK% Sands / Hydro DMG Goblet / CRIT Circlet; prioritize CRIT, EM, ATK and sufficient stamina.","teams":"Strong off-field Pyro application and buffs to Vaporize Barbara’s Charged Attacks.","when":"A niche high-investment playstyle for players who enjoy carefully timed Hydro Charged Attack Vaporizes.","cond":"Requires reliable Pyro aura and Charged Attack stamina management.","notes":"Normal Attack talent becomes highest priority for this variation.","pre":false},{"title":"Accessible Team Healer","role":"Off-field Healer / Support","weapons":["Thrilling Tales of Dragon Slayers","Prototype Amber"],"arts":[{"sets":["Maiden Beloved"],"pcs":"4 pcs"},{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs"}],"stats":"HP%/HP%/Healing Bonus; ER is optional if Burst remains an emergency heal.","teams":"Works best with an ATK-scaling carry who can immediately follow Barbara for Thrilling Tales buff.","when":"Low-investment setup focused on steady Skill healing, emergency Burst healing, and an easy ATK buff.","cond":"R5 Thrilling Tales is ideal; its buff applies only to the next character switched in.","notes":"Barbara’s Skill does not generate particles and can apply Wet to the active character.","pre":false}],"mats":["Varunada Lazurite Sliver","Varunada Lazurite Fragment","Varunada Lazurite Chunk","Varunada Lazurite Gemstone","Cleansing Heart","Teachings of Freedom","Guide to Freedom","Philosophies of Freedom","Divining Scroll","Sealed Scroll","Forbidden Curse Scroll","Philanemo Mushroom","Ring of Boreas","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 8-9"},{"name":"Elemental Burst","pri":"Level 8-9"}],"teams":[{"name":"Idol Bloom Brigade","members":["Barbara","Nilou","Traveler (Dendro)","Collei"]},{"name":"Hyperbloom Harmony","members":["Barbara","Nahida","Kuki Shinobu","Xingqiu"]},{"name":"Hydro Healthcare","members":["Barbara","Furina","Yelan","Kaedehara Kazuha"]},{"name":"Electro Idol Tour","members":["Barbara","Fischl","Beidou","Sucrose"]}]}}],"title":"Barbara","el":"Hydro"}