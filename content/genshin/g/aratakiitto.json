0.0289]},{"n":"Furina","r":[0.1685,0.7356,0.0361,0.0289]},{"n":"Bennett","r":[0.212,0.7356,0.0361,0.0289]},{"n":"Arataki Itto","r":[0.0815,0.7948,0.0361,0.0289]},{"n":"Gorou","r":[0.125,0.7948,0.0361,0.0289]},{"n":"Albedo","r":[0.1685,0.7948,0.0361,0.0289]},{"n":"Zhongli","r":[0.212,0.7948,0.0361,0.0289]},{"n":"Arataki Itto","r":[0.0815,0.8541,0.0361,0.0289]},{"n":"Gorou","r":[0.125,0.8541,0.0361,0.0289]},{"n":"Kachina","r":[0.1685,0.8541,0.0361,0.0289]},{"n":"Diona","r":[0.212,0.8541,0.0361,0.0289]}]}]}},"thumb":"content/genshin/builds/aratakiitto/261111-224739/en-1.t.webp","why":{"w":[{"name":"Redhorn Stonethresher","text":"Best in slot: huge CD, extra DEF."},{"name":"Serpent Spine","text":"CRIT Rate and stacking DMG Bonus make this an exceptional alternative; at R5 it can approach R1 Redhorn. Protect stacks with a shield. Keep passive stacks active. R5 is especially strong."},{"name":"Skyward Pride","text":"ER helps maintain Burst uptime."},{"name":"Whiteblind","text":"Best craftable choice: DEF% and stacking DEF/ATK increase his Burst damage. Build Normal Attack stacks before Bursting when practical. Accessible alternative. R5 recommended."},{"name":"Blackcliff Slasher","text":"CRIT DMG is useful, but its ATK bonus requires defeating enemies and does little in boss fights. Best against multiple waves."},{"name":"\"Ultimate Overlord's Mega Magic Sword\"","text":"Energy Recharge plus ATK buffs make a comfortable event option; ATK is less valuable than DEF or CRIT for Itto. If already obtained."},{"name":"Tidal Shadow","text":"Craftable ATK% claymore whose ATK buff activates after healing. A fallback if Whiteblind is unavailable. Requires healing."}],"a":[{"names":["Husk of Opulent Dreams"],"text":"His strongest general set: stacks increase DEF and Geo DMG while he deals Geo damage or waits off-field.","stats":"DEF% · Geo DMG · CRIT"},{"names":["Retracing Bolide"],"text":"A viable alternative with 40% Normal and Charged Attack DMG while protected by a shield.","stats":"DEF% · Geo DMG · CRIT"},{"names":["Husk of Opulent Dreams","Archaic Petra"],"text":"Combine DEF% from Husk with Geo DMG from Archaic Petra while farming a complete Husk set.","stats":"DEF% · Geo DMG · CRIT"}],"t":[{"name":"Oni Royalty","members":["Arataki Itto","Gorou","Chiori","Zhongli"],"text":"Gorou supplies DEF and Geo buffs, Chiori deals off-field damage and makes particles, and Zhongli shields and shreds RES for safe Kesagiri combos.","roles":["Main DPS","DEF / Geo Buff","Off-field Geo","Shield / RES Shred"]},{"name":"Oni Goes to Fontaine","members":["Arataki Itto","Xilonen","Furina","Bennett"],"text":"Xilonen heals and shreds Geo RES in this double-Geo setup. Furina boosts team damage, while Bennett adds healing and an ATK buff.","roles":["Main DPS","Geo Shred / Heal","DMG Buff / Hydro","ATK Buff / Heal"]},{"name":"Full House Geo","members":["Arataki Itto","Gorou","Albedo","Zhongli"],"text":"A classic four-Geo shell: Gorou buffs Itto, Albedo adds off-field damage and Geo particles, and Zhongli enables safe, uninterrupted slashes.","roles":["Main DPS","DEF / Geo Buff","Off-field Geo","Shield / RES Shred"]},{"name":"OniFans","members":["Arataki Itto","Gorou","Kachina","Diona"],"text":"Gorou and Kachina give Itto a three-Geo core and more particles. Diona shields and heals, letting him finish his Burst combos safely.","roles":["Main DPS","DEF / Geo Buff","Geo Support","Shield / Heal"]}],"v":"Mono Geo: Pair with Gorou, another Geo damage dealer and a shield. Lower Energy needs and reliable DEF/Geo buffs.\nDouble Geo: With Xilonen, use two non-Geo teammates to activate her RES shred and healing; Furina plus Bennett is a strong option.\nF2P Oni: Whiteblind, Husk, Gorou and Kachina form an accessible core. Add a shielder or healer for comfort.\nBurst Rotation: Prepare team buffs, Burst on Itto, then use Ushi and Normal Attacks to build stacks for Kesagiri. Swapping ends Burst.","n":3},"seo":{"roles":["Main DPS"],"about":"Arataki Itto is an on-field Geo DPS who converts DEF into ATK during his Burst. Build Superlative Superstrength with Normal Attacks and Ushi, then spend stacks on powerful Arataki Kesagiri Charged Attacks. Keep his Burst ready, and finish setting up teammates before he takes the field.","pros":["Strong Geo AoE","DEF scaling damage","Stamina-free slashes","Great with Gorou"],"cons":["Burst dependent","Needs field time","Energy hungry","Geo-focused teams"],"weapons":["Redhorn Stonethresher","Serpent Spine","Skyward Pride","Whiteblind","Blackcliff Slasher","\"Ultimate Overlord's Mega Magic Sword\"","Tidal Shadow"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs","role":"Best"},{"sets":["Retracing Bolide"],"pcs":"4 pcs","role":"Shielded Option"},{"sets":["Husk of Opulent Dreams","Archaic Petra"],"pcs":"2 + 2 pcs","role":"Temporary Mix"}],"main":["DEF%","Geo DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["CRIT Rate: 65% - 80%","CRIT DMG: 140% - 200%+","DEF: 1,800 - 2,400+","ER: 115% - 140% (Geo teams)","ER: Up to 150%+ (Less battery)"],"vars":[{"title":"Double Geo with Xilonen","role":"On-field Geo DPS","weapons":["Redhorn Stonethresher","Whiteblind","Serpent Spine"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"}],"stats":"DEF% remains standard; a DEF% Goblet can compete only with unusually high external DMG buffs. Check ER for the rotation.","teams":"Xilonen plus two Pyro/Hydro/Electro/Cryo teammates, e.g. Furina and Bennett.","when":"Use to access Furina’s team damage bonus and Xilonen’s healing and Geo RES shred while keeping Itto as your main carry.","cond":"Xilonen requires two eligible non-Geo elements for her standard support mode.","notes":"Set up healing and buffs before Itto’s Burst.","pre":false},{"title":"F2P / Craftable","role":"On-field Geo DPS","weapons":["Whiteblind","Tidal Shadow"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"},{"sets":["Husk of Opulent Dreams","Archaic Petra"],"pcs":"2 + 2 pcs"}],"stats":"Prioritize CRIT and ER on artifacts to compensate for Whiteblind’s DEF% stat.","teams":"Gorou and another Geo teammate help charge Burst; bring shields or healing.","when":"A practical low-spend setup that gets strong value from craftable Whiteblind and existing Geo supports.","cond":"Whiteblind stacks its passive through Normal/Charged Attack hits.","notes":"R5 Whiteblind is a strong investment if you already own billets.","pre":false},{"title":"Shielded Kesagiri","role":"On-field Geo DPS","weapons":["Serpent Spine","Redhorn Stonethresher","Whiteblind"],"arts":[{"sets":["Retracing Bolide"],"pcs":"4 pcs"},{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"}],"stats":"Maintain normal DEF / Geo DMG / CRIT main stats; sustain enough ER for each rotation.","teams":"A reliable shielder such as Zhongli or Diona.","when":"Useful when shield comfort matters or you already own strong Retracing Bolide pieces. Husk is preferred for most builds.","cond":"Bolide’s damage bonus only works while shielded. Serpent Spine wants uninterrupted stacks.","notes":"Shield before Itto enters his Burst window.","pre":false}],"mats":["Prithiva Topaz Sliver","Prithiva Topaz Fragment","Prithiva Topaz Chunk","Prithiva Topaz Gemstone","Riftborn Regalia","Teachings of Elegance","Guide to Elegance","Philosophies of Elegance","Slime Condensate","Slime Secretions","Slime Concentrate","Onikabuto","Ashen Heart","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 8-9+"},{"name":"Elemental Skill","pri":"Level 8"},{"name":"Elemental Burst","pri":"Level 8-9+"}],"teams":[{"name":"Oni Royalty","members":["Arataki Itto","Gorou","Chiori","Zhongli"]},{"name":"Oni Goes to Fontaine","members":["Arataki Itto","Xilonen","Furina","Bennett"]},{"name":"Full House Geo","members":["Arataki Itto","Gorou","Albedo","Zhongli"]},{"name":"OniFans","members":["Arataki Itto","Gorou","Kachina","Diona"]}]}}],"title":"Arataki Itto","el":"Geo"}