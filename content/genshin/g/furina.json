/furina/261111-224925/zh-3.webp","t":"content/genshin/builds/furina/261111-224925/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Splendor of Tranquil Waters","r":[0.1093,0.2474,0.0546,0.0437],"k":"w"},{"n":"Key of Khaj-Nisut","r":[0.1093,0.3233,0.0546,0.0437],"k":"w"},{"n":"Primordial Jade Cutter","r":[0.1093,0.3993,0.0546,0.0437],"k":"w"},{"n":"Golden Troupe","r":[0.5231,0.2559,0.0546,0.0437],"k":"a"},{"n":"Tenacity of the Millelith","r":[0.5231,0.3404,0.0546,0.0437],"k":"a"},{"n":"Vourukasha's Glow","r":[0.5231,0.4157,0.0546,0.0437],"k":"a"},{"n":"Heart of Depth","r":[0.5833,0.4157,0.0546,0.0437],"k":"a"},{"n":"Furina","r":[0.0815,0.5315,0.0435,0.0348]},{"n":"Skirk","r":[0.1324,0.5315,0.0435,0.0348]},{"n":"Escoffier","r":[0.1833,0.5315,0.0435,0.0348]},{"n":"Vodyanitsa","r":[0.2343,0.5315,0.0435,0.0348]},{"n":"Furina","r":[0.0815,0.5989,0.0435,0.0348]},{"n":"Navia","r":[0.1324,0.5989,0.0435,0.0348]},{"n":"Columbina","r":[0.1833,0.5989,0.0435,0.0348]},{"n":"Linnea","r":[0.2343,0.5989,0.0435,0.0348]},{"n":"Furina","r":[0.0815,0.6663,0.0435,0.0348]},{"n":"Varesa","r":[0.1324,0.6663,0.0435,0.0348]},{"n":"Xilonen","r":[0.1833,0.6663,0.0435,0.0348]},{"n":"Iansan","r":[0.2343,0.6663,0.0435,0.0348]},{"n":"Furina","r":[0.0815,0.7337,0.0435,0.0348]},{"n":"Lohen","r":[0.1324,0.7337,0.0435,0.0348]},{"n":"Escoffier","r":[0.1833,0.7337,0.0435,0.0348]},{"n":"Mona","r":[0.2343,0.7337,0.0435,0.0348]}]}]}},"thumb":"content/genshin/builds/furina/261111-224925/en-1.t.webp","why":{"w":[{"name":"Splendor of Tranquil Waters","text":"Signature CRIT DMG and Skill damage. Strong for personal damage when team Energy requirements are met."},{"name":"Key of Khaj-Nisut","text":"Key of Khaj-Nisut boosts Furina’s HP and provides additional teamwide EM, strengthening her HP-scaling damage and reaction support."},{"name":"Primordial Jade Cutter","text":"Primordial Jade Cutter provides CRIT Rate and HP, improving Furina’s personal damage and HP-scaling Skill."},{"name":"Favonius Sword","text":"Favonius provides Energy Recharge and generates teamwide particles, helping Furina maintain Burst uptime and support the entire team."},{"name":"The Dockhand's Assistant","text":"Provides HP, then grants Elemental Mastery and restores Energy after using a Skill or Burst with healing stacks."},{"name":"Festering Desire","text":"Budget pick: Energy Recharge plus Skill CRIT Rate and Skill DMG."},{"name":"Fleuve Cendre Ferryman","text":"Free fishing sword: Energy Recharge substat, Skill CRIT Rate, and bonus ER after casting Skill."},{"name":"Wolf-Fang","text":"Gives CRIT Rate and boosts Skill damage. Its stacking CRIT passive is awkward for an off field Furina."}],"a":[{"names":["Golden Troupe"],"text":"Boosts off-field Skill damage substantially. Default choice for personal damage.","stats":"ER/HP% · HP%/Hydro DMG Bonus · CR/CD/HP%"},{"names":["Tenacity of the Millelith"],"text":"Tenacity boosts Furina’s HP and provides a teamwide ATK buff, offering support for ATK-scaling carries at the cost of her personal damage.","stats":""},{"names":["Vourukasha's Glow","Heart of Depth"],"text":"Combines an HP boost with Hydro DMG Bonus to strengthen Furina’s Skill damage.","stats":""}],"t":[{"name":"Fine Dining & Violence","members":["Furina","Skirk","Escoffier","Vodyanitsa"],"text":"Skirk drives on-field Cryo damage, Furina provides Hydro application and DMG buffs, Escoffier shreds Cryo/Hydro RES and heals, and Vodyanitsa adds further RES shred and damage buffs.","roles":["Buffs","Main DPS","Support","Buffs"]},{"name":"Divas & Detonations","members":["Furina","Navia","Columbina","Linnea"],"text":"Navia drives Geo damage, Furina buffs the team and enables Crystallize, Columbina supports Lunar reactions, and Linnea provides healing and Geo buffs.","roles":["Buffs","Main DPS","Lunar","Support"]},{"name":"Furina’s Fitness Club","members":["Furina","Varesa","Xilonen","Iansan"],"text":"Varesa drives Electro damage, Furina provides off-field Hydro and DMG buffs, Xilonen shreds RES and heals, and Iansan boosts ATK and provides additional support.","roles":["Buffs","Main DPS","Support","Buffs"]},{"name":"Lohen Up Places","members":["Furina","Lohen","Escoffier","Mona"],"text":"Lohen drives Freeze damage, Furina provides Hydro and DMG buffs, Escoffier shreds Cryo/Hydro RES and heals, and Mona boosts damage with Omen and Hexerei buffs","roles":["Buffs","Main DPS","Support","Buffs"]}],"v":"Off-field Skill Damage: Prioritize off-field Skill damage and Burst uptime.\nTeam Support: Trade personal damage for team buffs and reliable uptime.","n":3},"seo":{"roles":["Sub DPS and Buffer"],"about":"Furina is a universal buffer and Sub-DPS, boosting nearly all forms of team damage while dealing impressive damage herself. She needs strong healers to quickly build Fanfare.","pros":["High DMG Buffer","Strong Off-field Damage","Powerful Cons"],"cons":["Requires Heals","Drains Teams HP","High ER Needs","Fanfare needs stacking"],"weapons":["Splendor of Tranquil Waters","Key of Khaj-Nisut","Primordial Jade Cutter","Favonius Sword","The Dockhand's Assistant","Festering Desire","Fleuve Cendre Ferryman","Wolf-Fang"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs","role":"Sub DPS"},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"Sub DPS"},{"sets":["Vourukasha's Glow","Heart of Depth"],"pcs":"2 + 2 pcs","role":"Sub DPS"}],"main":["Energy Recharge / HP%","HP% / Hydro DMG Bonus","Crit Rate / Crit DMG / HP%"],"stats":["HP: 35,000 to 40,000","CRIT Rate: 60% to 80%","CRIT DMG: 140% to 200%","Energy Recharge: 130% to 200%+ depending on team"],"vars":[{"title":"Off-field Skill Damage","role":"Off-field DPS","weapons":["Splendor of Tranquil Waters","Primordial Jade Cutter"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs"}],"stats":"HP% / Hydro / CRIT; ER before extra damage.","teams":"Reliable healing to maintain Fanfare.","when":"Prioritize off-field Skill damage and Burst uptime.","cond":"","notes":"","pre":false},{"title":"Team Support","role":"Buffer","weapons":["Key of Khaj-Nisut","Favonius Sword"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"}],"stats":"Build ER and HP to maintain Burst.","teams":"An ally that benefits from ATK or EM buffs, depending on equipment.","when":"Trade personal damage for team buffs and reliable uptime.","cond":"","notes":"","pre":false}],"mats":["Varunada Lazurite Sliver","Varunada Lazurite Fragment","Varunada Lazurite Chunk","Varunada Lazurite Gemstone","Water That Failed To Transcend","Teachings of Justice","Guide to Justice","Philosophies of Justice","Whopperflower Nectar","Shimmering Nectar","Energy Nectar","Lakelight Lily","Lightless Mass","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Soloist's Solicitation","pri":"Level 1+"},{"name":"Salon Solitaire","pri":"Level 9+"},{"name":"Let the People Rejoice","pri":"Level 9+"}],"teams":[{"name":"Fine Dining & Violence","members":["Furina","Skirk","Escoffier","Vodyanitsa"]},{"name":"Divas & Detonations","members":["Furina","Navia","Columbina","Linnea"]},{"name":"Furina’s Fitness Club","members":["Furina","Varesa","Xilonen","Iansan"]},{"name":"Lohen Up Places","members":["Furina","Lohen","Escoffier","Mona"]}]}}],"title":"Furina","el":"Hydro"}