:"content/genshin/builds/shikanoinheizou/261111-225237/en-1.t.webp","why":{"w":[{"name":"Skyward Atlas","text":"High Base ATK and ATK% scaling make Skyward Atlas an excellent DPS weapon for Heizou."},{"name":"Kagura's Verity","text":"High CRIT DMG and stacking Skill damage after using Skill; best with repeated Skill casts."},{"name":"A Thousand Floating Dreams","text":"Provides massive EM and boosts reaction DMG."},{"name":"The Widsith","text":"Provides substantial CD and powerful randomized buffs."},{"name":"Sacrificial Fragments","text":"Elemental Mastery and a chance to reset Skill cooldown; extra casts depend on Skill hits."},{"name":"Solar Pearl","text":"Provides valuable CR and boosts Normal Attack, Skill, and Burst DMG."},{"name":"Mappa Mare","text":"Refines give Elemental Mastery and boost elemental DMG after triggering a reaction."},{"name":"Wandering Evenstar","text":"Battle Pass option that boosts Skill, Burst, and Normal Attack DMG after hits."}],"a":[{"names":["Viridescent Venerer"],"text":"Boosts Swirl DMG and reduces enemies' resistance to the elements Swirled.","stats":"ATK% · Anemo DMG · CR/CD"},{"names":["Golden Troupe"],"text":"Boosts Skill DMG significantly, making it a strong alternative for Heizou's Skill-focused DPS build.","stats":""},{"names":["Viridescent Venerer","Gladiator's Finale"],"text":"Anemo DMG plus ATK for personal damage. Temporary 2-piece mix; 4-piece VV gives better team utility.","stats":""}],"t":[{"name":"The Final Suspect","members":["Shikanoin Heizou","Faruzan","Yelan","Bennett"],"text":"Faruzan amplifies Heizou's Anemo damage while Yelan provides powerful off-field damage and Bennett boosts ATK and provides healing. A strong hypercarry team built around maximizing Heizou's powerful Skill hits.","roles":["Main DPS","Support","Sub DPS","Support"]},{"name":"Anemo Authority","members":["Shikanoin Heizou","Xianyun","Furina","Bennett"],"text":"Xianyun enables powerful Plunging Attacks while boosting their damage, Furina provides off-field Hydro damage and a teamwide DMG bonus, and Bennett adds healing and ATK buffs. A strong plunge-focused Heizou DPS team.","roles":["Main DPS","Support","Buffs","Support"]},{"name":"Anemo-nomicon","members":["Shikanoin Heizou","Fischl","Xingqiu","Ineffa"],"text":"Fischl and Ineffa provide consistent off-field Electro damage while Xingqiu adds Hydro application and defensive utility. Heizou drives powerful Electro-Charged reactions while keeping the team swirling.","roles":["Main DPS","Sub DPS","Sub DPS","Support"]},{"name":"CSI: Mondstadt","members":["Shikanoin Heizou","Xingqiu","Xiangling","Bennett"],"text":"Xingqiu and Xiangling provide powerful off-field Hydro and Pyro damage while Bennett supplies healing and ATK buffs. Heizou drives constant reactions and Swirls, amplifying the team's damage with Viridescent Venerer.","roles":["Main DPS","Sub DPS","Sub DPS","Support"]}],"v":"EM DPS: Viridescent Venerer, Skyward Atlas, EM/EM/EM (Substats prioritize EM and enough ER to burst comfortably)\nAnemo Skill DPS: Build ATK / Anemo DMG / CRIT for personal Skill damage; Swirl itself does not scale with talent levels.","n":3},"seo":{"roles":["Anemo DPS"],"about":"Heizou is an Anemo catalyst DPS who combines rapid attacks with devastating Elemental Skill punches. He excels as an on-field reaction driver or a Skill-focused damage dealer.","pros":["Strong Skill nukes","Excellent reaction driver","Flexible Team Options","Fun playstyle"],"cons":["Requires Skill stacks","Limited crowd control","Limited personal damage ceiling"],"weapons":["Skyward Atlas","Kagura's Verity","A Thousand Floating Dreams","The Widsith","Sacrificial Fragments","Solar Pearl","Mappa Mare","Wandering Evenstar"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs","role":"Anemo DPS"},{"sets":["Golden Troupe"],"pcs":"4 pcs","role":"Quickswap"},{"sets":["Viridescent Venerer","Gladiator's Finale"],"pcs":"2 + 2 pcs","role":"Anemo DPS"}],"main":["EM / ATK%","EM / Anemo DMG","EM / Crit Rate / Crit DMG"],"stats":["CRIT Rate: 65% - 75%","CRIT DMG: 130% - 160%","ATK: 1,800 - 2,200","EM: 100 - 250 (CRIT build)","EM: 700 - 900+ (Swirl build)"],"vars":[{"title":"Anemo Skill Nuke","role":"On-field DPS","weapons":["Skyward Atlas","Kagura's Verity","The Widsith"],"arts":[{"sets":["Golden Troupe"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer","Gladiator's Finale"],"pcs":"2 + 2 pcs"}],"stats":"ATK% / Anemo DMG / CRIT; balance ER.","teams":"Off-field elements to stack Declension.","when":"Focus on his large Elemental Skill hit and personal Anemo damage.","cond":"Golden Troupe benefits Skill hits, not his whole kit.","notes":"","pre":false},{"title":"Swirl Driver","role":"On-field Driver","weapons":["A Thousand Floating Dreams","Sacrificial Fragments"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"EM main stats and sufficient ER; CRIT secondary.","teams":"Off-field damage dealers and Swirlable auras.","when":"Use Viridescent Venerer to amplify teammates through Swirl.","cond":"Needs elements that can be Swirled.","notes":"","pre":false}],"mats":["Vayuda Turquoise Sliver","Vayuda Turquoise Fragment","Vayuda Turquoise Chunk","Vayuda Turquoise Gemstone","Runic Fang","Teachings of Transience","Guide to Transience","Philosophies of Transience","Treasure Hoarder Insignia","Silver Raven Insignia","Golden Raven Insignia","Onikabuto","The Meaning of Aeons","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 9+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 8+"}],"teams":[{"name":"The Final Suspect","members":["Shikanoin Heizou","Faruzan","Yelan","Bennett"]},{"name":"Anemo Authority","members":["Shikanoin Heizou","Xianyun","Furina","Bennett"]},{"name":"Anemo-nomicon","members":["Shikanoin Heizou","Fischl","Xingqiu","Ineffa"]},{"name":"CSI: Mondstadt","members":["Shikanoin Heizou","Xingqiu","Xiangling","Bennett"]}]}}],"title":"Shikanoin Heizou","el":"Anemo"}