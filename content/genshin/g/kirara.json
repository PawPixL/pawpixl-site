llelith","r":[0.0815,0.4389,0.0472,0.0378],"k":"a"},{"n":"Vourukasha's Glow","r":[0.1343,0.4389,0.0472,0.0378],"k":"a"},{"n":"Instructor","r":[0.0815,0.4996,0.0472,0.0378],"k":"a"},{"n":"Deepwood Memories","r":[0.0815,0.5604,0.0472,0.0378],"k":"a"},{"n":"Kirara","r":[0.0815,0.6704,0.037,0.0296]},{"n":"Keqing","r":[0.1259,0.6704,0.037,0.0296]},{"n":"Fischl","r":[0.1704,0.6704,0.037,0.0296]},{"n":"Kaedehara Kazuha","r":[0.2148,0.6704,0.037,0.0296]},{"n":"Kirara","r":[0.0815,0.7244,0.037,0.0296]},{"n":"Tighnari","r":[0.1259,0.7244,0.037,0.0296]},{"n":"Yae Miko","r":[0.1704,0.7244,0.037,0.0296]},{"n":"Nahida","r":[0.2148,0.7244,0.037,0.0296]},{"n":"Kirara","r":[0.0815,0.7852,0.037,0.0296]},{"n":"Nilou","r":[0.1259,0.7852,0.037,0.0296]},{"n":"Nahida","r":[0.1704,0.7852,0.037,0.0296]},{"n":"Sangonomiya Kokomi","r":[0.2148,0.7852,0.037,0.0296]},{"n":"Kirara","r":[0.0815,0.8459,0.037,0.0296]},{"n":"Lisa","r":[0.1259,0.8459,0.037,0.0296]},{"n":"Fischl","r":[0.1704,0.8459,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/kirara/261111-225049/en-1.t.webp","why":{"w":[{"name":"Key of Khaj-Nisut","text":"Massive HP boosts shield strength. Skill hits can grant the team an EM buff based on Kirara’s HP."},{"name":"The Dockhand's Assistant","text":"Its HP secondary stat strengthens Kirara’s shield."},{"name":"Freedom-Sworn","text":"Can provide teamwide Normal, Charged, and Plunging Attack DMG and ATK buffs after Kirara triggers reactions."},{"name":"Primordial Jade Cutter","text":"Provides CRIT Rate and a modest HP bonus. Better for personal damage than pure shield utility. Use for a hybrid damage build."},{"name":"Favonius Sword","text":"Generates neutral Energy particles to help the whole team recharge. Build enough CR to trigger its passive. Favonius must CRIT while Kirara is on field."},{"name":"Sacrificial Sword","text":"Can reset her Skill cooldown for another shield refresh and extra Dendro particles. Passive needs a Skill hit to trigger."},{"name":"Xiphos' Moonlight","text":"Offers team Energy Recharge based on Kirara’s EM, though a shield build usually stacks HP instead. More useful with some EM investment."},{"name":"Sapwood Blade","text":"Craftable sword with ER. Dendro reactions create a leaf that one teammate can collect for an EM buff. A teammate must pick up the leaf."}],"a":[{"names":["Tenacity of the Millelith","Vourukasha's Glow"],"text":"Two HP bonuses strengthen Kirara’s shield without relying on reaction timing or Burst uptime.","stats":"HP% / HP% / HP%"},{"names":["Instructor"],"text":"Triggering a reaction grants teammates EM.","stats":"HP% / HP% / HP%"},{"names":["Deepwood Memories"],"text":"Reduces enemy Dendro resistance after Skill or Burst hits.","stats":"HP% / HP% / HP%"}],"t":[{"name":"Lightning Delivery","members":["Kirara","Keqing","Fischl","Kaedehara Kazuha"],"text":"Keqing and Fischl trigger Aggravate while Kazuha groups and buffs Electro damage. Kirara provides shielding and Quicken support.","roles":["Shielder / Dendro Enabler","On-field DPS","Off-field DPS / Battery","Buffer / Debuffer"]},{"name":"Forest Express","members":["Kirara","Tighnari","Yae Miko","Nahida"],"text":"Tighnari deals Spread damage with support from Nahida and Yae Miko. Kirara shields him and generates extra Dendro particles.","roles":["Shielder / Dendro Enabler","Quickswap DPS","Off-field DPS","Dendro Enabler / Buffer"]},{"name":"Bloom Delivery","members":["Kirara","Nilou","Nahida","Sangonomiya Kokomi"],"text":"Nilou enables Bountiful Cores. Nahida supplies Dendro, Kokomi applies Hydro and heals, and Kirara shields against Bloom damage.","roles":["Shielder / Dendro Enabler","Bloom Buffer / Hydro Enabler","Dendro Enabler / Buffer","Healer / Hydro Enabler"]},{"name":"Budget Courier","members":["Kirara","Lisa","Fischl","Traveler (Dendro)"],"text":"Lisa and Fischl deal Aggravate damage. Dendro Traveler maintains Quicken while Kirara protects the team with her shield.","roles":["Shielder / Dendro Enabler","Electro DPS / Debuffer","Off-field DPS / Battery","Dendro Enabler / Battery"]}],"v":"Full Shield: Use two HP sets and triple HP main stats for the strongest general shield.\nTeam Buff: Instructor adds team EM after Kirara triggers a reaction. Expect a weaker shield from four-star artifacts.\nDendro Shred: Choose Deepwood when a Dendro damage dealer needs resistance reduction and no one else carries the set.\nFavonius Support: Use a CRIT Rate circlet if needed to reliably generate Energy particles with Favonius Sword.","n":3},"seo":{"roles":["Support / Shielder"],"about":"Kirara is a Dendro shielder who protects teammates with her HP-scaling Skill. She excels in quickswap Quicken teams & can support Bloom teams with a second Dendro applier. Her shield is especially effective against Dendro DMG, & her parcel form makes exploration easier.","pros":["Strong Dendro shield","Short Skill cooldown","Great for Quicken","Excellent exploration"],"cons":["No healing","Limited off-field Dendro","Needs HP for shielding","Burst damage is modest"],"weapons":["Key of Khaj-Nisut","The Dockhand's Assistant","Freedom-Sworn","Primordial Jade Cutter","Favonius Sword","Sacrificial Sword","Xiphos' Moonlight","Sapwood Blade"],"arts":[{"sets":["Tenacity of the Millelith","Vourukasha's Glow"],"pcs":"2 + 2 pcs","role":"Shield Strength"},{"sets":["Instructor"],"pcs":"4 pcs","role":"Team EM"},{"sets":["Deepwood Memories"],"pcs":"4 pcs","role":"Dendro Support"}],"main":["HP%","HP%","HP% / CRIT Rate (Favonius)"],"stats":["HP: 35,000 - 45,000","ER: 100% - 120% (Double Dendro)","ER: 120% - 160% (Solo Dendro)","CRIT Rate: 30% - 50% (Favonius)"],"vars":[{"title":"Maximum Shield","role":"Support","weapons":["Key of Khaj-Nisut","The Dockhand's Assistant"],"arts":[{"sets":["Tenacity of the Millelith","Vourukasha's Glow"],"pcs":"2 + 2 pcs"}],"stats":"Stack HP%; ER only if using Burst regularly.","teams":"Teams needing interruption protection.","when":"Choose this when shield strength matters more than damage.","cond":"Skill hold can extend field time.","notes":"","pre":false},{"title":"Instructor Quicken Buffer","role":"Support","weapons":["Favonius Sword","Sacrificial Sword"],"arts":[{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"HP% main stats; sufficient ER and Favonius CR.","teams":"Quicken team that can reliably trigger a reaction.","when":"Trade some shield strength for an EM team buff.","cond":"Instructor is a four-star set with lower stat ceilings.","notes":"","pre":false},{"title":"Deepwood Shield Support","role":"Support","weapons":["Favonius Sword","The Dockhand's Assistant"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"}],"stats":"HP% first; ER/CR for utility.","teams":"Dendro damage team without another Deepwood holder.","when":"Combine protection with Dendro resistance reduction.","cond":"Needs Skill hits to maintain shred.","notes":"","pre":false}],"mats":["Nagadus Emerald Sliver","Nagadus Emerald Fragment","Nagadus Emerald Chunk","Nagadus Emerald Gemstone","Evergloom Ring","Teachings of Transience","Guide to Transience","Philosophies of Transience","Spectral Husk","Spectral Heart","Spectral Nucleus","Amakumo Fruit","Everamber","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 6–8"}],"teams":[{"name":"Lightning Delivery","members":["Kirara","Keqing","Fischl","Kaedehara Kazuha"]},{"name":"Forest Express","members":["Kirara","Tighnari","Yae Miko","Nahida"]},{"name":"Bloom Delivery","members":["Kirara","Nilou","Nahida","Sangonomiya Kokomi"]},{"name":"Budget Courier","members":["Kirara","Lisa","Fischl","Traveler (Dendro)"]}]}}],"title":"Kirara","el":"Dendro"}