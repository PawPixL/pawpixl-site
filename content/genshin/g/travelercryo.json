96,0.0463,0.037],"k":"w"},{"n":"Primordial Jade Cutter","r":[0.1093,0.3704,0.0463,0.037],"k":"w"},{"n":"Disenchantment in Deep Shadow","r":[0.5231,0.2563,0.0463,0.037],"k":"a"},{"n":"Heart of the Furnace","r":[0.5231,0.3319,0.0463,0.037],"k":"a"},{"n":"Tenacity of the Millelith","r":[0.5231,0.4074,0.0463,0.037],"k":"a"},{"n":"Yae Miko","r":[0.1259,0.5244,0.037,0.0296]},{"n":"Odette","r":[0.1704,0.5244,0.037,0.0296]},{"n":"Escoffier","r":[0.2148,0.5244,0.037,0.0296]},{"n":"Yae Miko","r":[0.1259,0.5852,0.037,0.0296]},{"n":"Odette","r":[0.1704,0.5852,0.037,0.0296]},{"n":"Alyosha","r":[0.2148,0.5852,0.037,0.0296]},{"n":"Yumemizuki Mizuki","r":[0.1259,0.6385,0.037,0.0296]},{"n":"Sucrose","r":[0.1704,0.6385,0.037,0.0296]},{"n":"Odette","r":[0.2148,0.6385,0.037,0.0296]},{"n":"Fischl","r":[0.1259,0.6993,0.037,0.0296]},{"n":"Rosaria","r":[0.1704,0.6993,0.037,0.0296]},{"n":"Diona","r":[0.2148,0.6993,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/travelercryo/261121-103943/en-1.t.webp","why":{"w":[{"name":"Exaiphanes Blade","text":"The Traveler’s free exclusive sword adds CR, ATK & Energy restoration."},{"name":"Whitelake Frostfeather","text":"Provides strong offensive stats & excellent Stellar DMG potential, although the free Exaiphanes Blade competes closely."},{"name":"Primordial Jade Cutter","text":"Grants a large amount of CR & converts some HP into ATK. Watch for CR overcapping."},{"name":"Uraku Misugiri","text":"Offers abundant CRIT DMG, but much of its passive is less useful for the Traveler’s main Stellar damage."},{"name":"Emberwell","text":"Craftable sword that grants EM & improves ATK & Stellar DMG after triggering reactions. Use in Stellar reaction teams. Higher refinements improve its value."},{"name":"Harbinger of Dawn","text":"An inexpensive CRIT stat option when health stays high, but its low Base ATK limits Stellar damage. Keep HP above the passive threshold."},{"name":"Favonius Sword","text":"ER and team particles on CRIT. Sacrifices personal damage for team Energy support."}],"a":[{"names":["Disenchantment in Deep Shadow"],"text":"Best personal DMG set for on-field Stellar-Conduct. Boosts reaction DMG & grants conditional CR.","stats":"ATK% / ATK% / CRIT"},{"names":["Heart of the Furnace"],"text":"Boosts team Stellar DMG after the wearer deals Stellar DMG. Useful when another teammate is not already wearing it.","stats":"ATK% / ATK% / CRIT"},{"names":["Tenacity of the Millelith"],"text":"Off-field Skill hits grant teammates an ATK buff. A practical support alternative in Stellar Swirl teams.","stats":"ATK% / ATK% / CRIT"}],"t":[{"name":"Frostbound Scholars","members":["Traveler (Cryo)","Yae Miko","Odette","Escoffier"],"text":"Yae supplies Electro for Stellar-Conduct, Odette raises Stellar damage, and Escoffier keeps the team healthy/Res Shred while Traveler stays on the field.","roles":["Main DPS","Sub DPS","Support","Healer"]},{"name":"Frost and Thunder","members":["Traveler (Cryo)","Yae Miko","Odette","Alyosha"],"text":"Yae and Odette boost Stellar-Conduct damage while Alyosha offers healing and extra buffs. Traveler uses field time to build Frostglow.","roles":["Main DPS","Sub DPS","Support","Healer"]},{"name":"Swirl Society","members":["Traveler (Cryo)","Yumemizuki Mizuki","Sucrose","Odette"],"text":"Mizuki drives Stellar Swirl while Traveler supplies Cryo and Burst damage. Odette boosts Stellar reactions and Sucrose adds grouping and EM.","roles":["Sub DPS","Main DPS","Support","Support"]},{"name":"Budget Blizzard","members":["Traveler (Cryo)","Fischl","Rosaria","Diona"],"text":"Fischl applies Electro for Stellar-Conduct while Rosaria adds Cryo damage. Diona provides shields and healing for a budget option.","roles":["Main DPS","Sub DPS","Sub DPS","Healer"]}],"v":"On-field Conduct: Use Disenchantment and stay on the field to build Frostglow through coordinated attacks. Finish with your enhanced Charged Attack and Burst.\nOff-field Swirl: Use Heart of the Furnace or Tenacity when another Anemo character drives Stellar Swirl. Cast Skill and Burst during their rotation.\nCRIT Rate caution: Account for conditional CRIT bonuses from the artifact set, Cryo Resonance and Traveler passives before chasing more CRIT Rate.\nWeapon investment: Exaiphanes Blade is free and often better than premium swords. You do not need to pull a five star weapon for this build.","n":3},"seo":{"roles":["Main DPS / Sub DPS"],"about":"Cryo Traveler is a flexible Cryo DMG dealer who powers Stellar-Conduct & Stellar Swirl teams. They fight on the field in Stellar-Conduct & offer off-field DMG in Stellar Swirl. Their strongest attacks rely on building Frostglow stacks before using their Burst.","pros":["Excellent free weapon","Flexible team roles","Strong Stellar damage","Free constellations"],"cons":["Needs Stellar teammates","Frostglow setup required","Limited team flexibility","CRIT can overcap"],"weapons":["Exaiphanes Blade","Whitelake Frostfeather","Primordial Jade Cutter","Uraku Misugiri","Emberwell","Harbinger of Dawn","Favonius Sword"],"arts":[{"sets":["Disenchantment in Deep Shadow"],"pcs":"4 pcs","role":"Best Stellar-Conduct"},{"sets":["Heart of the Furnace"],"pcs":"4 pcs","role":"Stellar Swirl Support"},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"Team Support"}],"main":["ATK%","ATK%","CRIT DMG / CRIT Rate"],"stats":["ATK: 2,000+","CRIT Rate: 60% - 80%","CRIT DMG: 160%+","Elemental Mastery: 150 - 250","Energy Recharge: 100% - 140%"],"vars":[{"title":"On-field Conduct DPS","role":"On-field DPS","weapons":["Exaiphanes Blade","Primordial Jade Cutter"],"arts":[{"sets":["Disenchantment in Deep Shadow"],"pcs":"4 pcs"}],"stats":"Balance CRIT and relevant scaling; meet Burst needs.","teams":"Electro teammate to enable Stellar-Conduct.","when":"Use on-field Cryo attacks in a dedicated Conduct team.","cond":"Specific reaction setup required.","notes":"","pre":false},{"title":"Off-field Conduct Utility","role":"Off-field DPS / Support","weapons":["Whitelake Frostfeather","Emberwell"],"arts":[{"sets":["Heart of the Furnace"],"pcs":"4 pcs"},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"}],"stats":"ER to maintain off-field application; personal damage secondary.","teams":"Electro teammate and another active carry.","when":"Provide Cryo application and team utility rather than on-field time.","cond":"Set choice depends on whether another ally holds the buff.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","","","","","","","","","","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Foreign Frostglint","pri":"Level 8+"},{"name":"Ice Fog Piercer","pri":"Level 1 - 6"},{"name":"Frostbound Javelin","pri":"Level 9+"}],"teams":[{"name":"Frostbound Scholars","members":["Traveler (Cryo)","Yae Miko","Odette","Escoffier"]},{"name":"Frost and Thunder","members":["Traveler (Cryo)","Yae Miko","Odette","Alyosha"]},{"name":"Swirl Society","members":["Traveler (Cryo)","Yumemizuki Mizuki","Sucrose","Odette"]},{"name":"Budget Blizzard","members":["Traveler (Cryo)","Fischl","Rosaria","Diona"]}]}}],"title":"Traveler (Cryo)","el":"Cryo"}