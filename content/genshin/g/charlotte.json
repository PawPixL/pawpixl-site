0.0389,0.0311]}]}]}},"thumb":"content/genshin/builds/charlotte/261111-224807/en-1.t.webp","why":{"w":[{"name":"Favonius Codex","text":"ER and team particles support her costly Burst. Enough CR to trigger passive."},{"name":"Kagura's Verity","text":"CRIT DMG and Skill DMG for niche damage builds; meet ER first."},{"name":"Prototype Amber","text":"Best general healing option, with extra team healing and Energy refund."},{"name":"Flowing Purity","text":"ATK and conditional DMG; no extra Energy or team buff."},{"name":"Thrilling Tales of Dragon Slayers","text":"Strong ATK buff for the next teammate, but does not help her ER. Only if Burst uptime is secure."},{"name":"Oathsworn Eye","text":"Event catalyst: ATK aids healing and Skill use grants ER."}],"a":[{"names":["Noblesse Oblige"],"text":"Team ATK buff after Burst; best for teams that appreciate ATK.","stats":"ER/ATK% · ATK% · Healing Bonus/ATK%/CR"},{"names":["Tenacity of the Millelith"],"text":"Buffs team ATK from off-field Skill hits. Hold Skill helps maintain uptime.","stats":""},{"names":["Ocean-Hued Clam"],"text":"Turns healing into damage; useful when buffs are already covered.","stats":""}],"t":[{"name":"Frozen Verdict","members":["Charlotte","Neuvillette","Kaedehara Kazuha","Furina"],"text":"Charlotte provides teamwide healing and Freeze utility while Furina buffs the team's damage.","roles":["Healer / Cryo Enabler","On-field DPS","Buffer / Debuffer","Off-field DPS / Buffer"]},{"name":"Frozen Assets","members":["Charlotte","Skirk","Escoffier","Furina"],"text":"Skirk deals Cryo damage while Furina buffs the team.","roles":["Healer / Cryo Enabler","On-field DPS","Healer / Debuffer","Off-field DPS / Buffer"]},{"name":"Shiver Me Timbers","members":["Charlotte","Kamisato Ayaka","Kaedehara Kazuha","Furina"],"text":"Charlotte supplies healing and Cryo Resonance while Furina provides Hydro application and damage buffs.","roles":["Healer / Cryo Enabler","On-field DPS","Buffer / Debuffer","Off-field DPS / Buffer"]},{"name":"Budget Blizzard","members":["Charlotte","Kaeya","Xingqiu","Sucrose"],"text":"An accessible Freeze team with Kaeya as the on-field damage dealer.","roles":["Healer / Cryo Enabler","On-field DPS","Off-field DPS / Hydro Enabler","EM Buffer / Debuffer"]}],"v":"Furina Team Healer: Use for strong teamwide healing and Furina synergy while maintaining Burst uptime.\nBattery / ATK Buff: Choose Favonius to battery the team or TTDS for a powerful swap-in ATK buff when energy allows.\nFreeze Utility: Use for Cryo application, emergency healing and flexible support in Freeze teams.","n":4},"seo":{"roles":["Support"],"about":"Charlotte is a Cryo catalyst healer who provides powerful teamwide healing, off-field Cryo application, and support utility. She excels in Freeze teams and works particularly well alongside Furina.","pros":["Teamwide healing","Off-field Cryo","Great with Furina","Flexible support"],"cons":["High ER needs","Burst-based healing","Low personal damage","Uneven Cryo uptime"],"weapons":["Favonius Codex","Kagura's Verity","Prototype Amber","Flowing Purity","Thrilling Tales of Dragon Slayers","Oathsworn Eye"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"Support"},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"Support"},{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs","role":"Healing"}],"main":["ATK% / ER","ATK%","Healing / CR / ATK%"],"stats":["ER: 160–230%+","ATK: Healing","CR: Favonius only"],"vars":[{"title":"Furina Team Healer","role":"Healer / Support","weapons":["Prototype Amber","Favonius Codex","Oathsworn Eye"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs"}],"stats":"ER Sands as needed; ATK% Goblet; Healing Bonus or ATK% Circlet.","teams":"Furina and an on-field carry; Charlotte’s team heal builds Fanfare.","when":"Use for strong teamwide healing and Furina synergy while maintaining Burst uptime.","cond":"Prototype Amber helps energy and adds team healing.","notes":"","pre":false},{"titl