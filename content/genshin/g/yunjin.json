78,0.5311,0.0389,0.0311]},{"n":"Yelan","r":[0.1741,0.5311,0.0389,0.0311]},{"n":"Zhongli","r":[0.2204,0.5311,0.0389,0.0311]},{"n":"Yun Jin","r":[0.0815,0.5941,0.0389,0.0311]},{"n":"Wanderer","r":[0.1278,0.5941,0.0389,0.0311]},{"n":"Faruzan","r":[0.1741,0.5941,0.0389,0.0311]},{"n":"Bennett","r":[0.2204,0.5941,0.0389,0.0311]},{"n":"Yun Jin","r":[0.0815,0.657,0.0389,0.0311]},{"n":"Kamisato Ayato","r":[0.1278,0.657,0.0389,0.0311]},{"n":"Furina","r":[0.1741,0.657,0.0389,0.0311]},{"n":"Jean","r":[0.2204,0.657,0.0389,0.0311]},{"n":"Yun Jin","r":[0.0815,0.72,0.0389,0.0311]},{"n":"Noelle","r":[0.1278,0.72,0.0389,0.0311]},{"n":"Gorou","r":[0.1741,0.72,0.0389,0.0311]},{"n":"Furina","r":[0.2204,0.72,0.0389,0.0311]}]}]}},"thumb":"content/genshin/builds/yunjin/261111-225448/en-1.t.webp","why":{"w":[{"name":"Engulfing Lightning","text":"High ER helps maintain Burst uptime."},{"name":"Favonius Lance","text":"CRIT hits generate team Energy. Aim for ~45% CRIT Rate; hit on-field. R5 ideal."},{"name":"Footprint of the Rainbow","text":"Huge DEF boost strengthens NA buffs. Use when ER needs are already met."},{"name":"Rightful Reward","text":"Healing restores Energy to Yun Jin. Requires reliable healing on or off field."},{"name":"Prototype Starglitter","text":"ER stat supports reliable Bursts."},{"name":"\"The Catch\"","text":"ER helps Burst; passive is minor."},{"name":"Kitain Cross Spear","text":"Skill refunds Energy, with timing care. Use Skill before Burst; EM is wasted."}],"a":[{"names":["Husk of Opulent Dreams"],"text":"Maximizes DEF-based Normal buffs.","stats":"ER/DEF% · DEF% · DEF%/CR"},{"names":["Husk of Opulent Dreams","Emblem of Severed Fate"],"text":"Balances DEF with Burst uptime.","stats":"ER/DEF% · DEF% · DEF%/CR"},{"names":["Noblesse Oblige"],"text":"Adds team ATK after Burst.","stats":"ER/DEF% · DEF% · DEF%/CR"}],"t":[{"name":"Firework Finale","members":["Yun Jin","Yoimiya","Yelan","Zhongli"],"text":"Yun Jin buffs each of Yoimiya’s fast Normal Attack hits. Yelan enables Vaporize; Zhongli provides safety and Geo Resonance.","roles":["Normal Attack Buffer","Main DPS","Hydro Sub DPS","Shield / RES Shred"]},{"name":"Wanderer Spotlight","members":["Yun Jin","Wanderer","Faruzan","Bennett"],"text":"Yun Jin boosts Wanderer’s Normal Attack combos, Faruzan boosts Anemo damage, and Bennett heals and buffs ATK. Use a Normal Attack-focused rotation.","roles":["Normal Attack Buffer","Main DPS","Anemo Buffer","Healer / ATK Buffer"]},{"name":"Ayato Encore","members":["Yun Jin","Kamisato Ayato","Furina","Jean"],"text":"Ayato’s Skill attacks count as Normal Attack damage and gain Yun Jin’s buff. Furina adds damage and buffs; Jean heals and shreds Hydro resistance.","roles":["Normal Attack Buffer","Main DPS","Hydro Sub DPS / Buff","Healer / VV"]},{"name":"Geo Opera","members":["Yun Jin","Noelle","Gorou","Furina"],"text":"Noelle uses DEF scaling and Normal Attack strings to benefit from Yun Jin and Gorou. Her team healing builds Furina’s Fanfare.","roles":["Normal Attack Buffer","Main DPS / Healer","DEF / Geo Buffer","Hydro Sub DPS / Buff"]}],"v":"Solo Geo ER: Prioritize enough ER to Burst each rotation; Favonius Lance and ER Sands may be necessary.\nDEF-Heavy Support: Use Footprint of the Rainbow and DEF% pieces when teammates supply enough Energy.\nATK Team Buffer: 4pc Noblesse adds an ATK buff if nobody else carries it; prioritize Burst uptime.","n":4},"seo":{"roles":["Support / Buffer"],"about":"Yun Jin is a DEF-scaling Geo support whose Burst adds damage to teammates' Normal Attack hits. She excels with fast Normal Attack carries, but needs enough Energy Recharge to Burst every rotation. It does not buff Charged Attacks.","pros":["Strong Normal Attack buffs","Excellent DEF scaling","Useful at C0","Easy artifact priorities"],"cons":["High Energy requirements","Normal Attack teams only","30-hit Burst buff limit","Little personal damage"],"weapons":["Engulfing Lightning","Favonius Lance","Footprint of the Rainbow","Rightful Reward","Prototype Starglitter","\"The Catch\"","Kitain Cross Spear"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs","role":"Best"},{"sets":["Husk of Opulent Dreams","Emblem of Severed Fate"],"pcs":"2 + 2 pcs","role":"ER option"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"Team ATK"}],"main":["DEF% / Energy Recharge","DEF%","DEF% / Crit Rate"],"stats":["ER: 160% - 220%","DEF: 2000 - 2600","CR: 40% - 55%"],"vars":[{"title":"Solo Geo / High Energy Needs","role":"Normal Attack Buffer","weapons":["Favonius Lance","Prototype Starglitter","Engulfing Lightning","\"The Catch\""],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"},{"sets":["Husk of Opulent Dreams","Emblem of Severed Fate"],"pcs":"2 + 2 pcs"}],"stats":"Use ER Sands if needed; aim around 195–210% ER with Favonius, potentially 240%+ without it. Build enough CRIT Rate to proc Favonius.","teams":"Solo Geo team with an on-field Normal Attack DPS; more team Energy generation makes the build easier.","when":"When Yun Jin is the only Geo character and must reliably Burst every rotation. ER takes priority over maximum DEF until the Burst is consistent.","cond":"Actual ER depends on teammate particles, Favonius procs and rotation length.","notes":"Favonius procs require Yun Jin to land a CRIT hit while on-field.","pre":false},{"title":"DEF-Focused Normal Attack Buff","role":"Normal Attack Buffer","weapons":["Footprint of the Rainbow","Favonius Lance","Prototype Starglitter"],"arts":[{"sets":["Husk of Opulent Dreams"],"pcs":"4 pcs"}],"stats":"Use DEF% Sands, Goblet and Circlet after meeting Energy needs; favor DEF% substats.","teams":"Prefer a second Geo teammate and/or strong particle generation to lower her ER requirement.","when":"When the team already supplies ample Energy. This maximizes the additional Normal Attack damage from Yun Jin’s DEF-scaling Burst buff.","cond":"Do not sacrifice reliable Burst uptime to chase DEF.","notes":"Footprint is craftable; her Burst buff does not add damage to Charged Attacks.","pre":false},{"title":"Noblesse Team Buff","role":"Support / Team Buffer","weapons":["Favonius Lance","Footprint of the Rainbow","Prototype Starglitter"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Maintain sufficient ER first; then prioritize DEF%. CRIT Rate matters with Favonius.","teams":"ATK-scaling Normal Attack carry, with no other 4pc Noblesse Oblige holder.","when":"When the team benefits substantially from an extra ATK buff and Noblesse is otherwise unused.","cond":"Noblesse 4pc team buffs do not stack with another Noblesse holder.","notes":"Usually a situational alternative to 4pc Husk rather than the default.","pre":false}],"mats":["Prithiva Topaz Sliver","Prithiva Topaz Fragment","Prithiva Topaz Chunk","Prithiva Topaz Gemstone","Riftborn Regalia","Teachings of Diligence","Guide to Diligence","Philosophies of Diligence","Damaged Mask","Stained Mask","Ominous Mask","Glaze Lily","Ashen Heart","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 6+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Firework Finale","members":["Yun Jin","Yoimiya","Yelan","Zhongli"]},{"name":"Wanderer Spotlight","members":["Yun Jin","Wanderer","Faruzan","Bennett"]},{"name":"Ayato Encore","members":["Yun Jin","Kamisato Ayato","Furina","Jean"]},{"name":"Geo Opera","members":["Yun Jin","Noelle","Gorou","Furina"]}]}}],"title":"Yun Jin","el":"Geo"}