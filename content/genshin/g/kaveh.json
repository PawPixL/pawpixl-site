0.5007,0.0343,0.0274]},{"n":"Kaveh","r":[0.0815,0.5578,0.0343,0.0274]},{"n":"Nilou","r":[0.1231,0.5578,0.0343,0.0274]},{"n":"Xingqiu","r":[0.1648,0.5578,0.0343,0.0274]},{"n":"Baizhu","r":[0.2065,0.5578,0.0343,0.0274]},{"n":"Kaveh","r":[0.0815,0.6148,0.0343,0.0274]},{"n":"Xingqiu","r":[0.1231,0.6148,0.0343,0.0274]},{"n":"Barbara","r":[0.1648,0.6148,0.0343,0.0274]},{"n":"Kaveh","r":[0.0815,0.6719,0.0343,0.0274]},{"n":"Xingqiu","r":[0.1231,0.6719,0.0343,0.0274]},{"n":"Kuki Shinobu","r":[0.1648,0.6719,0.0343,0.0274]},{"n":"Nahida","r":[0.2065,0.6719,0.0343,0.0274]}]}]}},"thumb":"content/genshin/builds/kaveh/261111-225016/en-1.t.webp","why":{"w":[{"name":"Favonius Greatsword","text":"Particles ease costly Burst needs. Build CRIT Rate for reliable procs."},{"name":"Skyward Pride","text":"High base ATK and Energy Recharge. Energy-focused premium option."},{"name":"Makhaira Aquamarine","text":"EM also grants a small team ATK buff. After meeting Burst ER needs."},{"name":"Sacrificial Greatsword","text":"Extra Skill cast adds cores and Energy. Needs passive to trigger; refinement helps."},{"name":"Mailed Flower","text":"Great EM after Skill or reaction. Past event weapon; not always obtainable."},{"name":"Rainslasher","text":"EM for personal Blooms and healing. Use after meeting ER needs."},{"name":"Forest Regalia","text":"Craftable ER and team EM leaf. Leaf pickup can interrupt rotations."},{"name":"Katsuragikiri Nagamasa","text":"Craftable weapon for Energy needs. Skill Energy refund requires timing. Higher refinements help."}],"a":[{"names":["Deepwood Memories"],"text":"Shreds Dendro RES for the team.","stats":"ER / EM · EM · EM/CR"},{"names":["Ocean-Hued Clam"],"text":"Turns his self-healing into damage.","stats":"ER / EM · EM · HB/EM"},{"names":["Flower of Paradise Lost"],"text":"For high personal Bloom ownership.","stats":"ER / EM · EM · EM"}],"t":[{"name":"Nilou Bloom Atelier","members":["Kaveh","Nilou","Nahida","Sangonomiya Kokomi"],"text":"Nilou enhances Bountiful Cores; Nahida supplies Dendro and Energy, Kokomi heals and applies Hydro. Kaveh drives on-field. Dendro/Hydro only.","roles":["On-field Driver","Bloom Buffer / Hydro Enabler","Dendro Enabler / Buffer","Healer / Hydro Enabler"]},{"name":"Architects in Bloom","members":["Kaveh","Nilou","Xingqiu","Baizhu"],"text":"Nilou empowers Bloom cores; Xingqiu supplies Hydro, Baizhu sustains and helps fund Kaveh's Burst. All four satisfy Nilou's team rule.","roles":["On-field Driver","Bloom Buffer / Hydro Enabler","Off-field DPS / Hydro Enabler","Healer / Shielder"]},{"name":"Budget Bloom Workshop","members":["Kaveh","Xingqiu","Barbara","Traveler (Dendro)"],"text":"Xingqiu and Barbara apply Hydro; Dendro Traveler helps Kaveh's Energy. Manage who triggers Bloom and prioritize their EM.","roles":["On-field Driver","Off-field DPS / Hydro Enabler","Healer","Dendro Enabler / Battery"]},{"name":"Hyperbloom Drafting","members":["Kaveh","Xingqiu","Kuki Shinobu","Nahida"],"text":"Kaveh drives Dendro; Xingqiu creates cores and full-EM Kuki triggers Hyperbloom. Kaveh's Bloom bonus does not boost Hyperbloom.","roles":["On-field Driver","Off-field DPS / Hydro Enabler","Healer / Reaction Trigger","Dendro Enabler / Buffer"]}],"v":"Nilou Bloom: Dendro/Hydro only; high EM for comfort, enough ER for Burst. Hydro often owns Bloom cores.\nFavonius Driver: ER first; add CRIT Rate to proc Favonius. Deepwood if nobody else carries it.\nPersonal Bloom: Flower of Paradise Lost only when Kaveh owns a substantial share of Bloom triggers.\nHealing Driver: Ocean-Hued Clam and Healing Bonus circlet improve self-sustain; healing does not cover teammates.\nHyperbloom Driver: Kuki triggers seeds with EM; Kaveh supplies Dendro, but his Burst Bloom buff does not apply.","n":4},"seo":{"roles":["Main DPS / Support"],"about":"Kaveh drives Bloom with on-field Dendro attacks, core ruptures, and self-healing. His Burst buffs regular Bloom, not Hyperbloom or Burgeon. Detonating a core does not change the Bloom trigger whos