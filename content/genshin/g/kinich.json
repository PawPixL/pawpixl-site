builds/kinich/261111-225049/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Fang of the Mountain King","r":[0.1093,0.2419,0.0491,0.0393],"k":"w"},{"n":"A Thousand Blazing Suns","r":[0.1093,0.2893,0.0491,0.0393],"k":"w"},{"n":"Beacon of the Reed Sea","r":[0.1093,0.3367,0.0491,0.0393],"k":"w"},{"n":"Obsidian Codex","r":[0.0815,0.4452,0.0491,0.0393],"k":"a"},{"n":"Unfinished Reverie","r":[0.0815,0.5004,0.0491,0.0393],"k":"a"},{"n":"Deepwood Memories","r":[0.0815,0.5478,0.0491,0.0393],"k":"a"},{"n":"Golden Troupe","r":[0.1361,0.5478,0.0491,0.0393],"k":"a"},{"n":"Kinich","r":[0.0815,0.6519,0.0389,0.0311]},{"n":"Emilie","r":[0.1278,0.6519,0.0389,0.0311]},{"n":"Nicole","r":[0.1741,0.6519,0.0389,0.0311]},{"n":"Durin","r":[0.2204,0.6519,0.0389,0.0311]},{"n":"Kinich","r":[0.0815,0.7148,0.0389,0.0311]},{"n":"Emilie","r":[0.1278,0.7148,0.0389,0.0311]},{"n":"Bennett","r":[0.1741,0.7148,0.0389,0.0311]},{"n":"Mavuika","r":[0.2204,0.7148,0.0389,0.0311]},{"n":"Kinich","r":[0.0815,0.7778,0.0389,0.0311]},{"n":"Iansan","r":[0.1278,0.7778,0.0389,0.0311]},{"n":"Bennett","r":[0.1741,0.7778,0.0389,0.0311]},{"n":"Xiangling","r":[0.2204,0.7778,0.0389,0.0311]},{"n":"Kinich","r":[0.0815,0.8407,0.0389,0.0311]},{"n":"Bennett","r":[0.1741,0.8407,0.0389,0.0311]},{"n":"Iansan","r":[0.2204,0.8407,0.0389,0.0311]}]}]}},"thumb":"content/genshin/builds/kinich/261111-225049/en-1.t.webp","why":{"w":[{"name":"Fang of the Mountain King","text":"His signature boosts Skill and Burst damage as he gains stacks from Skill hits and Burning or Burgeon reactions."},{"name":"A Thousand Blazing Suns","text":"Grants massive ATK and CRIT DMG buffs during Nightsoul's Blessing, boosting Kinich's first few Scalespiker Cannons. Limited uptime."},{"name":"Beacon of the Reed Sea","text":"Provides 33.1% CRIT Rate and ATK buffs from Skill hits and taking damage. Best without shields, but watch for CRIT overcap."},{"name":"Gest of the Mighty Wolf","text":"CRIT Rate stat stick with bonuses best realized in qualifying Hexerei teams; passive uptime varies outside that setup."},{"name":"Serpent Spine","text":"Battle Pass CRIT Rate and stacking damage bonus; keep stacks by avoiding hits."},{"name":"Earth Shaker","text":"It's one of Kinich's best accessible weapons."},{"name":"Tidal Shadow","text":"Craftable ATK weapon with an additional ATK buff after healing; needs a healer."},{"name":"\"Ultimate Overlord's Mega Magic Sword\"","text":"Energy Recharge and an ATK boost linked to Melusine quest progress; limited past-event weapon."}],"a":[{"names":["Obsidian Codex"],"text":"Provides 15% DMG Bonus and 40% CRIT Rate while Kinich consumes Nightsoul points, making it his best-in-slot artifact set.","stats":"ATK% · Dendro DMG Bonus · CR/CD"},{"names":["Unfinished Reverie"],"text":"Provides 18% ATK and up to 50% DMG Bonus while Burning enemies are present, making it a strong alternative for Kinich in Burning teams.","stats":""},{"names":["Deepwood Memories","Golden Troupe"],"text":"Provides 15% Dendro DMG and 20% Elemental Skill DMG, offering a flexible option for boosting Kinich’s Dendro and Skill damage.","stats":""}],"t":[{"name":"Kinich Me Outside","members":["Kinich","Emilie","Nicole","Durin"],"text":"Kinich drives on-field Burning damage, Emilie adds off-field Dendro damage, Nicole provides ATK buffs and shielding, and Durin supplies Pyro application, Dendro RES shred, and off-field damage.","roles":["DPS","Support","Support","Sub DPS"]},{"name":"Ajaw & Order","members":["Kinich","Emilie","Bennett","Mavuika"],"text":"Kinich deals powerful Skill damage while Emilie adds Dendro damage. Mavuika maintains Pyro for Burning, and Bennett provides healing and ATK buffs.","roles":["On-field DPS","Off-field DPS","Healer / Buffer","Off-field DPS / Pyro Enabler"]},{"name":"Let Him Cook","members":["Kinich","Iansan","Bennett","Xiangling"],"text":"Kinich drives Burning damage, Xiangling maintains Pyro, and Bennett heals and buffs ATK. Iansan offers extra ATK support, though another Dendro support may offer more.","roles":["On-field DPS","ATK Buffer","Healer / Buffer","Off-field DPS / Pyro Enabler"]},{"name":"Free to Burn","members":["Kinich","Traveler (Pyro)","Bennett","Iansan"],"text":"Kinich drives Burning damage, Pyro Traveler provides off-field Pyro and buffs, Bennett boosts ATK and heals, and Iansan adds ATK buffs and DMG Bonus.","roles":["On-field DPS","Pyro Enabler / Support","Healer / Buffer","ATK Buffer"]}],"v":"Burning DPS: Prioritize Kinich's Skill damage with consistent Burning, strong ATK buffs, and a teammate carrying Deepwood Memories.\nBurgeon Option: Add Hydro and off-field Pyro for Burgeon reactions while preserving enough Burning uptime for frequent Scalespiker Cannons.\nUnfinished Reverie: A strong alternative to Obsidian Codex in Burning teams, especially with excellent substats or a CRIT Rate weapon.\nBudget Skill DPS: Use craftable Earth Shaker and Obsidian Codex with affordable Pyro supports to maximize Scalespiker Cannon damage.\nLow ER Setup: Focus on ATK and CRIT instead of excessive ER when Bursting every rotation would sacrifice valuable Skill damage.","n":3},"seo":{"roles":["Main DPS"],"about":"Kinich is a 5★ Dendro on-field DPS who builds Nightsoul points to fire powerful Scalespiker Cannons. Burning and Burgeon help him generate points faster and maximize his damage.","pros":["Huge Skill damage","Excellent mobility","Strong Burning synergy","Ajaw is iconic"],"cons":["Team restrictive","Single-target focused","Awkward positioning","Ajaw is Ajaw"],"weapons":["Fang of the Mountain King","A Thousand Blazing Suns","Beacon of the Reed Sea","Gest of the Mighty Wolf","Serpent Spine","Earth Shaker","Tidal Shadow","\"Ultimate Overlord's Mega Magic Sword\""],"arts":[{"sets":["Obsidian Codex"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Unfinished Reverie"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Deepwood Memories","Golden Troupe"],"pcs":"2 + 2 pcs","role":""}],"main":["ATK%","Dendro DMG Bonus","Crit Rate / Crit DMG"],"stats":["ATK: 2,000+","CRIT Rate: 40% - 60% (before Obsidian)","CRIT DMG: 170% - 200%+","Energy Recharge: 110% - 130% (optional)"],"vars":[{"title":"Burning Cannon DPS","role":"On-field DPS","weapons":["Fang of the Mountain King","Gest of the Mighty Wolf","Earth Shaker"],"arts":[{"sets":["Obsidian Codex"],"pcs":"4 pcs"},{"sets":["Unfinished Reverie"],"pcs":"4 pcs"}],"stats":"ATK and CRIT take priority; Codex supplies CRIT Rate.","teams":"Stable Pyro for Burning; Deepwood on another teammate.","when":"Maintain Burning to support consistent Scalespiker cannon cycles.","cond":"Avoid CRIT overcap with Obsidian Codex.","notes":"","pre":false},{"title":"Burgeon Cannon DPS","role":"On-field DPS","weapons":["Fang of the Mountain King","Serpent Spine","Earth Shaker"],"arts":[{"sets":["Obsidian Codex"],"pcs":"4 pcs"}],"stats":"Maintain ATK/CRIT with enough ER for rotation.","teams":"Hydro plus controlled Pyro to trigger Burgeon.","when":"Trade the pure Burning setup for Burgeon damage and Nightsoul generation.","cond":"Burgeon trigger should build EM as appropriate.","notes":"","pre":false}],"mats":["Nagadus Emerald Sliver","Nagadus Emerald Fragment","Nagadus Emerald Chunk","Nagadus Emerald Gemstone","Overripe Flamegranate","Teachings of Kindling","Guide to Kindling","Philosophies of Kindling","Juvenile Fang","Seasoned Fang","Tyrant's Fang","Saurian Claw Succulent","Denial and Judgment","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Kinich Me Outside","members":["Kinich","Emilie","Nicole","Durin"]},{"name":"Ajaw & Order","members":["Kinich","Emilie","Bennett","Mavuika"]},{"name":"Let Him Cook","members":["Kinich","Iansan","Bennett","Xiangling"]},{"name":"Free to Burn","members":["Kinich","Traveler (Pyro)","Bennett","Iansan"]}]}}],"title":"Kinich","el":"Dendro"}