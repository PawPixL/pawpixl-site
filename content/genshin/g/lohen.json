6]},{"n":"Lohen","r":[0.0815,0.617,0.037,0.0296]},{"n":"Furina","r":[0.1259,0.617,0.037,0.0296]},{"n":"Citlali","r":[0.1704,0.617,0.037,0.0296]},{"n":"Escoffier","r":[0.2148,0.617,0.037,0.0296]},{"n":"Lohen","r":[0.0815,0.6778,0.037,0.0296]},{"n":"Vodyanitsa","r":[0.1259,0.6778,0.037,0.0296]},{"n":"Mona","r":[0.1704,0.6778,0.037,0.0296]},{"n":"Escoffier","r":[0.2148,0.6778,0.037,0.0296]},{"n":"Lohen","r":[0.0815,0.7385,0.037,0.0296]},{"n":"Sucrose","r":[0.1259,0.7385,0.037,0.0296]},{"n":"Bennett","r":[0.1704,0.7385,0.037,0.0296]},{"n":"Xiangling","r":[0.2148,0.7385,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/lohen/261111-225116/en-1.t.webp","why":{"w":[{"name":"Disaster and Remorse","text":"Signature CRIT Rate polearm with broad damage buffs; stronger after the Hexerei: Secret Rite condition."},{"name":"Staff of Homa","text":"Provides 66.2% CRIT DMG, 20% HP, and an ATK bonus based on Max HP, making it a strong 5-star alternative for Lohen."},{"name":"Fractured Halo","text":"CRIT DMG and ATK after Skill or Burst. The Lunar-Charged team bonus needs the wielder to create a shield. Shield-creation passive unavailable."},{"name":"Primordial Jade Winged-Spear","text":"CRIT Rate and stacking ATK with hits; needs field time to reach full stacks."},{"name":"Sacrificer's Staff","text":"CRIT Rate polearm that stacks ATK and ER when Skill hits; a practical lower-rarity option."},{"name":"Deathmatch","text":"Provides 36.8% CRIT Rate and up to 24% ATK at R1 against fewer than two enemies, making it a strong 4-star alternative for Lohen."},{"name":"Missive Windspear","text":"Provides 41.3% ATK and, at R5, grants 24% ATK and 96 EM after triggering an Elemental Reaction, making it a solid F2P option for Lohen."},{"name":"Tamayuratei no Ohanashi","text":"stacks granted on Skill use — the combo already casts Skill once every cycle."}],"a":[{"names":["A Day Carved From Rising Winds"],"text":"Provides 18% ATK and up to 25% additional ATK plus 20% CRIT Rate after Witch’s Homework, making it Lohen’s best-in-slot artifact set.","stats":"ATK% · Cryo DMG Bonus/ATK% · CR/CD"},{"names":["Blizzard Strayer"],"text":"Provides 15% Cryo DMG and up to 40% CRIT Rate against Cryo-affected or Frozen enemies, making it a situational alternative for Lohen in Freeze teams.","stats":""},{"names":["Marechaussee Hunter"],"text":"Provides 15% Normal and Charged Attack DMG and up to 36% CRIT Rate when HP changes, making it a situational option for Lohen if his team provides consistent HP fluctuations.","stats":""}],"t":[{"name":"Witch Please","members":["Lohen","Nicole","Citlali","Durin"],"text":"Lohen deals Cryo damage and can trigger Reverse Melt using Durin’s Pyro application. Nicole buffs the team, while Citlali shields and supports reactions.","roles":["Main DPS","Support","Res Shred","Sub DPS"]},{"name":"Blizzard Queen","members":["Lohen","Furina","Citlali","Escoffier"],"text":"Lohen drives on-field Cryo damage, Furina provides Hydro application and DMG buffs, Citlali adds shielding and Cryo application, and Escoffier provides healing, Cryo RES shred, and off-field damage.","roles":["Main DPS","Buffs","Support","Support"]},{"name":"Amber Alerted Us","members":["Lohen","Vodyanitsa","Mona","Escoffier"],"text":"Lohen drives on-field Cryo damage, Vodyanitsa provides Hydro application, healing, and RES shred, Mona boosts damage with Omen, and Escoffier adds Cryo/Hydro RES shred and healing.","roles":["Main DPS","Buffs","Hex","Support"]},{"name":"Lohen at Home","members":["Lohen","Sucrose","Bennett","Xiangling"],"text":"Xiangling maintains Pyro for Lohen to trigger Reverse Melt. Bennett heals and buffs ATK, while Sucrose shares EM and lowers Cryo resistance when she swirls Cryo.","roles":["Main DPS","EM Build","Support","Sub DPS"]}],"v":"Cryo Skill Carry: Use Lohen’s resource-driven Skill attacks for personal Cryo damage.\nFurina CRIT Alternative: An alternative to the primary set in HP-fluctuation teams.","n":4},"seo":{"roles":["Main DPS"],"about":"Lohen is an on-field Cryo DPS who builds resources to unleash powerful Skill attacks. He rewards strong rotations and active off-field teammates.","pros":["High Cryo damage","Strong Skill damage","Fast rotations","Strong team synergy"],"cons":["Setup dependent","Rotation sensitive","Wants off-field DPS","Constellation scaling"],"weapons":["Disaster and Remorse","Staff of Homa","Fractured Halo","Primordial Jade Winged-Spear","Sacrificer's Staff","Deathmatch","Missive Windspear","Tamayuratei no Ohanashi"],"arts":[{"sets":["A Day Carved From Rising Winds"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Blizzard Strayer"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Main DPS"}],"main":["ATK%","Cryo DMG Bonus / ATK%","Crit Rate / Crit DMG"],"stats":["ATK: 2,000+","Crit Rate: 60% - 70%","Crit DMG: 180% - 200%+","Elemental Mastery: 0-200 (Melt)"],"vars":[{"title":"Cryo Skill Carry","role":"On-field DPS","weapons":["Disaster and Remorse","Staff of Homa","Deathmatch"],"arts":[{"sets":["A Day Carved From Rising Winds"],"pcs":"4 pcs"}],"stats":"ATK/CRIT focus; account for set and weapon bonuses.","teams":"Cryo buffs and compatible off-field reactions.","when":"Use Lohen’s resource-driven Skill attacks for personal Cryo damage.","cond":"Rotation and resource timing matter.","notes":"","pre":false},{"title":"Furina CRIT Alternative","role":"On-field DPS","weapons":["Disaster and Remorse","Staff of Homa"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"Adjust CRIT Rate around Marechaussee stacks.","teams":"Furina plus reliable HP changes and healing.","when":"An alternative to the primary set in HP-fluctuation teams.","cond":"Only if HP changes keep the artifact buff active.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Prismatic Severed Tail","Teachings of Resistance","Guide to Resistance","Philosophies of Resistance","Firm Arrowhead","Sharp Arrowhead","Weathered Arrowhead","Etherwing Moth","Ascended Sample: Knight","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Witch Please","members":["Lohen","Nicole","Citlali","Durin"]},{"name":"Blizzard Queen","members":["Lohen","Furina","Citlali","Escoffier"]},{"name":"Amber Alerted Us","members":["Lohen","Vodyanitsa","Mona","Escoffier"]},{"name":"Lohen at Home","members":["Lohen","Sucrose","Bennett","Xiangling"]}]}}],"title":"Lohen","el":"Cryo"}