9,0.0415],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.8385,0.0519,0.0415],"k":"m"}]},{"img":"content/genshin/builds/mika/261111-225116/zh-3.webp","t":"content/genshin/builds/mika/261111-225116/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Symphonist of Scents","r":[0.1093,0.2537,0.0472,0.0378],"k":"w"},{"n":"Favonius Lance","r":[0.1093,0.3219,0.0472,0.0378],"k":"w"},{"n":"Noblesse Oblige","r":[0.5231,0.2611,0.0472,0.0378],"k":"a"},{"n":"Ocean-Hued Clam","r":[0.5231,0.3515,0.0472,0.0378],"k":"a"},{"n":"Maiden Beloved","r":[0.5231,0.4419,0.0472,0.0378],"k":"a"},{"n":"Mika","r":[0.0815,0.5667,0.037,0.0296]},{"n":"Eula","r":[0.1259,0.5667,0.037,0.0296]},{"n":"Raiden Shogun","r":[0.1704,0.5667,0.037,0.0296]},{"n":"Furina","r":[0.2148,0.5667,0.037,0.0296]},{"n":"Mika","r":[0.0815,0.6274,0.037,0.0296]},{"n":"Eula","r":[0.1259,0.6274,0.037,0.0296]},{"n":"Rosaria","r":[0.1704,0.6274,0.037,0.0296]},{"n":"Fischl","r":[0.2148,0.6274,0.037,0.0296]},{"n":"Mika","r":[0.0815,0.6881,0.037,0.0296]},{"n":"Freminet","r":[0.1259,0.6881,0.037,0.0296]},{"n":"Furina","r":[0.1704,0.6881,0.037,0.0296]},{"n":"Fischl","r":[0.2148,0.6881,0.037,0.0296]},{"n":"Mika","r":[0.0815,0.7489,0.037,0.0296]},{"n":"Razor","r":[0.1259,0.7489,0.037,0.0296]},{"n":"Rosaria","r":[0.1704,0.7489,0.037,0.0296]},{"n":"Fischl","r":[0.2148,0.7489,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/mika/261111-225116/en-1.t.webp","why":{"w":[{"name":"Symphonist of Scents","text":"Symphonist of Scents increases Mika's ATK and provides a teamwide ATK buff when he heals. It's a supportive option for ATK-scaling DPS teams."},{"name":"Favonius Lance","text":"Provides Energy Recharge and generates extra particles for the team, helping Mika and his teammates maintain Burst uptime."},{"name":"Dialogues of the Desert Sages","text":"Dialogues of the Desert Sages boosts Mika's HP and restores Energy when he heals, improving his healing while helping maintain Burst uptime."},{"name":"Engulfing Lightning","text":"High Energy Recharge with ER-to-ATK conversion. Best when frequent Bursts matter."},{"name":"\"The Catch\"","text":"An Energy Recharge stat stick that helps Burst uptime. Its offensive passive adds little value to a healer and Physical support."},{"name":"Rightful Reward","text":"Craftable HP% polearm that restores Energy after the wielder receives healing."},{"name":"Prototype Starglitter","text":"Craftable Energy Recharge; the Normal and Charged Attack passive has limited support value."},{"name":"Black Tassel","text":"HP% stat stick; easy option for HP-scaling support or healing."}],"a":[{"names":["Noblesse Oblige"],"text":"Noblesse boosts Mika's Burst damage and grants the entire team a 20% ATK buff after using his Burst, making it excellent for supporting ATK-scaling DPS.","stats":"ER/HP% · HP% · Healing Bonus/HP%"},{"names":["Ocean-Hued Clam"],"text":"Ocean-Hued Clam converts Mika's healing into additional damage through its bubble effect, adding some personal damage while maintaining his healer role.","stats":"ER/HP% · HP% · Healing Bonus/HP%"},{"names":["Maiden Beloved"],"text":"Maiden Beloved increases Mika's healing output, improving team survivability. However, it offers no team damage buffs, making Noblesse a stronger overall support option.","stats":"ER/HP% · HP% · Healing Bonus/HP%"}],"t":[{"name":"Frozen Thunder","members":["Mika","Eula","Raiden Shogun","Furina"],"text":"Mika boosts Eula's Physical DMG and ATK SPD while providing consistent healing to support Furina's Fanfare stacks. Raiden enables Superconduct, provides Energy, and helps the team maximize Eula's devastating Burst damage.","roles":["Healer / Physical Buffer","On-field DPS","On-field DPS / Battery","Off-field DPS / Buffer"]},{"name":"Glacial Execution","members":["Mika","Eula","Rosaria","Fischl"],"text":"Mika buffs Eula's Physical DMG and ATK SPD while healing the team. Fischl enables Superconduct, while Rosaria provides Cryo application and CRIT support.","roles":["Healer / Physical Buffer","On-field DPS","Off-field DPS / CRIT Buffer","Off-field DPS / Battery"]},{"name":"Frozen Depths","members":["Mika","Freminet","Furina","Fischl"],"text":"Mika boosts Freminet's Physical DMG and ATK SPD while providing healing. Furina buffs team damage, while Fischl enables Superconduct and provides consistent off-field damage.","roles":["Healer / Physical Buffer","On-field DPS","Off-field DPS / Buffer","Off-field DPS / Battery"]},{"name":"Mondstadt Wolfpack","members":["Mika","Razor","Rosaria","Fischl"],"text":"Mika boosts Razor's Physical DMG and ATK SPD while providing healing. Fischl enables Superconduct, while Rosaria adds Cryo application and CRIT Rate support.","roles":["Healer / Physical Buffer","On-field DPS","Off-field DPS / CRIT Buffer","Off-field DPS / Battery"]}],"v":"Physical Carry Support: Prioritize reliable Burst healing and Physical damage support.\nGeneral Healer: Sacrifice some buffing utility for consistent healing and comfort.","n":2},"seo":{"roles":["Support"],"about":"Mika increases the active character's ATK SPD, boosts Physical DMG, and provides healing through his Elemental Burst. He's particularly valuable for Eula and other Physical DPS characters.","pros":["Boosts Phy. DMG and ATK SPD.","Provides teamwide healing.","Excellent","Easy to build with low investment.","Strong Furina synergy."],"cons":["Weaker buffs against single targets at C0.","Limited Cryo application.","High ER needs.","Best with his C6"],"weapons":["Symphonist of Scents","Favonius Lance","Dialogues of the Desert Sages","Engulfing Lightning","\"The Catch\"","Rightful Reward","Prototype Starglitter","Black Tassel"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"Best Support"},{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs","role":"Support"},{"sets":["Maiden Beloved"],"pcs":"4 pcs","role":"Support"}],"main":["Energy Recharge / HP%","HP%","Healing Bonus / HP%"],"stats":["HP: 25,000–30,000+","Energy Recharge: 180–230%"],"vars":[{"title":"Physical Carry Support","role":"Support","weapons":["Favonius Lance","Dialogues of the Desert Sages"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER and HP% for healing; CR for Favonius.","teams":"Physical on-field carry that benefits from ATK Speed.","when":"Prioritize reliable Burst healing and Physical damage support.","cond":"Physical buff value depends on carry and enemy count.","notes":"","pre":false},{"title":"General Healer","role":"Healer","weapons":["Favonius Lance","Dialogues of the Desert Sages","Rightful Reward"],"arts":[{"sets":["Ocean-Hued Clam"],"pcs":"4 pcs"},{"sets":["Maiden Beloved"],"pcs":"4 pcs"}],"stats":"ER and HP%; Healing Bonus optional.","teams":"Teams needing healing rather than Physical damage buffs.","when":"Sacrifice some buffing utility for consistent healing and comfort.","cond":"His Physical buffs offer limited value outside Physical teams.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Pseudo-Stamens","Teachings of Ballad","Guide to Ballad","Philosophies of Ballad","Recruit's Insignia","Sergeant's Insignia","Lieutenant's Insignia","Wolfhook","Mirror of Mushin","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Frozen Thunder","members":["Mika","Eula","Raiden Shogun","Furina"]},{"name":"Glacial Execution","members":["Mika","Eula","Rosaria","Fischl"]},{"name":"Frozen Depths","members":["Mika","Freminet","Furina","Fischl"]},{"name":"Mondstadt Wolfpack","members":["Mika","Razor","Rosaria","Fischl"]}]}}],"title":"Mika","el":"Cryo"}