Bennett","r":[0.1722,0.6407,0.038,0.0304]},{"n":"Sucrose","r":[0.2176,0.6407,0.038,0.0304]},{"n":"Gaming","r":[0.0815,0.7037,0.038,0.0304]},{"n":"Xingqiu","r":[0.1269,0.7037,0.038,0.0304]},{"n":"Sucrose","r":[0.1722,0.7037,0.038,0.0304]},{"n":"Bennett","r":[0.2176,0.7037,0.038,0.0304]}]}]}},"thumb":"content/genshin/builds/gaming/261111-224925/en-1.t.webp","why":{"w":[{"name":"Gest of the Mighty Wolf","text":"A top premium choice that grants valuable DMG bonuses to his repeated Plunging Attacks."},{"name":"A Thousand Blazing Suns","text":"High base ATK and CRIT help his DMG, while its combat bonuses suit an on-field Pyro carry."},{"name":"Beacon of the Reed Sea","text":"Provides CRIT Rate and ATK for strong personal damage. Watch your CRIT cap at C6 or with Marechaussee Hunter. CRIT Rate can overcap."},{"name":"Redhorn Stonethresher","text":"Its large CRIT DMG stat benefits Gaming, although its DEF-based Normal and Charged Attack passive does little for his plunges. Mostly a CRIT stat stick."},{"name":"Fruitful Hook","text":"An excellent Plunging Attack weapon with valuable CR and DMG bonuses. Becomes exceptional at high refinements. Its buff may miss the opening plunge."},{"name":"Serpent Spine","text":"Offers CR and stacking DMG bonuses. Shielding helps preserve its stacks during extended combos. Best when stacks remain active. Excellent at R5."},{"name":"Rainslasher","text":"Excellent for Vaporize with its Elemental Mastery and bonus damage against Hydro-affected enemies. Vaporize teams only. Strong at R5."},{"name":"Blade of Atonement","text":"A reliable permanent free option that supports Gaming’s damage without needing limited event weapons. Use at R5 when available. R5 preferred."}],"a":[{"names":["Crimson Witch of Flames"],"text":"Best for Melt and Vaporize.","stats":"EM or ATK% / Pyro DMG / CRIT"},{"names":["Marechaussee Hunter"],"text":"His HP changes activate its 36% CRIT Rate bonus. Avoid exceeding the CRIT cap, especially at C6.","stats":"EM or ATK% / Pyro DMG / CRIT DMG"},{"names":["Long Night's Oath"],"text":"Boosts Plunging Attack damage. A strong alternative if you already have good pieces.","stats":"EM or ATK% / Pyro DMG / CRIT"}],"t":[{"name":"Wushou Royal Court","members":["Gaming","Citlali","Nicole","Xianyun"],"text":"Citlali enables powerful Melt plunges and lowers Pyro resistance. Nicole adds buffs and shielding, while Xianyun boosts plunge damage and heals.","roles":["On-field DPS","Shielder / Buffer","Shielder / Buffer","Healer / Plunge Buffer"]},{"name":"Cloudborne Vaporize","members":["Gaming","Furina","Xianyun","Bennett"],"text":"Furina enables Vaporize and boosts damage. Xianyun buffs plunges and heals the team, while Bennett provides ATK and Pyro particles.","roles":["Main DPS","Hydro / DMG Buff","Healer / VV","ATK Buff"]},{"name":"Frostfire Festival","members":["Gaming","Citlali","Bennett","Sucrose"],"text":"Citlali supplies Cryo for Melt, Bennett buffs ATK, and Sucrose shares EM and reduces Pyro resistance with Viridescent Venerer.","roles":["On-field DPS","Shielder / Buffer","Healer / Buffer","EM Buffer / Debuffer"]},{"name":"Budget Lion Dance","members":["Gaming","Xingqiu","Sucrose","Bennett"],"text":"Use Normal Attacks between plunges to trigger Xingqiu’s Hydro swords. Sucrose supports Vaporize while Bennett buffs and heals.","roles":["On-field DPS","Off-field DPS / Hydro Enabler","EM Buffer / Debuffer","Healer / Buffer"]}],"v":"Melt DPS: Crimson Witch with EM Sands works well when Citlali or another Cryo teammate consistently enables Melt.\nVaporize DPS: Use Rainslasher or a premium damage weapon with reliable Hydro application from Furina or Xingqiu.\nMarechaussee: With Marechaussee and C6, aim for no more than 44% sheet CRIT Rate for Charmed Cloudstrider.\nBefore C4: Prioritize enough ER to Burst consistently. C4 greatly reduces his Energy needs.","n":3},"seo":{"roles":["Main DPS"],"about":"Gaming is a Pyro Plunges DPS who repeatedly launches Charmed Cloudstrider using his Skill & Burst. He excels in Melt & Vaporize teams, where his strong DMG & self-healing make him a powerful four-star carry. His Burst needs enough Energy to stay active each rotation.","pros":["Powerful plunge damage","Strong Melt and Vaporize","Great at C6","Self-healing playstyle"],"cons":["Burst dependent","Needs careful timing","Energy hungry before C4","CRIT can overcap"],"weapons":["Gest of the Mighty Wolf","A Thousand Blazing Suns","Beacon of the Reed Sea","Redhorn Stonethresher","Fruitful Hook","Serpent Spine","Rainslasher","Blade of Atonement"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs","role":""},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":""},{"sets":["Long Night's Oath"],"pcs":"4 pcs","role":""}],"main":["EM / ATK%","Pyro DMG Bonus","CRIT Rate / CRIT DMG"],"stats":["ER: 100% - 180%","CRIT Rate: 45% - 75%","CRIT DMG: 140% - 200%","EM: 100 - 250"],"vars":[{"title":"Melt Plunge","role":"On-field DPS","weapons":["Gest of the Mighty Wolf","Fruitful Hook","Serpent Spine"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"},{"sets":["Long Night's Oath"],"pcs":"4 pcs"}],"stats":"EM gains value with consistent Melt; keep CRIT and ATK balanced.","teams":"Reliable Cryo aura; healer and plunge support.","when":"Use when Gaming can Melt a meaningful share of his plunge hits.","cond":"Check aura stability and field-time requirements.","notes":"","pre":false},{"title":"Furina Plunge","role":"On-field DPS","weapons":["Fruitful Hook","Serpent Spine"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"},{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"}],"stats":"Build around Marechaussee CRIT Rate; avoid CR overcap.","teams":"Furina plus steady team healing, ideally Xianyun.","when":"HP changes enable Marechaussee while supports strengthen plunges.","cond":"Requires reliable HP fluctuation.","notes":"","pre":false},{"title":"Budget Plunge DPS","role":"On-field DPS","weapons":["Fruitful Hook","Serpent Spine"],"arts":[{"sets":["Crimson Witch of Flames"],"pcs":"4 pcs"},{"sets":["Long Night's Oath"],"pcs":"4 pcs"}],"stats":"ATK% or EM Sands based on reaction uptime.","teams":"A healer and consistent Pyro reaction setup.","when":"Accessible weapon route centered on Gaming’s plunging attacks.","cond":"Weapon refinements and reaction consistency matter.","notes":"","pre":false}],"mats":["Agnidus Agate Sliver","Agnidus Agate Fragment","Agnidus Agate Chunk","Agnidus Agate Gemstone","Emperor's Resolution","Teachings of Prosperity","Guide to Prosperity","Philosophies of Prosperity","Slime Condensate","Slime Secretions","Slime Concentrate","Starconch","Lightless Mass","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 8–9"}],"teams":[{"name":"Wushou Royal Court","members":["Gaming","Citlali","Nicole","Xianyun"]},{"name":"Cloudborne Vaporize","members":["Gaming","Furina","Xianyun","Bennett"]},{"name":"Frostfire Festival","members":["Gaming","Citlali","Bennett","Sucrose"]},{"name":"Budget Lion Dance","members":["Gaming","Xingqiu","Sucrose","Bennett"]}]}}],"title":"Gaming","el":"Pyro"}