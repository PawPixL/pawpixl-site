5],"k":"m"},{"n":"Portable Bearing","r":[0.0815,0.7852,0.0519,0.0415],"k":"m"},{"n":"Ascended Sample: Knight","r":[0.5065,0.7852,0.0519,0.0415],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.8385,0.0519,0.0415],"k":"m"}]},{"img":"content/genshin/builds/jahoda/261111-224949/zh-3.webp","t":"content/genshin/builds/jahoda/261111-224949/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Favonius Warbow","r":[0.1093,0.2456,0.0454,0.0363],"k":"w"},{"n":"Elegy for the End","r":[0.1093,0.3048,0.0454,0.0363],"k":"w"},{"n":"Viridescent Venerer","r":[0.5231,0.2526,0.0454,0.0363],"k":"a"},{"n":"Silken Moon's Serenade","r":[0.5231,0.3259,0.0454,0.0363],"k":"a"},{"n":"Tenacity of the Millelith","r":[0.5231,0.3993,0.0454,0.0363],"k":"a"},{"n":"Jahoda","r":[0.0815,0.5148,0.0361,0.0289]},{"n":"Flins","r":[0.125,0.5148,0.0361,0.0289]},{"n":"Mona","r":[0.1685,0.5148,0.0361,0.0289]},{"n":"Fischl","r":[0.212,0.5148,0.0361,0.0289]},{"n":"Jahoda","r":[0.0815,0.5741,0.0361,0.0289]},{"n":"Ineffa","r":[0.125,0.5741,0.0361,0.0289]},{"n":"Furina","r":[0.1685,0.5741,0.0361,0.0289]},{"n":"Ifa","r":[0.212,0.5741,0.0361,0.0289]},{"n":"Jahoda","r":[0.0815,0.6267,0.0361,0.0289]},{"n":"Nefer","r":[0.125,0.6267,0.0361,0.0289]},{"n":"Xingqiu","r":[0.1685,0.6267,0.0361,0.0289]},{"n":"Lauma","r":[0.212,0.6267,0.0361,0.0289]},{"n":"Jahoda","r":[0.0815,0.6859,0.0361,0.0289]},{"n":"Aino","r":[0.125,0.6859,0.0361,0.0289]},{"n":"Fischl","r":[0.1685,0.6859,0.0361,0.0289]},{"n":"Sucrose","r":[0.212,0.6859,0.0361,0.0289]}]}]}},"thumb":"content/genshin/builds/jahoda/261111-224949/en-1.t.webp","why":{"w":[{"name":"Favonius Warbow","text":"ER and CRIT-triggered neutral particles help fund her costly Burst and the whole team."},{"name":"Elegy for the End","text":"ER plus teamwide EM and ATK buffs when Skill and Burst hits build Sigils. Meet ER needs."},{"name":"Rainbow Serpent's Rain Bow","text":"ER secondary stat and an ATK-boosting passive improve both Burst access and ATK-scaling heals."},{"name":"Snare Hook","text":"Craftable ER bow that helps maintain Burst healing when Favonius is unavailable."},{"name":"End of the Line","text":"Fishing-obtainable Energy Recharge bow for dependable Burst access without weapon wishes. Its extra damage contributes little to team utility."},{"name":"Fading Twilight","text":"Energy Recharge with a rotating personal DMG buff; usable when stronger team-support bows are unavailable. Past limited-time event weapon; personal damage is modest."}],"a":[{"names":["Viridescent Venerer"],"text":"Swirl reduces the absorbed Pyro, Hydro, Electro or Cryo RES by 40%; long cooldowns can limit uptime.","stats":"ER/ATK% · ATK% · Healing Bonus/CRIT Rate"},{"names":["Silken Moon's Serenade"],"text":"Provides party EM from Moonsign effects; great for Lunar/reaction teams when no ally already equips it.","stats":"ER/ATK% · ATK% · Healing Bonus/CRIT Rate"},{"names":["Tenacity of the Millelith"],"text":"In Ascendant Gleam, off-field Skill hits can maintain the party ATK buff for ATK-scaling carries.","stats":"Needs Ascendant Gleam and charged Skill flask"}],"t":[{"name":"Moonlit Lightning","members":["Jahoda","Flins","Mona","Fischl"],"text":"Jahoda enables Ascendant Gleam and absorbs Hydro for Flins; Mona provides Hydro and Omen, while Fischl adds Electro damage.","roles":["Reaction Enabler","On-field DPS","Buffer / Hydro Enabler","Off-field DPS / Battery"]},{"name":"Purrfect Moonstorm","members":["Jahoda","Ineffa","Furina","Ifa"],"text":"Ineffa enables Lunar-Charged, Furina buffs team damage, Jahoda heals for Fanfare, and Ifa drives reactions.","roles":["Healer","Off-field DPS / Shielder","Off-field DPS / Buffer","On-field Driver"]},{"name":"Secret Moon Garden","members":["Jahoda","Nefer","Xingqiu","Lauma"],"text":"Nefer leads Lunar-Bloom with Lauma and Xingqiu. Jahoda heals and shares EM; her C6 adds substantial Moonsign CRIT buffs.","roles":["Healer","On-field DPS","Off-field DPS / Hydro Enabler","Dendro Buffer / Enabler"]},{"name":"Budget Moon Circuit","members":["Jahoda","Aino","Fischl","Sucrose"],"text":"Aino enables Ascendant Gleam with Jahoda; Fischl contributes Electro damage and Sucrose drives reactions and groups enemies.","roles":["Reaction Enabler","Off-field DPS / Enabler","Off-field DPS / Battery","On-field Driver"]}],"v":"Lunar EM Support: Silken Moon for reaction-team EM if nobody else holds it; keep ER high and fully charge the Skill flask for C6.\nATK Team Buffer: Use 4pc Tenacity in Ascendant Gleam teams where recurring Skill hits can maintain its ATK buff.\nDendro Support: 4pc Deepwood is a niche option for Nefer teams if no teammate carries it; focus on ER and healing.\nQuick Healer: Outside Ascendant Gleam, double-tap Skill to leave sooner; Burst heals and grants 100 EM above 70% HP.\nC4 Battery Relief: At C4, robot conversion refunds Energy and reduces the ER needed for consistent Burst uptime.","n":2},"seo":{"roles":["Healer","Support"],"about":"Jahoda is an ATK-scaling Anemo healer who grants the active character 100 EM after healing them above 70% HP. With another Moonsign character, Ascendant Gleam lets her Skill and Burst apply absorbed elements from off-field.","pros":["Reliable Burst healing","Grants active ally 100 EM","Enables Ascendant Gleam","Useful off-field application","Strong C6 Moonsign buffs"],"cons":["High Energy requirements","Skill demands field time","VV uptime can be awkward","C6 needed for peak buffs"],"weapons":["Favonius Warbow","Elegy for the End","Rainbow Serpent's Rain Bow","Snare Hook","End of the Line","Fading Twilight","Jade Vista"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs","role":"General"},{"sets":["Silken Moon's Serenade"],"pcs":"4 pcs","role":"Lunar"},{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"ATK Buff"}],"main":["Energy Recharge / ATK%","ATK%","Healing Bonus / CRIT Rate / ATK%"],"stats":["ER (Favonius, C0): 190% - 255%","ER (non-Favonius, C0): 225% - 330%","ER (Favonius, C4): 150% - 220%","CRIT Rate (Favonius): 40% - 60%","ATK: maximize after meeting ER"],"vars":[{"title":"Lunar EM Buffer","role":"Healer / Support","weapons":["Favonius Warbow","Elegy for the End","Rainbow Serpent's Rain Bow"],"arts":[{"sets":["Silken Moon's Serenade"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"ER to Burst each rotation, then ATK%; Healing Bonus or Favonius CRIT circlet.","teams":"Another Moonsign teammate; prefer no existing Silken Moon holder.","when":"Use for Flins, Ineffa and other Lunar teams that benefit from team EM and healing.","cond":"Ascendant Gleam for off-field elemental application; C6 needs a full Skill flask.","notes":"Do not double-tap Skill before filling the flask if activating C6.","pre":false},{"title":"Tenacity ATK Buffer","role":"Support / Healer","weapons":["Favonius Warbow","Elegy for the End","Snare Hook"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"ER first, then ATK% for healing; CRIT Rate with Favonius.","teams":"Ascendant Gleam and an ATK-scaling main damage dealer.","when":"Use her repeated infused Skill hits to maintain the Tenacity party ATK buff.","cond":"Needs a full Skill flask and Ascendant Gleam to keep hitting off-field.","notes":"Weaker outside the infused Skill setup.","pre":false},{"title":"Nefer Deepwood Healer","role":"Healer / Dendro Support","weapons":["Favonius Warbow","Elegy for the End","End of the Line"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"ER first, then ATK% and Healing Bonus; modest CRIT Rate for Favonius.","teams":"Nefer Dendro-focused teams with no other Deepwood user.","when":"Reduce Dendro RES while providing healing and EM utility; particularly relevant for Nefer.","cond":"Deepwood only when Dendro RES shred is not already supplied.","notes":"Skill/Burst hits must connect to maintain Deepwood; C6 improves her value.","pre":false},{"title":"Fast Rotation Healer","role":"Healer","weapons":["Favonius Warbow","End of the Line","Snare Hook"],"arts":[{"sets":["Viridescent Venerer"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"Prioritize Burst ER and ATK%; Healing Bonus for added comfort.","teams":"Any team that needs Anemo healing and modest EM sharing.","when":"Outside Ascendant Gleam, shorten field time by cancelling the Skill charge before casting Burst.","cond":"No reliable off-field absorbed-element application without Ascendant Gleam.","notes":"Anemo Swirl VV shred still requires an on-field Swirl hit.","pre":false},{"title":"C4 Energy-Saving Support","role":"Support / Healer","weapons":["Favonius Warbow","Elegy for the End","Rainbow Serpent's Rain Bow"],"arts":[{"sets":["Silken Moon's Serenade"],"pcs":"4 pcs"},{"sets":["Viridescent Venerer"],"pcs":"4 pcs"}],"stats":"C4 conversion refunds lower ER needs; invest freed stats into ATK% and healing.","teams":"An Ascendant Gleam team with Burst robot elemental conversions.","when":"Use C4 refunds to improve healing stats without sacrificing Burst consistency.","cond":"Requires C4 and elemental conversion; ER needs still vary by team.","notes":"At C6 also fully charge the Skill flask to enable Moonsign CRIT buffs.","pre":false}],"mats":["Vayuda Turquoise Sliver","Vayuda Turquoise Fragment","Vayuda Turquoise Chunk","Vayuda Turquoise Gemstone","Lightbearing Scale-Feather","Teachings of Vagrancy","Guide to Vagrancy","Philosophies of Vagrancy","Broken Drive Shaft","Reinforced Drive Shaft","Precision Drive Shaft","Portable Bearing","Ascended Sample: Knight","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 6+"},{"name":"Elemental Burst","pri":"Level 8-9"}],"teams":[{"name":"Moonlit Lightning","members":["Jahoda","Flins","Mona","Fischl"]},{"name":"Purrfect Moonstorm","members":["Jahoda","Ineffa","Furina","Ifa"]},{"name":"Secret Moon Garden","members":["Jahoda","Nefer","Xingqiu","Lauma"]},{"name":"Budget Moon Circuit","members":["Jahoda","Aino","Fischl","Sucrose"]}]}}],"title":"Jahoda","el":"Anemo"}