3,0.037,0.0296]},{"n":"Cyno","r":[0.0815,0.5963,0.037,0.0296]},{"n":"Odette","r":[0.1259,0.5963,0.037,0.0296]},{"n":"Alyosha","r":[0.2148,0.5963,0.037,0.0296]},{"n":"Cyno","r":[0.0815,0.657,0.037,0.0296]},{"n":"Columbina","r":[0.1259,0.657,0.037,0.0296]},{"n":"Yelan","r":[0.1704,0.657,0.037,0.0296]},{"n":"Ineffa","r":[0.2148,0.657,0.037,0.0296]},{"n":"Cyno","r":[0.0815,0.7178,0.037,0.0296]},{"n":"Nahida","r":[0.1259,0.7178,0.037,0.0296]},{"n":"Yelan","r":[0.1704,0.7178,0.037,0.0296]},{"n":"Baizhu","r":[0.2148,0.7178,0.037,0.0296]}]}]}},"thumb":"content/genshin/builds/cyno/261111-224833/en-1.t.webp","why":{"w":[{"name":"Staff of the Scarlet Sands","text":"Signature CR weapon that converts EM into ATK, making it especially strong in reaction teams."},{"name":"Staff of Homa","text":"Provides 66.2% CRIT DMG, 20% HP, and an ATK bonus based on Max HP, making it a powerful 5-star alternative for Cyno."},{"name":"Primordial Jade Winged-Spear","text":"Situational alternative; compare passive uptime and team needs."},{"name":"Deathmatch","text":"Gives CRIT Rate and an ATK bonus. The bonus increases in single target fights and is smaller when facing multiple enemies."},{"name":"Ballad of the Fjords","text":"BP CR and EM with three different party elements. Strong for Quickbloom. Requires three distinct elements. Needs three distinct party elements for its EM bonus."},{"name":"Missive Windspear","text":"Provides 41.3% ATK and increases ATK and Elemental Mastery after triggering an Elemental Reaction, making it a solid F2P option for Cyno."},{"name":"Kitain Cross Spear","text":"EM substat helps Hyperbloom, while the passive restores energy and boosts Skill DMG, easing burst uptime."},{"name":"White Tassel","text":"Accessible CR and Normal Attack damage during Burst. R5 helps offset its low Base ATK. R5 preferred."}],"a":[{"names":["Disenchantment in Deep Shadow"],"text":"Stellar-Conduct damage and CR against affected enemies. Best in consistent Stellar-Conduct teams.","stats":"EM/ATK% · Electro · CR/CD"},{"names":["Gilded Dreams"],"text":"EM and ATK for Aggravate or Quickbloom. Use outside Stellar-Conduct teams.","stats":"EM/ATK% · Electro · CR/CD"},{"names":["Night Of The Sky'S Unveiling"],"text":"Situational Lunar option with Moonsign requirements; not the default for Stellar-Conduct.","stats":"EM/ATK% · Electro · CR/CD"}],"t":[{"name":"Judgment Day","members":["Cyno","Mitya","qiqi","Yae Miko"],"text":"Cyno leads Electro damage, with Mitya and Yae Miko supplying off-field pressure. Qiqi provides healing and Cryo for reaction setups.","roles":["Main DPS","Stellar","Support","Off-field"]},{"name":"Conduct Disorder","members":["Cyno","Odette","Traveler (Cryo)","Alyosha"],"text":"Odette and Cryo Traveler supply Cryo support while Alyosha heals and buffs. Cyno drives Electro damage in Stellar-Conduct setups.","roles":["Main DPS","Buffs","Sub DPS","Support"]},{"name":"Moonlit Judgment","members":["Cyno","Columbina","Yelan","Ineffa"],"text":"Columbina and Yelan provide Hydro while Ineffa adds Electro, allowing Cyno to lead mixed Electro and Lunar-Charged damage.","roles":["Main DPS","Lunar","Sub DPS","Support"]},{"name":"Bloom & Doom","members":["Cyno","Nahida","Yelan","Baizhu"],"text":"Nahida and Baizhu sustain Dendro application, Yelan provides Hydro, and Cyno triggers Hyperbloom during Burst.","roles":["Main DPS","Bloom","Off-field","Support"]}],"v":"Aggravate Driver: Focus Cyno’s sustained Electro damage through Quicken and Aggravate.\nQuickbloom: Add Hyperbloom damage to Cyno’s Electro attacks without abandoning his own damage.\nStellar-Conduct: A specialized reaction setup when the team consistently enables Stellar-Conduct.","n":4},"seo":{"roles":["Main DPS"],"about":"Cyno is a Burst-focused Electro DPS who deals sustained on-field damage. He works with Aggravate and Quickbloom, with new Stellar-Conduct options available when supported by qualifying Cryo and Electro allies.","pros":["Strong reaction damage","Excellent single-target DPS","Great Dendro synergy","High investment potential"],"cons":["Long field time","Energy management","Skill timing matters","Team-dependent reactions"],"weapons":["Staff of the Scarlet Sands","Staff of Homa","Primordial Jade Winged-Spear","Deathmatch","Ballad of the Fjords","Missive Windspear","Kitain Cross Spear","White Tassel"],"arts":[{"sets":["Disenchantment in Deep Shadow"],"pcs":"4 pcs","role":"Stellar-Conduct"},{"sets":["Gilded Dreams"],"pcs":"4 pcs","role":"Aggravate / Quickbloom"},{"sets":["Night Of The Sky'S Unveiling"],"pcs":"4 pcs","role":"Lunar Teams"}],"main":["EM / ATK%","Electro DMG","CR / CD"],"stats":["CR: 65–80%","CD: 140–200%+","EM: Team-based","ER: Team-based"],"vars":[{"title":"Aggravate Driver","role":"On-field DPS","weapons":["Staff of the Scarlet Sands","Staff of Homa","Deathmatch"],"arts":[{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM/ATK% · Electro · CRIT; meet ER needs.","teams":"Consistent Dendro application and Electro support.","when":"Focus Cyno’s sustained Electro damage through Quicken and Aggravate.","cond":"Long field time requires lasting buffs","notes":"","pre":false},{"title":"Quickbloom","role":"On-field DPS","weapons":["Staff of the Scarlet Sands","Ballad of the Fjords","White Tassel"],"arts":[{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"EM and CRIT with enough ER for Burst uptime.","teams":"Dendro, Hydro and preferably defensive support.","when":"Add Hyperbloom damage to Cyno’s Electro attacks without abandoning his own damage.","cond":"Hydro must not erase Quicken uptime entirely","notes":"","pre":false},{"title":"Stellar-Conduct","role":"On-field DPS","weapons":["Staff of the Scarlet Sands","Staff of Homa","Deathmatch"],"arts":[{"sets":["Disenchantment in Deep Shadow"],"pcs":"4 pcs"}],"stats":"EM / Electro / CRIT; prioritize ER needs.","teams":"Qualifying Cryo teammates and Stellar-Conduct support.","when":"A specialized reaction setup when the team consistently enables Stellar-Conduct.","cond":"Team-specific; check actual reaction uptime","notes":"","pre":false}],"mats":["Vajrada Amethyst Sliver","Vajrada Amethyst Fragment","Vajrada Amethyst Chunk","Vajrada Amethyst Gemstone","Thunderclap Fruitcore","Teachings of Admonition","Guide to Admonition","Philosophies of Admonition","Divining Scroll","Sealed Scroll","Forbidden Curse Scroll","Scarab","Mudra of the Malefic General","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"Judgment Day","members":["Cyno","Mitya","qiqi","Yae Miko"]},{"name":"Conduct Disorder","members":["Cyno","Odette","Traveler (Cryo)","Alyosha"]},{"name":"Moonlit Judgment","members":["Cyno","Columbina","Yelan","Ineffa"]},{"name":"Bloom & Doom","members":["Cyno","Nahida","Yelan","Baizhu"]}]}}],"title":"Cyno","el":"Electro"}