n","r":[0.0815,0.7789,0.0537,0.043],"k":"m"},{"n":"Hellfire Butterfly","r":[0.5065,0.7789,0.0537,0.043],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.833,0.0537,0.043],"k":"m"}]},{"img":"content/genshin/builds/shenhe/261111-225237/zh-3.webp","t":"content/genshin/builds/shenhe/261111-225237/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Calamity Queller","r":[0.1093,0.2563,0.0481,0.0385],"k":"w"},{"n":"Engulfing Lightning","r":[0.1093,0.3348,0.0481,0.0385],"k":"w"},{"n":"Skyward Spine","r":[0.1093,0.4133,0.0481,0.0385],"k":"w"},{"n":"Noblesse Oblige","r":[0.5231,0.2485,0.0481,0.0385],"k":"a"},{"n":"Gladiator's Finale","r":[0.5231,0.3269,0.0481,0.0385],"k":"a"},{"n":"Shimenawa's Reminiscence","r":[0.5769,0.3269,0.0481,0.0385],"k":"a"},{"n":"Emblem of Severed Fate","r":[0.5231,0.4052,0.0481,0.0385],"k":"a"},{"n":"Shenhe","r":[0.0815,0.5326,0.038,0.0304]},{"n":"Skirk","r":[0.1269,0.5326,0.038,0.0304]},{"n":"Furina","r":[0.1722,0.5326,0.038,0.0304]},{"n":"Escoffier","r":[0.2176,0.5326,0.038,0.0304]},{"n":"Shenhe","r":[0.0815,0.5874,0.038,0.0304]},{"n":"Kamisato Ayaka","r":[0.1269,0.5874,0.038,0.0304]},{"n":"Sangonomiya Kokomi","r":[0.1722,0.5874,0.038,0.0304]},{"n":"Kaedehara Kazuha","r":[0.2176,0.5874,0.038,0.0304]},{"n":"Shenhe","r":[0.0815,0.6422,0.038,0.0304]},{"n":"Wriothesley","r":[0.1269,0.6422,0.038,0.0304]},{"n":"Escoffier","r":[0.1722,0.6422,0.038,0.0304]},{"n":"Layla","r":[0.2176,0.6422,0.038,0.0304]},{"n":"Shenhe","r":[0.0815,0.697,0.038,0.0304]},{"n":"Chongyun","r":[0.1269,0.697,0.038,0.0304]},{"n":"Xingqiu","r":[0.1722,0.697,0.038,0.0304]},{"n":"Diona","r":[0.2176,0.697,0.038,0.0304]}]}]}},"thumb":"content/genshin/builds/shenhe/261111-225237/en-1.t.webp","why":{"w":[{"name":"Calamity Queller","text":"741 Base ATK, ATK% and a passive that builds more ATK while Shenhe is off-field maximize Icy Quill buffs. Meet Burst Energy needs first."},{"name":"Engulfing Lightning","text":"Energy Recharge and ER-to-ATK conversion help balance Burst uptime with stronger Icy Quills. Especially useful when ER needs are high."},{"name":"Skyward Spine","text":"High Base ATK and Energy Recharge help Shenhe maintain Burst uptime without giving up too much buff strength."},{"name":"Vortex Vanquisher","text":"High Base ATK and an ATK% substat strengthen Icy Quills; the shield-dependent passive is less useful off-field. Value mainly comes from its stats."},{"name":"Favonius Lance","text":"CRIT hits generate neutral particles for Shenhe and her team, often making this the most practical 4-star choice. Build some CRIT Rate and hit an enemy on-field. Higher refinements improve reliability."},{"name":"Missive Windspear","text":"ATK% substat and a reaction-triggered ATK boost make it a useful accessible stat stick for Cryo support. Trigger an elemental reaction for the passive. R5 if available."},{"name":"Prospector's Drill","text":"ATK% and its Liyue-party passive can raise her buffing ATK, but team restrictions reduce its flexibility. Best with several Liyue teammates."},{"name":"Prototype Starglitter","text":"Craftable Energy Recharge option when better polearms are unavailable; its Normal and Charged Attack passive adds little. Budget stopgap rather than a damage pick."}],"a":[{"names":["Noblesse Oblige"],"text":"After Burst, gives the team 20% ATK.","stats":"ATK% / ER · ATK% · ATK% / CRIT Rate"},{"names":["Gladiator's Finale","Shimenawa's Reminiscence"],"text":"Two ATK% set bonuses maximize Icy Quill damage when another teammate already wears Noblesse.","stats":"ATK% / ER · ATK% · ATK%"},{"names":["Emblem of Severed Fate"],"text":"Improves Shenhe’s own Burst DMG with ER.","stats":"ATK% / ER · ATK% / Cryo · ATK% / CRIT"}],"t":[{"name":"Father Shenhe","members":["Shenhe","Skirk","Furina","Escoffier"],"text":"Shenhe boosts Skirk’s Cryo hits; Furina supplies DMG buffs and Hydro.","roles":["Cryo Buffer","On-field DPS","Off-field DPS / Buffer","Healer / Debuffer"]},{"name":"Winter Court","members":["Shenhe","Kamisato Ayaka","Sangonomiya Kokomi","Kaedehara Kazuha"],"text":"Ayaka spends Shenhe’s Icy Quills with her Burst; Kokomi keeps enemies Frozen and heals.","roles":["Cryo Buffer","Main DPS","Hydro Healer","Anemo Support"]},{"name":"Cold Front","members":["Shenhe","Wriothesley","Escoffier","Layla"],"text":"Hold Shenhe’s Skill to buff Wriothesley’s attacks. Escoffier adds healing and Cryo shred.","roles":["Cryo Buffer","On-field DPS","Healer / Debuffer","Shielder / Cryo Enabler"]},{"name":"Budget Snow Day","members":["Shenhe","Chongyun","Xingqiu","Diona"],"text":"Chongyun uses Shenhe’s Quills through infused Cryo attacks.","roles":["Cryo Buffer","Cryo Enabler / Sub DPS","n","Shielder / Healer"]}],"v":"Tap Skill · Burst Teams: Tap for 5 Icy Quills per ally and a 15% Skill/Burst DMG buff.\nHold Skill · Attack Teams: Hold for 7 Icy Quills per ally and a 15% Normal, Charged and Plunging Attack DMG buff.\nFavonius Utility: Use Favonius Lance and enough CR to trigger particles.\nATK Buff Focus: When another ally has Noblesse.","n":3},"seo":{"roles":["Support / Buffer"],"about":"Shenhe is an ATK-scaling Cryo support whose Icy Quills add damage to allies’ Cryo hits. Her Skill also buffs attack types, while her Burst shreds Cryo and Physical RES. Build enough Energy Recharge to Burst reliably, then stack ATK; she shines beside Cryo damage dealers.","pros":["Powerful Cryo buffs","Cryo RES reduction","Quick field time","Flexible Cryo teams"],"cons":["Energy hungry","Needs Cryo teammates","Quills run out quickly","Low personal damage"],"weapons":["Calamity Queller","Engulfing Lightning","Skyward Spine","Vortex Vanquisher","Favonius Lance","Missive Windspear","Prospector's Drill","Prototype Starglitter"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":"Team Buff"},{"sets":["Gladiator's Finale","Shimenawa's Reminiscence"],"pcs":"2 + 2 pcs","role":"Quill Focus"},{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs","role":"Personal Damage"}],"main":["ATK% / Energy Recharge","ATK%","ATK% / CRIT Rate (Favonius)"],"stats":["Energy Recharge: 160% - 200% (team dependent)","ATK: 2,800 - 3,500+ (after ER needs)","CRIT Rate: 30% - 50% (Favonius only)","Skill: Tap 5 / Hold 7 Icy Quill uses"],"vars":[{"title":"Favonius Battery","role":"Cryo Support","weapons":["Favonius Lance","Skyward Spine"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Build Energy Recharge to Burst every rotation; add CRIT Rate to trigger Favonius.","teams":"Teams with high Energy needs or limited Cryo particles.","when":"Give Shenhe a brief on-field hit to trigger Favonius, then swap to your Cryo carry.","cond":"Favonius only triggers on on-field CRIT hits.","notes":"","pre":false},{"title":"Maximum Icy Quill ATK","role":"Cryo Buffer","weapons":["Calamity Queller","Vortex Vanquisher"],"arts":[{"sets":["Gladiator's Finale","Shimenawa's Reminiscence"],"pcs":"2 + 2 pcs"}],"stats":"After reaching required ER, focus on ATK% across Sands, Goblet and Circlet.","teams":"Another teammate already wears Noblesse Oblige.","when":"Maximize Shenhe’s ATK to amplify Cryo hits from teammates consuming Icy Quills.","cond":"Calamity Queller still needs enough ER for Burst uptime.","notes":"","pre":false},{"title":"Hold Skill · Cryo Attacks","role":"Charged / Normal Buffer","weapons":["Calamity Queller","Favonius Lance"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"Similar ATK / ER support stats; prioritize reliable Burst uptime.","teams":"Cryo carry relying on Normal, Charged or Plunging Attacks.","when":"Hold Skill before Wriothesley or other attack-focused Cryo carries: 7 Quills each and a 15% attack-type DMG buff.","cond":"Longer cooldown than Tap Skill.","notes":"","pre":false},{"title":"Burst Damage Sidegrade","role":"Sub DPS","weapons":["Engulfing Lightning","Skyward Spine"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"}],"stats":"Use ER Sands if needed; seek more personal CRIT after sufficient ATK.","teams":"A team already has Noblesse and can support Shenhe’s Burst.","when":"E