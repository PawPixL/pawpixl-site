"n":"Collei","r":[0.0815,0.6844,0.0352,0.0281]},{"n":"Xingqiu","r":[0.1241,0.6844,0.0352,0.0281]},{"n":"Kuki Shinobu","r":[0.1667,0.6844,0.0352,0.0281]}]}]}},"thumb":"content/genshin/builds/collei/261111-224833/en-1.t.webp","why":{"w":[{"name":"Elegy for the End","text":"ER plus teamwide EM and ATK buffs."},{"name":"Polar Star","text":"CRIT and Skill/Burst damage. Personal damage; needs extra attack inputs."},{"name":"Favonius Warbow","text":"CRIT hits generate team Energy. Build CRIT Rate to trigger passive."},{"name":"Sacrificial Bow","text":"Second Skill aids Dendro and Energy. Needs passive proc; adds field time."},{"name":"The Stringless","text":"EM plus Skill and Burst damage. Meet ER needs first."},{"name":"Fading Twilight","text":"ER and rotating damage bonus."},{"name":"End of the Line","text":"Fishable ER option for Burst uptime."},{"name":"Raven Bow","text":"Budget EM for Bloom reactions. ER requirement already met."}],"a":[{"names":["Deepwood Memories"],"text":"Shreds 30% Dendro RES on hits.","stats":"ER · Dendro · CRIT"},{"names":["Noblesse Oblige"],"text":"Burst grants 20% team ATK.","stats":"ER · Dendro · CRIT"},{"names":["Instructor"],"text":"Grants team EM after reactions.","stats":"ER · Dendro · CRIT"}],"t":[{"name":"Hyperbloom Garden","members":["Collei","Sangonomiya Kokomi","Raiden Shogun","Traveler (Dendro)"],"text":"Kokomi creates Bloom cores; full-EM Raiden triggers Hyperbloom. Both Dendro units maintain the aura. Raiden Skill should hit cores.","roles":["Dendro Support","Hydro Driver/Healer","Hyperbloom Trigger","Dendro Battery"]},{"name":"Tighnari Forestcall","members":["Collei","Tighnari","Yae Miko","Zhongli"],"text":"Yae sustains Quicken for Tighnari Spread; Collei adds Dendro, energy, and support buffs while Zhongli protects. Collei can hold Deepwood.","roles":["Dendro Support","Spread DPS","Electro Sub DPS","Shield"]},{"name":"Aggravate Sprouts","members":["Collei","Keqing","Fischl","Jean"],"text":"Collei keeps Quicken active for Keqing and Fischl Aggravates. Jean heals and shreds Electro RES with Viridescent Venerer.","roles":["Dendro Support","Electro DPS","Electro Sub DPS","Healer/VV"]},{"name":"Budget Bloom Circuit","members":["Collei","Xingqiu","Kuki Shinobu","Traveler (Dendro)"],"text":"Xingqiu supplies Hydro, Dendro teammates make cores, and full-EM Kuki heals and triggers Hyperbloom with her Skill.","roles":["Dendro Support","Hydro Sub DPS","Hyperbloom/Healer","Dendro Battery"]}],"v":"Deepwood Support: Default if no teammate holds Deepwood. Prioritize ER, then CRIT Rate for Favonius and personal damage.\nQuicken Buffer: Use Noblesse or Instructor when Dendro RES shred is already covered; Elegy buffs team ATK and EM.\nPure Bloom: ER first, then EM where Collei owns Blooms. Dendro application uptime matters more than CRIT.\nPersonal Burst: With another Deepwood holder, invest in ER, Dendro DMG and CRIT; consider Stringless or Polar Star.\nBudget Battery: Favonius Warbow or fishable End of the Line; double Dendro and enough ER help sustain Burst.","n":4},"seo":{"roles":["Support / Sub DPS"],"about":"Collei is a quickswap Dendro support who enables Bloom, Hyperbloom, Quicken and Spread with her boomerang Skill and off-field Burst. Prioritize enough Energy Recharge to maintain Dendro application; Elegy and support sets add team buffs.","pros":["Fast Dendro application","Strong reaction enabler","Great free bow option","Short field time"],"cons":["High Energy needs","Small fixed Burst area","Skill needs positioning","Limited personal damage"],"weapons":["Elegy for the End","Polar Star","Favonius Warbow","Sacrificial Bow","The Stringless","Fading Twilight","End of the Line","Raven Bow"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs","role":""},{"sets":["Noblesse Oblige"],"pcs":"4 pcs","role":""},{"sets":["Instructor"],"pcs":"4 pcs","role":""}],"main":["Energy Recharge / ATK% / EM","Dendro DMG Bonus / EM","CRIT Rate / CRIT DMG / EM"],"stats":["ER: 160%-200%","Fav CR: 30%+","CR: 50%-70%","CD: 100%-150%"],"vars":[{"title":"Quicken Team Buffer","role":"Dendro Support","weapons":["Elegy for the End","Favonius Warbow"],"arts":[{"sets":["Noblesse Oblige"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"ER sands; CRIT Rate with Favonius, then EM.","teams":"Electro damage dealer; ideally another Dendro RES shred source if Dendro damage matters.","when":"Use for Keqing, Clorinde, or other Aggravate teams when a second unit already carries Deepwood. Noblesse supports ATK-scaling Electro units.","cond":"Another unit must hold Deepwood if team needs Dendro RES shred.","notes":"","pre":false},{"title":"Pure Bloom Enabler","role":"Dendro Support","weapons":["Elegy for the End","Sacrificial Bow","Favonius Warbow"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"ER first; EM sands/goblet/circlet only if Collei owns significant Bloom reactions.","teams":"Reliable Hydro, and enough Dendro application for continuous cores.","when":"Use in Bloom teams to sustain Dendro and boost reaction damage. Do not assume Collei owns every Bloom; EM value depends on ownership.","cond":"ER and reaction ownership vary by team.","notes":"","pre":false},{"title":"Personal Burst Damage","role":"Off-field DPS","weapons":["Polar Star","The Stringless","Fading Twilight"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Gilded Dreams"],"pcs":"4 pcs"}],"stats":"ER to Burst consistently, then Dendro DMG, CRIT, ATK% and EM in Quicken.","teams":"Another character carrying Deepwood; Quicken helps personal Spread damage.","when":"Use when your team already provides Dendro RES shred and you want more from Collei’s Skill and Burst. Polar Star needs added attack inputs for stacks.","cond":"Not her default support build.","notes":"","pre":false},{"title":"F2P Energy Support","role":"Dendro Support","weapons":["Favonius Warbow","End of the Line","Fading Twilight"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"ER sands and CRIT Rate circlet with Favonius; otherwise flexible defensive/offensive stats.","teams":"Any Dendro reaction team; double Dendro or a battery lowers ER needs.","when":"Use a free or accessible ER bow to keep Burst available each rotation and maintain reaction support without premium equipment.","cond":"Favonius particles require a CRIT hit on-field.","notes":"","pre":false},{"title":"C2 Sprout Uptime","role":"Dendro Support","weapons":["Elegy for the End","Sacrificial Bow","Favonius Warbow"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"},{"sets":["Instructor"],"pcs":"4 pcs"}],"stats":"ER requirement first; personal damage remains secondary.","teams":"C2 Collei and a team that repeatedly triggers qualifying Dendro reactions.","when":"Use C2 to extend her off-field Sprout effect after Skill returns when a qualifying reaction occurs. Stay close enough for the ring to hit.","cond":"Requires Collei C2; extension can occur only once per Skill.","notes":"","pre":false}],"mats":["Nagadus Emerald Sliver","Nagadus Emerald Fragment","Nagadus Emerald Chunk","Nagadus Emerald Gemstone","Majestic Hooked Beak","Teachings of Praxis","Guide to Praxis","Philosophies of Praxis","Firm Arrowhead","Sharp Arrowhead","Weathered Arrowhead","Rukkhashava Mushrooms","Tears of the Calamitous God","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 8-9"},{"name":"Elemental Burst","pri":"Level 8-9"}],"teams":[{"name":"Hyperbloom Garden","members":["Collei","Sangonomiya Kokomi","Raiden Shogun","Traveler (Dendro)"]},{"name":"Tighnari Forestcall","members":["Collei","Tighnari","Yae Miko","Zhongli"]},{"name":"Aggravate Sprouts","members":["Collei","Keqing","Fischl","Jean"]},{"name":"Budget Bloom Circuit","members":["Collei","Xingqiu","Kuki Shinobu","Traveler (Dendro)"]}]}}],"title":"Collei","el":"Dendro"}