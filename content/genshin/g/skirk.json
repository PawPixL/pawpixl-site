]}]}]}},"thumb":"content/genshin/builds/skirk/261111-225304/en-1.t.webp","why":{"w":[{"name":"Azurelight","text":"Signature CRIT Rate sword granting ATK and CRIT DMG after Skill when she has zero Energy."},{"name":"Haran Geppaku Futsu","text":"CRIT Rate and Elemental DMG with Normal Attack buffs after Skills; strong 5-star alternative."},{"name":"Primordial Jade Cutter","text":"High CRIT Rate and HP-derived ATK; monitor CRIT Rate overcap."},{"name":"Mistsplitter Reforged","text":"CRIT DMG and Elemental DMG bonus with stacks from infused attacks and Burst use."},{"name":"The Black Sword","text":"Battle Pass CRIT Rate and Normal/Charged Attack damage; some healing on CRIT Normal/Charged hits."},{"name":"Calamity of Eshu","text":"ATK and strong Normal/Charged bonuses while shielded. Best for shielded on-field Skirk."},{"name":"Finale of the Deep","text":"Craftable ATK sword gaining Bond of Life after Skill; healing clears it for more ATK."},{"name":"Harbinger of Dawn","text":"Strong CRIT stats at low rarity, but passive CRIT Rate requires staying above 90% HP."}],"a":[{"names":["Finale of the Deep Galleries"],"text":"Her preferred Cryo damage set when building around her unique resource system. It boosts Normal Attack damage and enhances her damage when Energy is at zero.","stats":"ATK% · Cryo DMG Bonus/ATK% · CR/CD"},{"names":["Marechaussee Hunter"],"text":"Provides 15% Normal and Charged Attack DMG and up to 36% CRIT Rate when HP changes. Furina reliably activates the full bonus through her HP drain, making this a strong option for on-field Skirk. Watch your CRIT Rate, especially with Azurelight. The set can cause overcapping.","stats":""},{"names":["Gladiator's Finale"],"text":"A temporary ATK and Normal Attack option for on-field Skirk. Farm Finale of the Deep Galleries for a stronger dedicated set.","stats":""}],"t":[{"name":"ABYSS & BOUJE","members":["Skirk","Furina","Vodyanitsa","Escoffier"],"text":"Skirk leads on-field Cryo damage, Furina provides off-field Hydro and a massive teamwide DMG Bonus, Vodyanitsa adds Hydro support, RES shred, and powerful damage buffs, while Escoffier provides Cryo application, additional RES shred, and healing.","roles":["Main DPS","Buffs","Support","Support"]},{"name":"FROST & FURIOUS","members":["Skirk","Furina","Citlali","Escoffier"],"text":"Skirk deals on-field Cryo damage, Furina buffs and applies Hydro, Citlali shields and shreds RES, and Escoffier heals while boosting Cryo/Hydro damage.","roles":["Main DPS","Buffs","Support","Support"]},{"name":"COLD HARD FACTS","members":["Skirk","Xingqiu","Charlotte","Escoffier"],"text":"Skirk deals on-field Cryo damage, Xingqiu provides off-field Hydro, Charlotte offers teamwide healing and TTDS buffs, and Escoffier heals while shredding Cryo/Hydro RES.","roles":["Main DPS","Sub DPS","Support","Support"]},{"name":"BUDGET ABYSS","members":["Skirk","Xingqiu","Rosaria","Dahlia"],"text":"Skirk deals on-field Cryo damage, Xingqiu provides off-field Hydro, Rosaria boosts CRIT Rate and adds Cryo damage, and Dahlia shields Skirk while increasing her Attack SPD.","roles":["Main DPS","Sub DPS","Sub DPS","Support"]}],"v":"Normal Attack Carry: Use Finale of the Deep Galleries for infused Normal Attacks.\nFurina CRIT Alternative: Use an invested Marechaussee set as an alternative.","n":2},"seo":{"roles":["Main DPS"],"about":"Skirk is a powerful Cryo DPS who excels with Cryo and Hydro allies. Her unique resource system lets her unleash devastating attacks without relying on Energy.","pros":["High damage","No Energy needs","Flexible rotations","High Burst DMG"],"cons":["Restrictive teams","Premium supports","Cryo/Hydro locked","Setup dependent"],"weapons":["Azurelight","Haran Geppaku Futsu","Primordial Jade Cutter","Mistsplitter Reforged","The Black Sword","Calamity of Eshu","Finale of the Deep","Harbinger of Dawn"],"arts":[{"sets":["Finale of the Deep Galleries"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Marechaussee Hunter"],"pcs":"4 pcs","role":"Main DPS"},{"sets":["Gladiator's Finale"],"pcs":"4 pcs","role":"Main DPS"}],"main":["ATK%","Cryo DMG Bonus / ATK%","Crit Rate / Crit DMG"],"stats":["ATK: 2,100+","Crit Rate: 60% - 70%","Crit DMG: 180% - 200%+"],"vars":[{"title":"Normal Attack Carry","role":"On-field DPS","weapons":["Azurelight","Haran Geppaku Futsu","The Black Sword"],"arts":[{"sets":["Finale of the Deep Galleries"],"pcs":"4 pcs"}],"stats":"ATK% / Cryo DMG / CRIT; avoid ER investment.","teams":"Cryo and Hydro teammates to support her mechanics.","when":"Use Finale of the Deep Galleries for infused Normal Attacks.","cond":"No conventional Energy requirement.","notes":"","pre":false},{"title":"Furina CRIT Alternative","role":"On-field DPS","weapons":["Azurelight","Primordial Jade Cutter","The Black Sword"],"arts":[{"sets":["Marechaussee Hunter"],"pcs":"4 pcs"}],"stats":"Adjust sheet CRIT Rate for Marechaussee stacks.","teams":"Furina and steady team healing.","when":"Use an invested Marechaussee set as an alternative.","cond":"Finale remains the generally preferred set.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","Ensnaring Gaze","Teachings of Contention","Guide to Contention","Philosophies of Contention","Meshing Gear","Mechanical Spur Gear","Artificed Dynamic Gear","Skysplit Gembloom","Ascended Sample: Knight","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 9+"}],"teams":[{"name":"ABYSS & BOUJE","members":["Skirk","Furina","Vodyanitsa","Escoffier"]},{"name":"FROST & FURIOUS","members":["Skirk","Furina","Citlali","Escoffier"]},{"name":"COLD HARD FACTS","members":["Skirk","Xingqiu","Charlotte","Escoffier"]},{"name":"BUDGET ABYSS","members":["Skirk","Xingqiu","Rosaria","Dahlia"]}]}}],"title":"Skirk","el":"Cryo"}