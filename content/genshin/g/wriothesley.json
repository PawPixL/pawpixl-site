y depends on aura management.","notes":"","pre":false}],"mats":["Shivada Jade Sliver","Shivada Jade Fragment","Shivada Jade Chunk","Shivada Jade Gemstone","\"Tourbillon Device\"","Teachings of Order","Guide to Order","Philosophies of Order","Meshing Gear","Mechanical Spur Gear","Artificed Dynamic Gear","Subdetection Unit","Primordial Greenbloom","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 9+"},{"name":"Elemental Skill","pri":"Level 9+"},{"name":"Elemental Burst","pri":"Level 6+"}],"teams":[{"name":"Conducted Chaos","members":["Wriothesley","Odette","Mitya","Nicole"]},{"name":"Freeze Frame","members":["Wriothesley","Furina","Shenhe","Escoffier"]},{"name":"Fire Meets Frost","members":["Wriothesley","Durin","Xilonen","Nicole"]},{"name":"Frost on a Budget","members":["Wriothesley","Xiangling","Sucrose","Bennett"]}]}}],"title":"Wriothesley","el":"Cryo"}