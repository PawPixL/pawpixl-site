n":"Prototype Starglitter","r":[0.5065,0.3989,0.0537,0.043],"k":"w"},{"n":"Tenacity of the Millelith","r":[0.0815,0.5019,0.0537,0.043],"k":"a"},{"n":"Archaic Petra","r":[0.5065,0.5019,0.0537,0.043],"k":"a"},{"n":"Deepwood Memories","r":[0.0815,0.5619,0.0537,0.043],"k":"a"},{"n":"Prithiva Topaz Gemstone","r":[0.0815,0.6707,0.0537,0.043],"k":"m"},{"n":"Basalt Pillar","r":[0.5065,0.6707,0.0537,0.043],"k":"m"},{"n":"Philosophies of Gold","r":[0.0815,0.7248,0.0537,0.043],"k":"m"},{"n":"Slime Concentrate","r":[0.5065,0.7248,0.0537,0.043],"k":"m"},{"n":"Cor Lapis","r":[0.0815,0.7789,0.0537,0.043],"k":"m"},{"n":"Tusk of Monoceros Caeli","r":[0.5065,0.7789,0.0537,0.043],"k":"m"},{"n":"Crown of Insight","r":[0.0815,0.833,0.0537,0.043],"k":"m"}]},{"img":"content/genshin/builds/zhongli/261111-225448/zh-3.webp","t":"content/genshin/builds/zhongli/261111-225448/zh-3.t.webp","w":1080,"h":1350,"kind":"why","links":[{"n":"Black Tassel","r":[0.1093,0.2563,0.0481,0.0385],"k":"w"},{"n":"Favonius Lance","r":[0.1093,0.3348,0.0481,0.0385],"k":"w"},{"n":"Staff of Homa","r":[0.1093,0.4133,0.0481,0.0385],"k":"w"},{"n":"Tenacity of the Millelith","r":[0.5231,0.2485,0.0481,0.0385],"k":"a"},{"n":"Archaic Petra","r":[0.5231,0.3193,0.0481,0.0385],"k":"a"},{"n":"Deepwood Memories","r":[0.5231,0.3978,0.0481,0.0385],"k":"a"},{"n":"Zhongli","r":[0.0815,0.5326,0.038,0.0304]},{"n":"Neuvillette","r":[0.1269,0.5326,0.038,0.0304]},{"n":"Furina","r":[0.1722,0.5326,0.038,0.0304]},{"n":"Kaedehara Kazuha","r":[0.2176,0.5326,0.038,0.0304]},{"n":"Zhongli","r":[0.0815,0.5874,0.038,0.0304]},{"n":"Navia","r":[0.1269,0.5874,0.038,0.0304]},{"n":"Fischl","r":[0.1722,0.5874,0.038,0.0304]},{"n":"Bennett","r":[0.2176,0.5874,0.038,0.0304]},{"n":"Zhongli","r":[0.0815,0.6422,0.038,0.0304]},{"n":"Arlecchino","r":[0.1269,0.6422,0.038,0.0304]},{"n":"Yelan","r":[0.1722,0.6422,0.038,0.0304]},{"n":"Bennett","r":[0.2176,0.6422,0.038,0.0304]},{"n":"Zhongli","r":[0.0815,0.697,0.038,0.0304]},{"n":"Tighnari","r":[0.1269,0.697,0.038,0.0304]},{"n":"Yae Miko","r":[0.1722,0.697,0.038,0.0304]},{"n":"Nahida","r":[0.2176,0.697,0.038,0.0304]}]}]}},"thumb":"content/genshin/builds/zhongli/261111-225448/en-1.t.webp","why":{"w":[{"name":"Black Tassel","text":"Large HP% secondary stat maximizes Jade Shield durability. The slime-damage passive is irrelevant. Best for maximum shield strength."},{"name":"Favonius Lance","text":"Energy Recharge and on-field CRIT hits generate neutral particles for the team. Build enough CRIT Rate to trigger it. Use when allies need energy; passive cannot trigger off-field."},{"name":"Staff of Homa","text":"CRIT DMG, bonus HP and HP-to-ATK conversion make it a strong hybrid or Burst-damage option. Burst or hybrid investment; not needed for pure shielding."},{"name":"Skyward Spine","text":"Energy Recharge and a little CRIT Rate can help a Burst-focused Zhongli cast more frequently. Burst-focused playstyle."},{"name":"Vortex Vanquisher","text":"His signature grants shield strength to its wielder and stacking ATK, but neither notably improves shields given to allies. On-field niche only; not recommended for shieldbot."},{"name":"\"The Catch\"","text":"Energy Recharge plus Burst DMG and Burst CRIT Rate supports an affordable meteor-focused setup. Burst damage build. R5 recommended."},{"name":"Crescent Pike","text":"Physical DMG and extra Normal Attack hits enable a niche on-field Physical Zhongli. Physical driver only; requires particle pickup."},{"name":"Prototype Starglitter","text":"Craftable Energy Recharge option when Favonius is unavailable; its Normal/Charged Attack passive does little for shield support. Temporary ER option only."}],"a":[{"names":["Tenacity of the Millelith"],"text":"HP and team ATK buff when Skill hits land.","stats":"HP% · HP% · HP% / CRIT Rate"},{"names":["Archaic Petra"],"text":"Grants a strong elemental DMG buff after Zhongli personally collects the matching Crystallize shard.","stats":"HP% · HP% · HP% / CRIT Rate"},{"names":["Deepwood Memories"],"text":"Situational Dendro RES shred for teams lacking another Deepwood holder; Skill hit coverage can be inconsistent.","stats":"HP% · HP% · HP% / CRIT Rate"}],"t":[{"name":"Unbreakable Verdict","members":["Zhongli","Neuvillette","Furina","Kaedehara Kazuha"],"text":"Zhongli protects C0 Neuvillette from interruption and shreds RES; Furina buffs DMG.","roles":["Shield / RES Shred","Main DPS","Sub DPS / Buff","Anemo Buff"]},{"name":"Golden Contract","members":["Zhongli","Navia","Fischl","Bennett"],"text":"Geo Resonance and Zhongli’s shield help Navia attack safely.","roles":["Shield / RES Shred","Main DPS","Sub DPS","Healer / Buff"]},{"name":"Pyro-Proof Plan","members":["Zhongli","Arlecchino","Yelan","Bennett"],"text":"Zhongli shields Arlecchino through her combos and shreds RES.","roles":["Shield / RES Shred","Main DPS","Hydro Sub DPS","ATK Buff"]},{"name":"Forest Fortress","members":["Zhongli","Tighnari","Yae Miko","Nahida"],"text":"Zhongli safeguards Tighnari’s charged shots; Yae keeps Quicken active and Nahida boosts Dendro DMG.","roles":["Shield / RES Shred","Dendro DPS","Electro Sub DPS","Dendro Support"]}],"v":"Favonius Battery: Trade some HP for CR to trigger Favonius Lance on-field, feeding the team energy while keeping a durable shield.\nBurst Support: Staff of Homa or The Catch, Geo DMG goblet and CRIT circlet add meteor DMG.\nPhysical Driver: Crescent Pike and a Physical DMG goblet support on-field Normal Attacks. Fun.\nDendro Utility: Use Deepwood only when no teammate can carry it.","n":3},"seo":{"roles":["Shield Support / Sub DPS"],"about":"Zhongli protects the team with a durable Jade Shield that also reduces nearby enemies' Elemental and Physical RES by 20%. Stack HP for shield strength, or use Favonius Lance for team energy. His Burst offers Petrification, but may cost more time than it is worth in damage-focused rotations.","pros":["Excellent shield uptime","Universal RES reduction","Flexible team slot","Comfortable rotations"],"cons":["Low personal DPS","Stele placement matters","Burst can slow rotations","Limited reaction utility"],"weapons":["Black Tassel","Favonius Lance","Staff of Homa","Skyward Spine","Vortex Vanquisher","\"The Catch\"","Crescent Pike","Prototype Starglitter"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs","role":"General support"},{"sets":["Archaic Petra"],"pcs":"4 pcs","role":""},{"sets":["Deepwood Memories"],"pcs":"4 pcs","role":""}],"main":["HP%","HP%","HP% / CRIT Rate (Favonius)"],"stats":["HP: 40,000 - 55,000+ (Shield focus)","CRIT Rate: 30% - 50% (Favonius only)","Energy Recharge: 130% - 160%+ (Burst teams)"],"vars":[{"title":"Favonius Team Battery","role":"Shield Support","weapons":["Favonius Lance","Black Tassel"],"arts":[{"sets":["Tenacity of the Millelith"],"pcs":"4 pcs"},{"sets":["Archaic Petra"],"pcs":"4 pcs"}],"stats":"HP% main stats; use a CRIT Rate circlet or substats to proc Favonius reliably.","teams":"Teammates with meaningful Energy Recharge needs.","when":"Choose when giving allies particles matters more than maximum shield HP.","cond":"Favonius procs only from on-field CRIT hits.","notes":"Add a Normal Attack after Hold Skill if needed for a reliable proc.","pre":false},{"title":"Meteor Burst Support","role":"Burst Sub DPS","weapons":["Staff of Homa","\"The Catch\"","Skyward Spine"],"arts":[{"sets":["Emblem of Severed Fate"],"pcs":"4 pcs"},{"sets":["Noblesse Oblige"],"pcs":"4 pcs"}],"stats":"HP%/ATK% sands, Geo DMG goblet, CRIT circlet; gain sufficient ER for chosen rotation.","teams":"Prefer teams with a window for his long Burst animation.","when":"For Petrification and extra Geo Burst damage when sacrificing some shield strength is acceptable.","cond":"Higher investment; often less team DPS than skipping Burst.","notes":"Focus Burst and Skill talents; use an HP sands for a sturdier hybrid shield.","pre":false},{"title":"Physical Driver","role":"On-field Physical DPS","weapons":["Crescent Pike"],"arts":[{"sets":["Pale Flame"],"pcs":"4 pcs"},{"sets":["Bloodstained Chivalry","Pale Flame"],"pcs":"2 + 2 pcs"}],"stats":"ATK% sands, Physical DMG goblet, CRIT circlet; prioritize Normal Attack talent.","teams":"Superconduct support and consistent particle pickups.","when":"A fun off-meta playstyle built around fast Normal Attacks and Crescent Pike procs.","cond":"Niche; weaker personal damage than most dedicated carries.","notes":"Keep the shield up and use Cryo + Electro teammates for Physical RES reduction.","pre":false},{"title":"Dendro RES Shred","role":"Shield Support","weapons":["Favonius Lance","Black Tassel"],"arts":[{"sets":["Deepwood Memories"],"pcs":"4 pcs"}],"stats":"Keep HP% main stats, adding CRIT Rate if using Favonius.","teams":"Only use when no other teammate already carries 4-piece Deepwood.","when":"Provides Dendro RES reduction while protecting a Dendro damage or reaction team.","cond":"Stele placement limits repeated hits.","notes":"Deepwood on Nahida or another reliable Dendro applier is typically easier to maintain.","pre":false}],"mats":["Prithiva Topaz Sliver","Prithiva Topaz Fragment","Prithiva Topaz Chunk","Prithiva Topaz Gemstone","Basalt Pillar","Teachings of Gold","Guide to Gold","Philosophies of Gold","Slime Condensate","Slime Secretions","Slime Concentrate","Cor Lapis","Tusk of Monoceros Caeli","Crown of Insight","Mora","Hero's Wit"],"talents":[{"name":"Normal Attack","pri":"Level 1+"},{"name":"Elemental Skill","pri":"Level 8-9+"},{"name":"Elemental Burst","pri":"Level 1 - 6"}],"teams":[{"name":"Unbreakable Verdict","members":["Zhongli","Neuvillette","Furina","Kaedehara Kazuha"]},{"name":"Golden Contract","members":["Zhongli","Navia","Fischl","Bennett"]},{"name":"Pyro-Proof Plan","members":["Zhongli","Arlecchino","Yelan","Bennett"]},{"name":"Forest Fortress","members":["Zhongli","Tighnari","Yae Miko","Nahida"]}]}}],"title":"Zhongli","el":"Geo"}